---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Gallery images sorted by number (filenames like 001.jpg, 002.jpg etc.)
// IMG_6439.JPG is a large file — placed at end
const galleryImages = [
  { src: "/assets/images/gallery/001.jpg", alt: "Summit 2024", label: "Summit 2025", sub: "Opening Ceremony" },
  { src: "/assets/images/gallery/003.jpg", alt: "Summit 2024", label: "Summit 2025", sub: "Delegates" },
  { src: "/assets/images/gallery/004.jpg", alt: "Summit 2024", label: "Summit 2025", sub: "Panel Session" },
  { src: "/assets/images/gallery/007.jpg", alt: "Summit 2024", label: "Inaugural Summit", sub: "HE. Jakaya Kikwete" },
  { src: "/assets/images/gallery/008.jpg", alt: "Summit 2024", label: "Inaugural Summit", sub: "Keynote Address" },
  { src: "/assets/images/gallery/009.jpg", alt: "Summit 2024", label: "Inaugural Summit", sub: "Group Photo" },
  { src: "/assets/images/gallery/013.jpg", alt: "Summit", label: "Summit", sub: "Participants" },
  { src: "/assets/images/gallery/015.jpg", alt: "Summit", label: "Summit", sub: "Discussion" },
  { src: "/assets/images/gallery/016.jpg", alt: "Summit", label: "Summit", sub: "Networking" },
  { src: "/assets/images/gallery/017.jpg", alt: "Summit", label: "Summit", sub: "Presentation" },
  { src: "/assets/images/gallery/018.jpg", alt: "Summit", label: "Summit", sub: "Workshop" },
  { src: "/assets/images/gallery/019.jpg", alt: "Summit", label: "Summit", sub: "Breakout Session" },
  { src: "/assets/images/gallery/020.jpg", alt: "Summit 2025", label: "2nd Annual Summit", sub: "HE. Uhuru Kenyatta" },
  { src: "/assets/images/gallery/022.jpg", alt: "Summit 2025", label: "2nd Annual Summit", sub: "Policy Dialogue" },
  { src: "/assets/images/gallery/023.jpg", alt: "Summit 2025", label: "2nd Annual Summit", sub: "Delegates" },
  { src: "/assets/images/gallery/024.jpg", alt: "Summit", label: "Summit", sub: "Moments" },
  { src: "/assets/images/gallery/025.jpg", alt: "Summit", label: "Summit", sub: "Moments" },
  { src: "/assets/images/gallery/026.jpg", alt: "Summit", label: "Summit", sub: "Closing Ceremony" },
  { src: "/assets/images/gallery/027.jpg", alt: "Summit", label: "Summit", sub: "Group" },
  { src: "/assets/images/gallery/028.jpg", alt: "Summit", label: "Summit", sub: "Award" },
  { src: "/assets/images/gallery/029.jpg", alt: "Summit", label: "Summit", sub: "HerPower Fellowship" },
];

const IMG_6439 = { src: "/assets/images/gallery/IMG_6439.JPG", alt: "Summit Group", label: "Summit", sub: "Group Photo" };
---

<Base title="Gallery" description="View moments from the Guild Leaders' Summits across East Africa.">
  <Navbar />

  <!-- Hero -->
  <section class="min-h-[50vh] bg-gpla-navy px-4 md:px-12 py-32 relative overflow-hidden flex items-center">
    <div class="absolute inset-0 bg-gradient-to-r from-[#132d82]/95 via-[#132d82]/80 to-[#389a29]/60"></div>
    <div class="relative z-10 max-w-4xl mx-auto text-center">
      <p class="text-gpla-green font-semibold uppercase tracking-widest text-sm mb-4">GPLA Gallery</p>
      <h1 class="font-display text-white text-5xl md:text-7xl lg:text-8xl mb-6">
        OUR GALLERY
      </h1>
      <p class="text-white/80 text-lg md:text-xl max-w-2xl mx-auto">
        700+ leaders. 6 countries. 3 summits. Witness the moments that shaped a movement.
      </p>
    </div>
  </section>

  <!-- Gallery Grid -->
  <section class="px-4 md:px-12 py-16 md:py-24 bg-[var(--bg-section-alt)]">
    <div class="max-w-6xl mx-auto">
      <div class="gallery-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {galleryImages.map((img) => (
          <div class="gallery-item group relative rounded-xl overflow-hidden bg-gradient-to-br from-[#132d82] to-[#389a29] cursor-pointer" onclick="openLightbox('img.src}')">
            <img src={img.src} alt={img.alt} loading="lazy" class="w-full h-72 object-cover transition-transform duration-500 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-5">
              <div>
                <span class="text-gpla-green text-xs font-bold uppercase tracking-widest">{img.label}</span>
                <p class="text-white font-display text-lg mt-0.5">{img.sub}</p>
              </div>
            </div>
          </div>
        ))}
        <!-- Large group photo -->
        <div class="gallery-item group relative rounded-xl overflow-hidden bg-gradient-to-br from-[#389a29] to-[#132d82] cursor-pointer md:col-span-2 lg:col-span-2" onclick="openLightbox('IMG_6439.src}')">
          <img src={IMG_6439.src} alt={IMG_6439.alt} loading="lazy" class="w-full h-80 object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-5">
            <div>
              <span class="text-gpla-green text-xs font-bold uppercase tracking-widest">{IMG_6439.label}</span>
              <p class="text-white font-display text-lg mt-0.5">{IMG_6439.sub}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 bg-black/95 z-50 hidden items-center justify-center" onclick="closeLightbox(event)">
    <button class="absolute top-6 right-6 text-white text-3xl hover:text-gpla-gold transition-colors z-10" onclick="closeLightbox()">&times;</button>
    <img id="lightbox-img" class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg" src="" alt="" />
  </div>

  <Footer />
</Base>

<script>
  // Lightbox
  function openLightbox(src) {
    const lb = document.getElementById('lightbox');
    const img = document.getElementById('lightbox-img');
    if (lb && img) {
      img.src = src;
      lb.classList.remove('hidden');
      lb.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
  }
  
  window.openLightbox = openLightbox;

  function closeLightbox(e) {
    if (e && e.target !== e.currentTarget) return;
    const lb = document.getElementById('lightbox');
    if (lb) {
      lb.classList.add('hidden');
      lb.classList.remove('flex');
      document.body.style.overflow = '';
    }
  }
  
  window.closeLightbox = closeLightbox;

  // Keyboard escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const lb = document.getElementById('lightbox');
      if (lb && !lb.classList.contains('hidden')) {
        lb.classList.add('hidden');
        lb.classList.remove('flex');
        document.body.style.overflow = '';
      }
    }
  });

  // Scroll animations
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        (entry.target).style.opacity = '1';
        (entry.target).style.transform = 'translateY(0)';
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.gallery-item').forEach((el, i) => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(24px)';
    el.style.transition = 'opacity 0.5s cubic-bezier(0.16,1,0.3,1), transform 0.5s cubic-bezier(0.16,1,0.3,1)';
    el.style.transitionDelay = `${(i % 6) * 0.08}s`;
    observer.observe(el);
  });
</script>
