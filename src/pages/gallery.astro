---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PatternRibbon from '../components/PatternRibbon.astro';

// Gallery images sorted by number (filenames like 001.jpg, 002.jpg etc.)
// IMG_6439.JPG is a large file — placed at end
const galleryImages = [
  { src: "/assets/images/gallery/001.jpg", alt: "Summit 2024 — opening ceremony" },
  { src: "/assets/images/gallery/003.jpg", alt: "Summit 2024 — delegates" },
  { src: "/assets/images/gallery/004.jpg", alt: "Summit 2024 — panel session" },
  { src: "/assets/images/gallery/007.jpg", alt: "Inaugural Summit — keynote" },
  { src: "/assets/images/gallery/008.jpg", alt: "Inaugural Summit — keynote address" },
  { src: "/assets/images/gallery/009.jpg", alt: "Inaugural Summit — group photo" },
  { src: "/assets/images/gallery/013.jpg", alt: "Summit — participants" },
  { src: "/assets/images/gallery/015.jpg", alt: "Summit — discussion" },
  { src: "/assets/images/gallery/016.jpg", alt: "Summit — networking" },
  { src: "/assets/images/gallery/017.jpg", alt: "Summit — presentation" },
  { src: "/assets/images/gallery/018.jpg", alt: "Summit — workshop" },
  { src: "/assets/images/gallery/019.jpg", alt: "Summit — breakout session" },
  { src: "/assets/images/gallery/020.jpg", alt: "Summit 2025 — keynote" },
  { src: "/assets/images/gallery/022.jpg", alt: "Summit 2025 — policy dialogue" },
  { src: "/assets/images/gallery/023.jpg", alt: "Summit 2025 — delegates" },
  { src: "/assets/images/gallery/024.jpg", alt: "Summit moments" },
  { src: "/assets/images/gallery/025.jpg", alt: "Summit moments" },
  { src: "/assets/images/gallery/026.jpg", alt: "Summit — closing ceremony" },
  { src: "/assets/images/gallery/027.jpg", alt: "Summit — group" },
  { src: "/assets/images/gallery/028.jpg", alt: "Summit — award" },
  { src: "/assets/images/gallery/029.jpg", alt: "HerPower Fellowship at summit" },
];

const IMG_6439 = { src: "/assets/images/gallery/IMG_6439.JPG", alt: "Summit group photo" };
---

<Base title="Gallery" description="View moments from the Guild Leaders' Summits across East Africa.">
  <Navbar />

  <!-- Hero -->
  <section class="min-h-[50vh] bg-gpla-navy section-padding relative overflow-hidden flex items-center" style="padding-top: 8rem;">
    <div class="absolute inset-0 bg-gradient-to-r from-[#132d82]/95 via-[#132d82]/80 to-[#389a29]/60"></div>
    <div class="relative z-10 w-full">
      <div class="section-container text-center">
        <p class="section-label section-label--gold" data-animate>GPLA Gallery</p>
      <h1 class="font-display text-white text-[clamp(2.5rem,8vw,6rem)] leading-[0.95]" data-animate data-delay="100">
        Our Gallery
      </h1>
      <p class="text-white/80 text-lg md:text-xl max-w-2xl mx-auto font-body" data-animate data-delay="150">
        700+ leaders. 6 countries. 3 summits. Witness the moments that shaped a movement.
      </p>
      </div>
    </div>
  </section>

  <PatternRibbon height={24} />

  <!-- Gallery Grid -->
  <section class="px-4 md:px-12 py-16 md:py-24 section-alt section-kente-surface african-gallery-weave">
    <div class="max-w-6xl mx-auto">
      <div class="gallery-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4">
        {galleryImages.map((img) => (
          <div class="card-lift gallery-item group relative rounded-xl overflow-hidden bg-gradient-to-br from-[#132d82] to-[#389a29] cursor-pointer" data-lightbox-src={img.src} data-lightbox-alt={img.alt}>
            <img src={img.src} alt={img.alt} loading="lazy" class="w-full h-56 md:h-72 object-cover transition-transform duration-500 group-hover:scale-105" />
            <div class="gallery-overlay"><span>GPLA</span></div>
          </div>
        ))}
        <!-- Large group photo -->
        <div class="gallery-item group relative rounded-xl overflow-hidden bg-gradient-to-br from-[#389a29] to-[#132d82] cursor-pointer sm:col-span-2 lg:col-span-2" data-lightbox-src={IMG_6439.src} data-lightbox-alt={IMG_6439.alt}>
          <img src={IMG_6439.src} alt={IMG_6439.alt} loading="lazy" class="w-full h-56 md:h-80 object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="gallery-overlay"><span>GPLA</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 bg-black/95 z-50 hidden items-center justify-center flex-col gap-4" data-lightbox role="dialog" aria-modal="true" aria-label="Gallery image">
    <button type="button" class="absolute top-6 right-6 text-white text-3xl hover:text-gpla-gold transition-colors z-10" data-lightbox-close aria-label="Close image">&times;</button>
    <img id="lightbox-img" class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg" src="" alt="" />
    <p id="lightbox-error" class="text-white/80 font-body text-center px-6" role="alert" hidden>This image could not be loaded. Please try again later.</p>
  </div>

  <Footer />
</Base>

<script>
  import { onReady, reportError, safeInit } from '../scripts/errors';

  const lightbox = () => {
    const lb = document.getElementById('lightbox');
    const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const error = document.getElementById('lightbox-error');
    if (!lb || !img || !error) {
      throw new Error('lightbox markup is missing');
    }

    const close = () => {
      lb.classList.add('hidden');
      lb.classList.remove('flex');
      document.body.style.overflow = '';
      img.removeAttribute('src');
      error.hidden = true;
      img.hidden = false;
    };

    const open = (src: string, alt: string) => {
      error.hidden = true;
      img.hidden = false;
      img.alt = alt;
      img.src = src;
      lb.classList.remove('hidden');
      lb.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    // A failed image used to leave an empty black overlay with no explanation.
    img.addEventListener('error', () => {
      if (!img.getAttribute('src')) return;
      reportError('lightbox image load', new Error(`could not load ${img.src}`));
      img.hidden = true;
      error.hidden = false;
    });

    document.querySelectorAll<HTMLElement>('[data-lightbox-src]').forEach((item) => {
      item.addEventListener('click', () => {
        open(item.dataset.lightboxSrc || '', item.dataset.lightboxAlt || '');
      });
    });

    lb.addEventListener('click', (event) => {
      if (event.target === lb || (event.target as HTMLElement).closest('[data-lightbox-close]')) close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !lb.classList.contains('hidden')) close();
    });
  };

  onReady('gallery lightbox', lightbox);

  // Scroll animations — items are hidden inline, so reveal them if observation fails.
  onReady(
    'gallery scroll animations',
    () => {
      const items = Array.from(document.querySelectorAll<HTMLElement>('.gallery-item'));
      if (!items.length) return;

      const reveal = (el: HTMLElement) => {
        el.style.opacity = '1';
        el.style.transform = 'translateY(0)';
      };

      if (typeof IntersectionObserver === 'undefined') return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            safeInit('gallery item reveal', () => reveal(entry.target as HTMLElement));
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      items.forEach((el, i) => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(24px)';
        el.style.transition = 'opacity 0.5s cubic-bezier(0.16,1,0.3,1), transform 0.5s cubic-bezier(0.16,1,0.3,1)';
        el.style.transitionDelay = `${(i % 6) * 0.08}s`;
        observer.observe(el);
      });
    },
    () => {
      document.querySelectorAll<HTMLElement>('.gallery-item').forEach((el) => {
        el.style.opacity = '1';
        el.style.transform = 'none';
      });
    },
  );
</script>
