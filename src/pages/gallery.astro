---
import Page from '../layouts/Page.astro';
import PageHero from '../components/PageHero.astro';
import PatternRibbon from '../components/PatternRibbon.astro';

// Gallery images sorted by number (filenames like 001.jpg, 002.jpg etc.)
// IMG_6439.JPG is a large file — placed at end
const galleryImages = [
  { src: "/assets/images/gallery/001.jpg", alt: "Summit 2024 — opening ceremony" },
  { src: "/assets/images/gallery/003.jpg", alt: "Summit 2024 — delegates" },
  { src: "/assets/images/gallery/004.jpg", alt: "Summit 2024 — panel session" },
  { src: "/assets/images/gallery/007.jpg", alt: "Inaugural Summit — keynote" },
  { src: "/assets/images/gallery/008.jpg", alt: "Inaugural Summit — keynote address" },
  { src: "/assets/images/gallery/009.jpg", alt: "Inaugural Summit — group photo" },
  { src: "/assets/images/gallery/013.jpg", alt: "Summit — participants" },
  { src: "/assets/images/gallery/015.jpg", alt: "Summit — discussion" },
  { src: "/assets/images/gallery/016.jpg", alt: "Summit — networking" },
  { src: "/assets/images/gallery/017.jpg", alt: "Summit — presentation" },
  { src: "/assets/images/gallery/018.jpg", alt: "Summit — workshop" },
  { src: "/assets/images/gallery/019.jpg", alt: "Summit — breakout session" },
  { src: "/assets/images/gallery/020.jpg", alt: "Summit 2025 — keynote" },
  { src: "/assets/images/gallery/022.jpg", alt: "Summit 2025 — policy dialogue" },
  { src: "/assets/images/gallery/023.jpg", alt: "Summit 2025 — delegates" },
  { src: "/assets/images/gallery/024.jpg", alt: "Summit moments" },
  { src: "/assets/images/gallery/025.jpg", alt: "Summit moments" },
  { src: "/assets/images/gallery/026.jpg", alt: "Summit — closing ceremony" },
  { src: "/assets/images/gallery/027.jpg", alt: "Summit — group" },
  { src: "/assets/images/gallery/028.jpg", alt: "Summit — award" },
  { src: "/assets/images/gallery/029.jpg", alt: "HerPower Fellowship at summit" },
];

const IMG_6439 = { src: "/assets/images/gallery/IMG_6439.JPG", alt: "Summit group photo" };
---

<Page title="Gallery" description="View moments from the Guild Leaders' Summits across East Africa.">
  <PageHero
    label="GPLA Gallery"
    title="Our Gallery"
    align="center"
    minHeight="min-h-[50vh]"
    titleSize="text-[clamp(2.5rem,8vw,6rem)]"
    overlay="bg-gradient-to-r from-[#132d82]/95 via-[#132d82]/80 to-[#389a29]/60"
    patternOverlay={false}
    subtitleClass="text-white/80 text-lg md:text-xl max-w-2xl font-body"
    subtitle="700+ leaders. 6 countries. 3 summits. Witness the moments that shaped a movement."
  />

  <PatternRibbon height={24} />

  <!-- Gallery Grid -->
  <section class="px-4 md:px-12 py-16 md:py-24 section-alt section-kente-surface african-gallery-weave">
    <div class="max-w-6xl mx-auto">
      <div class="gallery-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4">
        {galleryImages.map((img) => (
          <div class="card-lift gallery-item group relative rounded-xl overflow-hidden bg-gradient-to-br from-[#132d82] to-[#389a29] cursor-pointer" onclick={`openLightbox('${img.src}')`}>
            <img src={img.src} alt={img.alt} loading="lazy" class="w-full h-56 md:h-72 object-cover transition-transform duration-500 group-hover:scale-105" />
            <div class="gallery-overlay"><span>GPLA</span></div>
          </div>
        ))}
        <!-- Large group photo -->
        <div class="gallery-item group relative rounded-xl overflow-hidden bg-gradient-to-br from-[#389a29] to-[#132d82] cursor-pointer sm:col-span-2 lg:col-span-2" onclick={`openLightbox('${IMG_6439.src}')`}>
          <img src={IMG_6439.src} alt={IMG_6439.alt} loading="lazy" class="w-full h-56 md:h-80 object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="gallery-overlay"><span>GPLA</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 bg-black/95 z-50 hidden items-center justify-center" onclick="closeLightbox(event)">
    <button class="absolute top-6 right-6 text-white text-3xl hover:text-gpla-gold transition-colors z-10" onclick="closeLightbox()">&times;</button>
    <img id="lightbox-img" class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg" src="" alt="" />
  </div>

</Page>

<script>
  import { revealOnScroll } from '../scripts/reveal';

  // Lightbox
  function openLightbox(src) {
    const lb = document.getElementById('lightbox');
    const img = document.getElementById('lightbox-img');
    if (lb && img) {
      img.src = src;
      lb.classList.remove('hidden');
      lb.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
  }

  window.openLightbox = openLightbox;

  function closeLightbox(e) {
    if (e && e.target !== e.currentTarget) return;
    const lb = document.getElementById('lightbox');
    if (lb) {
      lb.classList.add('hidden');
      lb.classList.remove('flex');
      document.body.style.overflow = '';
    }
  }

  window.closeLightbox = closeLightbox;

  // Keyboard escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const lb = document.getElementById('lightbox');
      if (lb && !lb.classList.contains('hidden')) {
        lb.classList.add('hidden');
        lb.classList.remove('flex');
        document.body.style.overflow = '';
      }
    }
  });

  // Staggered reveal for gallery tiles
  document.querySelectorAll('.gallery-item').forEach((el, i) => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(24px)';
    el.style.transition = 'opacity 0.5s cubic-bezier(0.16,1,0.3,1), transform 0.5s cubic-bezier(0.16,1,0.3,1)';
    el.style.transitionDelay = `${(i % 6) * 0.08}s`;
  });

  revealOnScroll(
    '.gallery-item',
    (el) => {
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
    },
    { threshold: 0.1 },
  );
</script>
