---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PatternBackdrop from '../components/PatternBackdrop.astro';
import PatternDivider from '../components/PatternDivider.astro';
import SummitYearCard from '../components/SummitYearCard.astro';
import { executiveDirector } from '../data/site';
---

<style is:global>
  /* ===== HERO ===== */
  .hero-home {
    min-height: 90vh;
    background: linear-gradient(135deg, rgba(10,22,40,0.85) 0%, rgba(19,45,130,0.7) 40%, rgba(26,61,92,0.5) 100%);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .hero-home::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events: none;
  }
  .hero-home::after {
    content: '';
    position: absolute;
    top: -30%; right: -10%;
    width: min(800px, 100vw); height: min(800px, 100vw);
    background: radial-gradient(circle, rgba(56,154,41,0.08) 0%, transparent 60%);
    pointer-events: none;
  }
  .hero-home .hero-gradient-mask {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(10,22,40,0.92) 0%, rgba(19,45,130,0.6) 40%, transparent 70%);
    z-index: 1;
  }


  /* ===== STATS STRIP ===== */
  @keyframes stats-gradient-shift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  .stats-strip {
    background: linear-gradient(135deg, #ffffff 0%, #f0f4ff 25%, #f0fff4 50%, #fffbf0 75%, #ffffff 100%);
    background-size: 400% 400%;
    animation: stats-gradient-shift 12s ease infinite;
    position: relative;
    overflow: hidden;
    border-top: 3px solid transparent;
    border-image: linear-gradient(90deg, #132d82, #389a29, #F5A623, #132d82) 1;
  }
  .stat-item {
    position: relative;
    padding: 2rem 1rem;
  }
  .stat-item::after {
    content: '';
    position: absolute;
    right: 0;
    top: 20%;
    height: 60%;
    width: 1px;
    background: linear-gradient(180deg, transparent, #132d82/12, transparent);
  }
  .stat-item:last-child::after { display: none; }
  @media (max-width: 767px) {
    .stat-item:nth-child(2)::after { display: none; }
  }
  .stat-number {
    font-family: var(--font-display, 'Sora', sans-serif);
    font-size: clamp(2rem, 7vw, 5rem);
    line-height: 1;
    color: #132d82;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .stat-number { white-space: nowrap; }
  .stat-number .ani-counter {
    background: linear-gradient(135deg, #132d82 0%, #389a29 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .stat-label {
    color: #4b5563;
    font-size: 0.8rem;
    font-weight: 500;
    margin-top: 0.5rem;
  }
  .stat-accent {
    display: block;
    width: 32px;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, #389a29, #E8A33D);
    margin: 0 auto 1rem;
  }

  /* ===== PROGRAMS BENTO GRID ===== */
  .programs-section {
    position: relative;
    background: rgba(255, 255, 255, 0.92);
    overflow: hidden;
  }

  .programs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 768px) {
    .programs-grid { grid-template-columns: 1fr 1fr; gap: 28px; }
    .program-card { padding: 36px 32px 28px; }
  }

  /* ---- Card base ---- */
  .program-card {
    position: relative;
    border-radius: 20px;
    padding: 24px 20px 20px;
    overflow: hidden;
    border: 2px solid transparent;
    display: flex;
    flex-direction: column;
    gap: 16px;
    cursor: pointer;
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.4s ease;
    will-change: transform;
  }
  /* Vibrant gradient backgrounds */
  .program-card--navy  { background: linear-gradient(135deg, #0a1a4a 0%, #1e40af 100%); }
  .program-card--green { background: linear-gradient(135deg, #14532d 0%, #0d9488 100%); }
  .program-card--gold  { background: linear-gradient(135deg, #b8801a 0%, #ea580c 100%); }
  .program-card--purple{ background: linear-gradient(135deg, #581c87 0%, #4338ca 100%); }

  /* Shimmer sweep pseudo-element */
  .program-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.18) 50%, transparent 60%);
    transform: translateX(-100%);
    transition: none;
    z-index: 2;
    pointer-events: none;
  }
  .program-card:hover::before {
    transform: translateX(100%);
    transition: transform 0.7s ease;
  }

  /* Hover states */
  .program-card:hover {
    transform: translateY(-8px) scale(1.05);
  }
  .program-card--navy:hover  {
    box-shadow: 0 20px 60px rgba(19,45,130,0.5), 0 0 30px rgba(30,64,175,0.4);
    border-color: rgba(96,165,250,0.5);
  }
  .program-card--green:hover {
    box-shadow: 0 20px 60px rgba(56,154,41,0.45), 0 0 30px rgba(13,148,136,0.4);
    border-color: rgba(52,211,153,0.5);
  }
  .program-card--gold:hover  {
    box-shadow: 0 20px 60px rgba(245,166,35,0.45), 0 0 30px rgba(234,88,12,0.35);
    border-color: rgba(251,191,36,0.5);
  }
  .program-card--purple:hover{
    box-shadow: 0 20px 60px rgba(124,58,237,0.45), 0 0 30px rgba(67,56,202,0.4);
    border-color: rgba(167,139,250,0.5);
  }

  /* Animated glowing border keyframes */
  @keyframes border-glow-navy   { 0%,100%{border-color:rgba(96,165,250,0.3)} 50%{border-color:rgba(96,165,250,0.7)} }
  @keyframes border-glow-green  { 0%,100%{border-color:rgba(52,211,153,0.3)} 50%{border-color:rgba(52,211,153,0.7)} }
  @keyframes border-glow-gold   { 0%,100%{border-color:rgba(251,191,36,0.3)} 50%{border-color:rgba(251,191,36,0.7)} }
  @keyframes border-glow-purple { 0%,100%{border-color:rgba(167,139,250,0.3)} 50%{border-color:rgba(167,139,250,0.7)} }
  .program-card--navy:hover  { animation: border-glow-navy 2s ease-in-out infinite; }
  .program-card--green:hover { animation: border-glow-green 2s ease-in-out infinite; }
  .program-card--gold:hover  { animation: border-glow-gold 2s ease-in-out infinite; }
  .program-card--purple:hover{ animation: border-glow-purple 2s ease-in-out infinite; }

  /* Click press */
  .program-card.card-pressed {
    transform: scale(0.97) !important;
    transition: transform 0.1s ease !important;
  }

  /* Watermark number */
  .program-card__number {
    position: absolute;
    top: -8px; right: 16px;
    font-family: var(--font-display, 'Sora', sans-serif);
    font-size: clamp(80px, 8vw, 120px);
    font-weight: 800;
    line-height: 1;
    color: rgba(255,255,255,0.06);
    pointer-events: none;
    user-select: none;
    transition: color 0.4s ease, transform 0.4s ease;
  }
  .program-card:hover .program-card__number {
    color: rgba(255,255,255,0.14);
    transform: translateX(-8px);
  }
  .program-card--gold .program-card__number { color: rgba(0,0,0,0.06); }
  .program-card--gold:hover .program-card__number { color: rgba(0,0,0,0.14); }

  /* Floating icon animation */
  @keyframes icon-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  @keyframes icon-pulse-glow {
    0%, 100% { box-shadow: 0 0 12px rgba(255,255,255,0.1); }
    50% { box-shadow: 0 0 24px rgba(255,255,255,0.25); }
  }
  .program-card__icon {
    font-size: 36px;
    line-height: 1;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    position: relative;
    z-index: 3;
    background: rgba(255,255,255,0.12);
    animation: icon-float 3s ease-in-out infinite, icon-pulse-glow 3s ease-in-out infinite;
  }
  .program-card:hover .program-card__icon {
    transform: scale(1.1) rotate(-4deg);
  }

  .program-card__body { position: relative; z-index: 3; flex: 1; }
  .program-card__title {
    font-family: var(--font-display, 'Sora', sans-serif);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 700;
    line-height: 1.25;
    color: #fff;
    margin-bottom: 8px;
  }
  .program-card--gold .program-card__title { color: #1a1a1a; }
  .program-card__desc {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.925rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.75);
  }
  .program-card--gold .program-card__desc { color: rgba(0,0,0,0.65); }

  .program-card__link {
    position: relative;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display, 'Sora', sans-serif);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: rgba(255,255,255,0.9);
    transition: gap 0.3s ease, color 0.3s ease;
  }
  .program-card--gold .program-card__link { color: rgba(0,0,0,0.8); }
  .program-card__link:hover { gap: 12px; color: #fff; }
  .program-card--gold .program-card__link:hover { color: #000; }
  .program-card__link span {
    transition: transform 0.3s ease;
  }
  .program-card__link:hover span { transform: translateX(4px); }

  /* Staggered entrance animations */
  .program-card[data-entrance="left"] {
    opacity: 0;
    transform: translateX(-80px);
  }
  .program-card[data-entrance="right"] {
    opacity: 0;
    transform: translateX(80px);
  }
  .program-card.program-entered {
    opacity: 1;
    transform: translateX(0);
    transition: opacity 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
                transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .program-card, .program-card::before, .program-card__icon,
    .program-card__number, .programs-bg-blob {
      animation: none !important;
      transition: none !important;
    }
    .program-card[data-entrance="left"],
    .program-card[data-entrance="right"] {
      opacity: 1;
      transform: none;
    }
  }


  /* ===== PARTNER LOGOS ===== */
  .partner-logo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  @media (min-width: 640px) {
    .partner-logo-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 1024px) {
    .partner-logo-grid { grid-template-columns: repeat(5, 1fr); }
  }
  .partner-logo-item {
    background: #f8fafb;
    border: 1px solid rgba(19,45,130,0.08);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 80px;
    transition: all 0.3s ease;
  }
  .partner-logo-item:hover {
    background: #f0f4f8;
    border-color: rgba(19,45,130,0.15);
    box-shadow: 0 2px 12px rgba(19,45,130,0.06);
  }
  .partner-logo-placeholder {
    font-family: var(--font-display, 'Sora', sans-serif);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(19,45,130,0.2);
    text-align: center;
  }
</style>

<Base title="Home" description="Guild Presidents Leadership Academy - Nurturing ethical, visionary and transformational leaders across East Africa.">
  <Navbar />

  <!-- ===== HERO ===== -->
  <section class="hero-home">

    <!-- Hero Video Background -->
    <div class="absolute inset-0 z-0 overflow-hidden">
      <video autoplay muted loop playsinline class="w-full h-full object-cover opacity-40" poster="/assets/hero-poster.jpg">
        <source src="/assets/hero-bg-compressed.mp4" type="video/mp4">
        <source src="/assets/GLP Short Video.mp4" type="video/mp4">
      </video>
    </div>
    <div class="hero-gradient-mask"></div>
    <div class="african-hero-overlay"></div>
    <div class="hero-cursor-glow"><div class="hero-cursor-glow__dot" id="hero-glow-dot"></div></div>
    <div class="relative z-10 w-full">
      <div class="min-h-[90vh] flex items-center">
        <div class="w-full md:w-[55%] bg-black/15 backdrop-blur-[2px] pl-6 md:pl-12 pr-8 md:pr-16 py-10 md:py-14 min-h-[90vh] flex items-center overflow-hidden">
          <div>
            <h1 class="font-display text-white text-[clamp(2.5rem,5.5vw,4.5rem)] leading-[1.05] mb-6">
              <span class="hero-line">Ethical Leaders</span>
              <span class="hero-line"><span class="text-gpla-gold">Transforming</span></span>
              <span class="hero-line">East Africa</span>
            </h1>
            <p class="text-white/75 text-base md:text-lg max-w-[500px] leading-relaxed mb-10 font-body" data-animate data-delay="200" style="text-align: justify;">
              Empowering ethical youth leaders for democratic transformation in East Africa through leadership training, mentorship, policy dialogue and regional summits.
            </p>
            <div class="flex flex-wrap gap-4" data-animate data-delay="300">
              <a href="/programs" class="btn btn-primary btn-lg">
                Our Programs
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
              <a href="/summit" class="btn btn-outline btn-lg">
                View Summit
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== STATS STRIP ===== -->
  <section class="stats-strip section-padding african-diamond-lattice" data-animate>
    <div class="section-container">
      <div class="grid grid-cols-2 md:grid-cols-4 text-center">
        <div class="stat-item">
          <span class="stat-accent"></span>
          <div class="stat-number"><span data-target="10000" data-suffix="+" class="ani-counter">0+</span></div>
          <div class="stat-label font-body uppercase tracking-widest">Former Leaders Convened</div>
        </div>
        <div class="stat-item">
          <span class="stat-accent"></span>
          <div class="stat-number"><span data-target="8" class="ani-counter">0</span></div>
          <div class="stat-label font-body uppercase tracking-widest">Countries Represented</div>
        </div>
        <div class="stat-item">
          <span class="stat-accent"></span>
          <div class="stat-number"><span data-target="4" class="ani-counter">0</span></div>
          <div class="stat-label font-body uppercase tracking-widest">Flagship Programs</div>
        </div>
        <div class="stat-item">
          <span class="stat-accent"></span>
          <div class="stat-number"><span data-target="3" class="ani-counter">0</span></div>
          <div class="stat-label font-body uppercase tracking-widest">Regional Summits Held</div>
        </div>
      </div>
    </div>
  </section>

  <PatternDivider />

  <!-- ===== MARQUEE STRIP ===== -->
  <div class="marquee-strip african-kente-band" aria-hidden="true">
    <div class="marquee-track">
      <span>Leadership</span><span class="marquee-dot">·</span>
      <span>Innovation</span><span class="marquee-dot">·</span>
      <span>Integration</span><span class="marquee-dot">·</span>
      <span>Governance</span><span class="marquee-dot">·</span>
      <span>Youth</span><span class="marquee-dot">·</span>
      <span>East Africa</span><span class="marquee-dot">·</span>
      <span>Ethical Leaders</span><span class="marquee-dot">·</span>
      <span>Leadership</span><span class="marquee-dot">·</span>
      <span>Innovation</span><span class="marquee-dot">·</span>
      <span>Integration</span><span class="marquee-dot">·</span>
      <span>Governance</span><span class="marquee-dot">·</span>
      <span>Youth</span><span class="marquee-dot">·</span>
      <span>East Africa</span><span class="marquee-dot">·</span>
      <span>Ethical Leaders</span><span class="marquee-dot">·</span>
    </div>
  </div>

  <!-- ===== ABOUT PREVIEW ===== -->
  <section class="section-padding" data-animate>
    <div class="section-container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20 items-center">
        <div class="bg-gpla-navy p-8 md:p-12 relative rounded-2xl overflow-hidden african-quote-frame" data-animate>
          <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-gpla-green rounded-full"></div>
          <div class="flex flex-col sm:flex-row gap-6 items-start">
            <img
              src={executiveDirector.photo}
              alt={executiveDirector.photoAlt}
              width="160"
              height="200"
              class="w-32 sm:w-36 md:w-40 flex-shrink-0 rounded-xl object-cover object-top shadow-lg border-2 border-gpla-gold/30"
              loading="lazy"
            />
            <div class="min-w-0">
              <p class="text-white text-lg md:text-xl italic leading-relaxed font-body">
                &ldquo;{executiveDirector.quote}&rdquo;
              </p>
              <cite class="block mt-5 text-gpla-gold text-sm md:text-base not-italic font-display tracking-wide leading-snug">
                — {executiveDirector.attribution}
              </cite>
            </div>
          </div>
        </div>
        <div data-animate="slide-right" data-delay="100">
          <span class="section-label">About Us</span>
          <span class="accent-line"></span>
          <h2 class="section-title text-gpla-navy mb-6">Nurturing Ethical, Visionary Leaders</h2>
          <div class="content-text content-text--muted" style="text-align: justify;">
            <p>The Guild Presidents Leadership Academy (GPLA) is a non-partisan leadership development and regional convening platform committed to nurturing ethical, visionary and transformational leaders across East Africa.</p>
            <p>Through leadership training, mentorship, policy dialogue, regional summits, research, institutional partnerships and community-based initiatives, GPLA brings together young leaders, governments, universities, development partners, the private sector and experienced statespersons to address critical governance and development challenges.</p>
            <p>GPLA is headquartered in Uganda and works across East Africa to build bridges between generations, institutions and countries.</p>
          </div>
          <a href="/about" class="btn btn-primary mt-6">
            Learn More About Us
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== SUMMITS SECTION ===== -->
  <section class="section-padding section-navy relative overflow-hidden">
    <PatternBackdrop variant="navy" />
    <div class="section-container relative z-10">
      <div class="text-center mb-12" data-animate>
        <span class="section-label section-label--gold">Our Summits</span>
        <h2 class="section-title section-title--centered text-white animated-gradient-bg" style="-webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Three Years. One Movement.</h2>
      </div>
      <div class="summit-bento-grid summit-bento-grid--summits">
        <SummitYearCard
          class="summit-bento-card--featured"
          year="2026"
          variant="2026"
          featured
          tagline="23–24 July 2026 · Completed"
          title="3rd Annual East African Guild Leaders' Summit"
          theme="Youth Leadership, Production, and Regional Integration: Building a Competitive East Africa in a Changing Global Order"
          imageSrc="/assets/images/gallery/020.jpg"
          meta={[
            { label: 'Chief Guest', value: 'H.E. Yoweri Kaguta Museveni', sub: 'President of Uganda & EAC Chairperson' },
            { label: 'Venue', value: 'Freedom Square', sub: 'Makerere University, Kampala' },
          ]}
          primaryCta={{ href: '/summit/2026', label: 'Report Coming Soon →' }}
        />
        <SummitYearCard
          year="2025"
          variant="2025"
          tagline="24 April 2025 · Makerere University"
          title="2nd Annual Guild Leaders' Summit"
          theme="Leadership with Integrity; Building Foundations for Good Governance in East Africa"
          imageSrc="/assets/images/gallery/008.jpg"
          meta={[
            { label: 'Chief Guest', value: 'H.E. Uhuru Kenyatta', sub: '4th President, Republic of Kenya' },
            { label: 'Attendees', value: '1,000+', sub: 'Youth leaders · 920 registered' },
          ]}
          primaryCta={{ href: '/summit/2025', label: 'View Full Report →' }}
        />
        <SummitYearCard
          year="2024"
          variant="2024"
          tagline="April 15, 2024 · Makerere"
          title="Inaugural Guild Leaders' Summit"
          theme="Legacy and Leadership Continuum: The Power of Knowledge and Cross-Generational Learning"
          imageSrc="/assets/images/gallery/001.jpg"
          meta={[
            { label: 'Chief Guest', value: 'HE. Jakaya Mrisho Kikwete', sub: 'Former President, Tanzania' },
            { label: 'Attendees', value: '700+', sub: 'Historic first convening' },
          ]}
          primaryCta={{ href: '/summit/2024', label: 'View Full Report →' }}
        />
      </div>
      <p class="text-center mt-10" data-animate>
        <a href="/summit" class="btn btn-outline">View All Summits</a>
      </p>
    </div>
  </section>

  <!-- ===== GALLERY STRIP ===== -->
  <section class="section-padding african-gallery-weave section-kente-surface" data-animate>
    <div class="section-container">
      <div class="text-center mb-10">
        <span class="section-label">Moments from Our Summits</span>
        <h2 class="section-title section-title--centered text-gpla-navy">Gallery</h2>
      </div>
      <div class="grid grid-cols-3 md:grid-cols-6 gap-2 md:gap-3">
        <a href="/gallery" class="gallery-item group relative rounded-xl overflow-hidden aspect-square bg-gradient-to-br from-[#132d82] to-[#389a29]" data-animate="scale">
          <img src="/assets/images/gallery/001.jpg" alt="Summit" loading="lazy" class="w-full h-full object-cover" />
          <div class="gallery-overlay"><span>GPLA</span></div>
        </a>
