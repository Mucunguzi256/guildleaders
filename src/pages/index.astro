---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<style is:global>
  /* ===== SUMMIT 2026 COUNTDOWN ===== */
  .summit-2026-banner {
    background: linear-gradient(135deg, #0a1628 0%, #132d82 50%, #1a3d5c 100%);
    position: relative;
    overflow: hidden;
  }
  .summit-2026-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events: none; opacity: 0.3;
  }
  .summit-2026-banner::after {
    content: '';
    position: absolute;
    top: -50%; right: -20%;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(56,154,41,0.08) 0%, transparent 70%);
    pointer-events: none;
  }
  .summit-hero-countdown {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    max-width: 400px;
  }
  .summit-hero-countdown .cd-item {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    padding: 10px 4px;
    text-align: center;
    backdrop-filter: blur(4px);
  }
  .summit-hero-countdown .cd-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(1.6rem, 5vw, 2.4rem);
    line-height: 1;
    display: block;
    color: #F5A623;
  }
  .summit-hero-countdown .cd-label {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.6;
    display: block;
    margin-top: 2px;
    color: #fff;
  }
  @media (max-width: 400px) {
    .summit-hero-countdown { grid-template-columns: repeat(2, 1fr); max-width: 220px; }
  }

  /* ===== LUMA EMBED ===== */
  .luma-embed-section {
    background: linear-gradient(180deg, #132d82 0%, #0a1628 100%);
    position: relative;
    overflow: hidden;
  }
  .luma-embed-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 30% 50%, rgba(56,154,41,0.06) 0%, transparent 50%);
    pointer-events: none;
  }
  .luma-embed-section .luma-container { position: relative; z-index: 1; }

  /* ===== n8n-style PARALLAX STICKY CARDS ===== */
  .parallax-card {
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
  }
  .parallax-card.sticky {
    position: sticky;
    top: 88px;
    min-height: 560px;
  }
  @media (min-width: 1024px) {
    .parallax-card.sticky { min-height: 600px; }
  }

  /* Fix z-index stacking — higher z-index on TOP cards, lower on BOTTOM cards */
  .parallax-card.sticky { z-index: auto; }
  
  /* Card color variants */
  .parallax-card--2026 { background: linear-gradient(135deg, #0a1628 0%, #132d82 50%, #1a3d5c 100%); }
  .parallax-card--2025 { background: linear-gradient(135deg, #0d2818 0%, #1a4d2e 50%, #2d6b3f 100%); }
  .parallax-card--2024 { background: linear-gradient(135deg, #2d1f0d 0%, #5c3d12 50%, #8b5a2b 100%); }
  .parallax-card--tlb { background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 50%, #132d82 100%); }
  .parallax-card--pgil { background: linear-gradient(135deg, #14532d 0%, #15803d 50%, #22c55e 100%); }
  .parallax-card--herpower { background: linear-gradient(135deg, #4a1d4e 0%, #7c3aed 50%, #a855f7 100%); }
  .parallax-card--summit { background: linear-gradient(135deg, #064e3b 0%, #065f46 50%, #10b981 100%); }

  .parallax-card-grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .parallax-card-inner {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  @media (min-width: 1024px) {
    .parallax-card-inner { flex-direction: row; align-items: center; min-height: 600px; }
  }

  /* Media column */
  .parallax-media { position: relative; display: flex; align-items: center; justify-content: center; padding: 0; order: -1; }
  @media (min-width: 1024px) { .parallax-media { width: 42%; order: 2; padding: 24px 40px 24px 0; } }

  .parallax-media-badge {
    position: relative;
    width: 100%;
    max-width: 340px;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
  }
  .parallax-media-badge .year-number {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(80px, 12vw, 140px);
    line-height: 1;
    color: rgba(255,255,255,0.06);
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  .parallax-media-badge .program-icon {
    font-size: clamp(60px, 8vw, 96px);
    line-height: 1;
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 8px 24px rgba(0,0,0,0.2));
  }
  .parallax-media-badge .badge-ring {
    position: absolute;
    inset: 0;
    border: 2px solid rgba(255,255,255,0.06);
    border-radius: 50%;
  }
  .parallax-media-badge .badge-ring:nth-child(2) { transform: scale(0.75); }
  .parallax-media-badge .badge-ring:nth-child(3) { transform: scale(0.5); border-color: rgba(245,166,35,0.12); }

  @media (max-width: 1023px) {
    .parallax-media { padding: 32px 32px 0; }
    .parallax-media-badge { max-width: 200px; }
    .parallax-media-badge .year-number { font-size: 64px; }
    .parallax-media-badge .program-icon { font-size: 48px; }
  }

  /* Content column */
  .parallax-content { padding: 32px 32px 40px; }
  @media (min-width: 1024px) { .parallax-content { width: 58%; padding: 56px 0 56px 56px; } }
  @media (min-width: 1280px) { .parallax-content { padding-left: 100px; } }

  .parallax-content .tagline {
    font-size: 12px; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: #F5A623; display: block; margin-bottom: 8px;
  }
  .parallax-content h2 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(28px, 4vw, 44px); line-height: 1.05;
    color: #fff; margin-bottom: 14px;
  }
  .parallax-content .desc {
    font-size: clamp(14px, 1.1vw, 16px); line-height: 1.6;
    color: rgba(255,255,255,0.8); margin-bottom: 20px;
  }
  .parallax-content .meta-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
    margin-bottom: 20px; padding: 16px;
    background: rgba(255,255,255,0.05); border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.06);
  }
  .parallax-content .meta-label { font-size: 10px; opacity: 0.5; text-transform: uppercase; letter-spacing: 0.08em; display: block; }
  .parallax-content .meta-value { font-family: 'Bebas Neue', sans-serif; font-size: clamp(16px, 1.5vw, 20px); display: block; margin: 2px 0; color: #fff; }
  .parallax-content .meta-sub { font-size: 11px; opacity: 0.6; display: block; color: rgba(255,255,255,0.7); }
  .parallax-content .outcomes { margin-bottom: 20px; }
  .parallax-content .outcomes h4 { color: #F5A623; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 8px; }
  .parallax-content .outcomes ul { list-style: none; padding: 0; }
  .parallax-content .outcomes li { padding: 3px 0; font-size: 13px; color: rgba(255,255,255,0.85); display: flex; align-items: flex-start; gap: 6px; }
  .parallax-content .outcomes li::before { content: '✓'; color: #F5A623; }
  .parallax-content .panel-cta {
    display: inline-block; padding: 12px 28px; border-radius: 999px; font-weight: 600; font-size: 14px;
    text-decoration: none; transition: all 0.3s cubic-bezier(0.16,1,0.3,1);
    background: #F5A623; color: #132d82; min-height: 44px;
  }
  .parallax-content .panel-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.3); }
  .parallax-content .panel-cta.ghost { background: rgba(255,255,255,0.05); border: 2px solid rgba(255,255,255,0.4); color: #fff; }
  .parallax-content .panel-cta.ghost:hover { background: rgba(255,255,255,0.12); border-color: #fff; }
  .parallax-content .panel-actions { display: flex; gap: 10px; flex-wrap: wrap; }

  @media (max-width: 1023px) {
    .parallax-content .meta-grid { grid-template-columns: 1fr; }
    .parallax-content .panel-actions { flex-direction: column; }
    .parallax-content .panel-cta { width: 100%; text-align: center; }
    .parallax-card.sticky { position: relative; top: auto !important; min-height: auto; margin-bottom: 16px; z-index: auto !important; }
    .parallax-card-inner { min-height: auto; }
  }

  /* Section heading — enlarged, commanding */
  .parallax-section-heading {
    text-align: center;
    margin-bottom: 48px;
    padding: 0 20px;
    position: relative;
  }
  .parallax-section-heading::after {
    content: '';
    display: block;
    width: 60px;
    height: 3px;
    background: #389a29;
    margin: 16px auto 0;
    border-radius: 2px;
  }
  .parallax-section-heading .label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #389a29;
    display: block;
    margin-bottom: 8px;
  }
  .parallax-section-heading h2 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(36px, 6vw, 72px);
    color: #132d82;
    line-height: 1.05;
    letter-spacing: 0.01em;
    max-width: 700px;
    margin: 0 auto;
  }
  /* Dark section heading variant */
  .parallax-section-heading--dark h2 { color: #fff; }
  .parallax-section-heading--dark::after { background: #F5A623; }
  .parallax-section-heading--dark .label { color: #F5A623; }

  @media (prefers-reduced-motion: reduce) { .parallax-card { transition: none !important; } }
</style>

<Base title="Home">
  <Navbar />

  <!-- Hero Section -->
  <section class="hero relative min-h-screen overflow-hidden flex items-center">
    <div class="hero-video-wrapper absolute inset-0 z-0">
      <video autoplay muted loop playsinline class="w-full h-full object-cover opacity-30" poster="/assets/hero-poster.jpg">
        <source src="/assets/hero-bg-compressed.mp4" type="video/mp4"><source src="/assets/GLP Short Video.mp4" type="video/mp4">
      </video>
      <div class="absolute inset-0" style="background: linear-gradient(90deg, rgba(19,45,130,0.92) 0%, rgba(19,45,130,0.85) 30%, rgba(56,154,41,0.40) 55%, transparent 70%, transparent 100%);"></div>
    </div>

    <div class="relative z-10 max-w-[55%] px-4 md:px-12 py-20 md:py-32">
      <p class="text-gpla-green text-sm font-semibold uppercase tracking-widest mb-4">Est. Makerere University, Kampala</p>
      <h1 class="font-display text-white text-[48px] md:text-[72px] lg:text-[96px] leading-[0.95] mb-6">
        SHAPING<br />
        EAST AFRICA'S<br />
        NEXT LEADERS.
      </h1>
      <p class="text-white/85 text-lg max-w-[500px] mb-8 leading-relaxed">
        Equipping outgoing Guild Presidents with the knowledge, values, and networks to transform governance across East Africa.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/programs" class="bg-gpla-green text-white px-6 md:px-8 py-3 md:py-4 rounded-full font-semibold inline-block hover:shadow-xl hover:-translate-y-0.5 transition-all">
          Our Programs
        </a>
        <a href="/summit" class="border-2 border-white text-white px-6 md:px-8 py-3 md:py-4 rounded-full font-semibold inline-block hover:bg-white hover:text-gpla-navy transition-all">
          View Summit
        </a>
      </div>
    </div>
  </section>

  <!-- SUMMIT 2026 COUNTDOWN BANNER -->
  <section class="summit-2026-banner px-4 md:px-12 py-12 md:py-20" data-animate>
    <div class="max-w-6xl mx-auto relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-16 items-center">
        <div>
          <span class="bg-gpla-gold text-gpla-navy text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full inline-block mb-4">SUMMIT 2026 · 23–24 JULY</span>
          <h2 class="font-display text-white text-[32px] md:text-[48px] lg:text-[56px] leading-[1] mb-4">
            3RD ANNUAL EAST AFRICAN<br />
            <span class="text-gpla-gold">GUILD LEADERS' SUMMIT</span>
          </h2>
          <p class="text-white/70 text-base md:text-lg leading-relaxed mb-6 max-w-xl">
            <em>"Youth Leadership, Production, and Regional Integration: Building a Competitive East Africa in a Changing Global Order"</em>
          </p>
          <div class="summit-hero-countdown mb-6">
            <div class="cd-item"><span class="cd-num" id="hp-days">00</span><span class="cd-label">Days</span></div>
            <div class="cd-item"><span class="cd-num" id="hp-hours">00</span><span class="cd-label">Hours</span></div>
            <div class="cd-item"><span class="cd-num" id="hp-mins">00</span><span class="cd-label">Minutes</span></div>
            <div class="cd-item"><span class="cd-num" id="hp-secs">00</span><span class="cd-label">Seconds</span></div>
          </div>
          <p class="text-white/50 text-xs mb-4 font-mono">Chief Guest: H.E. Yoweri Kaguta Museveni · Freedom Square, Makerere University</p>
          <div class="flex flex-wrap gap-3">
            <a href="https://lu.ma/5tuheo2m" target="_blank" rel="noopener noreferrer" class="bg-gpla-gold text-gpla-navy px-6 md:px-8 py-3 md:py-4 rounded-full font-bold text-sm md:text-base inline-block hover:shadow-xl hover:-translate-y-0.5 transition-all">
              Apply to Join →
            </a>
            <a href="/summit/2026#partner" class="border-2 border-white/40 text-white px-6 md:px-8 py-3 md:py-4 rounded-full font-semibold text-sm inline-block hover:bg-white hover:text-gpla-navy transition-all">
              Partner With Us
            </a>
          </div>
        </div>
        <div class="hidden lg:flex flex-col items-center justify-center">
          <div class="font-display text-[160px] text-gpla-gold/10 leading-none">2026</div>
          <p class="text-white/40 text-sm -mt-4">#TheGuildLeadersSummit2026</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Strip -->
  <section class="bg-gpla-green px-4 md:px-12 py-10 md:py-16" data-animate>
    <div class="max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8 text-center">
      <div>
        <div class="font-display text-[32px] md:text-[64px] text-white"><span data-count="700" data-suffix="+" class="stat-number">0+</span></div>
        <div class="text-white/85 text-xs md:text-sm">Former Leaders Convened</div>
      </div>
      <div>
        <div class="font-display text-[32px] md:text-[64px] text-white"><span data-count="4" class="stat-number">0</span></div>
        <div class="text-white/85 text-xs md:text-sm">Flagship Programs</div>
      </div>
      <div>
        <div class="font-display text-[32px] md:text-[64px] text-white"><span data-count="6" class="stat-number">0</span></div>
        <div class="text-white/85 text-xs md:text-sm">Countries Represented</div>
      </div>
      <div>
        <div class="font-display text-[32px] md:text-[64px] text-white"><span data-count="1" class="stat-number">0</span></div>
        <div class="text-white/85 text-xs md:text-sm">Regional Summit Annually</div>
      </div>
    </div>
  </section>

  <!-- About Preview -->
  <section class="px-4 md:px-12 py-16 md:py-24 bg-gpla-light" data-animate>
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 items-center">
      <div class="bg-gpla-navy p-8 md:p-12 relative" data-animate>
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gpla-green;"></div>
        <p class="text-white text-xl md:text-2xl italic leading-relaxed">"History has been made."</p>
        <cite class="block mt-6 text-gpla-gold text-base not-italic">— Demiano Masesa, Executive Director, GPLA</cite>
      </div>
      <div data-animate data-delay="100">
        <p class="text-gpla-green text-sm font-semibold uppercase tracking-widest mb-3">WHO WE ARE</p>
        <h2 class="font-display text-gpla-navy text-[32px] md:text-[48px] leading-tight mb-5">Forging Leaders for a Democratic East Africa</h2>
        <p class="text-gray-600 text-base leading-relaxed mb-6">
          The Guild Presidents Leadership Academy (GPLA) is a prestigious regional institution based at Makerere University, Uganda — the birthplace of African student activism.
        </p>
        <p class="text-gray-600 text-base leading-relaxed mb-6">
          We've convened over 700 youth leaders from 6 countries, hosting sitting Vice Presidents, former Heads of State, EU Ambassadors, and Electoral Commission Chairpersons.
        </p>
        <a href="/about" class="text-gpla-green font-semibold inline-flex items-center gap-2">
          Read Our Full Story →
        </a>
      </div>
    </div>
  </section>

  <!-- Pattern Divider -->
  <div class="h-10 w-full" style="background: linear-gradient(90deg, #389a29 0%, #389a29 16%, #132d82 16%, #132d82 32%, #F5A623 32%, #F5A623 48%, #ffffff 48%, #ffffff 64%, #389a29 64%, #389a29 80%, #132d82 80%, #132d82 100%);"></div>

  <!-- ===== n8n-STYLE SUMMITS SECTION ===== -->
  <section class="px-4 md:px-12 py-16 md:py-24 bg-gpla-light">
    <div class="max-w-7xl mx-auto">
      <div class="parallax-section-heading">
        <span class="label">Our Summits</span>
        <h2>THREE YEARS. ONE MOVEMENT.</h2>
      </div>
      <div class="parallax-card-grid">
        <!-- 2026 -->
        <div class="parallax-card sticky parallax-card--2026" style="top: 88px;">
          <div class="parallax-card-inner">
            <div class="parallax-content">
              <span class="tagline">Upcoming · 23–24 July 2026</span>
              <h2>3RD ANNUAL EAST AFRICAN GUILD LEADERS' SUMMIT</h2>
              <p class="desc"><em>"Youth Leadership, Production, and Regional Integration: Building a Competitive East Africa in a Changing Global Order"</em></p>
              <div class="meta-grid">
                <div><span class="meta-label">Chief Guest</span><span class="meta-value">H.E. Yoweri Kaguta Museveni</span><span class="meta-sub">President of Uganda & EAC Chairperson</span></div>
                <div><span class="meta-label">Venue</span><span class="meta-value">Freedom Square</span><span class="meta-sub">Makerere University, Kampala</span></div>
              </div>
              <div class="panel-actions">
                <a href="https://lu.ma/5tuheo2m" target="_blank" rel="noopener noreferrer" class="panel-cta">Apply to Join →</a>
                <a href="/summit/2026" class="panel-cta ghost">Learn More →</a>
              </div>
            </div>
            <div class="parallax-media">
              <div class="parallax-media-badge">
                <div class="badge-ring"></div>
                <div class="badge-ring"></div>
                <div class="badge-ring"></div>
                <span class="year-number">2026</span>
                <span class="program-icon">🎤</span>
              </div>
            </div>
          </div>
        </div>
        <!-- 2025 -->
        <div class="parallax-card sticky parallax-card--2025" style="top: 108px;">
          <div class="parallax-card-inner">
            <div class="parallax-content">
              <span class="tagline">2025 · Makerere University</span>
              <h2>2ND ANNUAL GUILD LEADERS' SUMMIT</h2>
              <p class="desc"><em>"Democratic Governance and People-to-People Integration"</em></p>
              <div class="meta-grid">
                <div><span class="meta-label">Chief Guest</span><span class="meta-value">HE. Uhuru Kenyatta</span><span class="meta-sub">Former President, Republic of Kenya</span></div>
                <div><span class="meta-label">Attendees</span><span class="meta-value">700+</span><span class="meta-sub">Leaders from 6 countries</span></div>
              </div>
              <div class="panel-actions">
                <a href="/summit/2025" class="panel-cta">View Full Report →</a>
              </div>
            </div>
            <div class="parallax-media">
              <div class="parallax-media-badge">
                <div class="badge-ring"></div>
                <div class="badge-ring"></div>
                <div class="badge-ring"></div>
                <span class="year-number">2025</span>
                <span class="program-icon">🎤</span>
              </div>
            </div>
          </div>
        </div>
        <!-- 2024 -->
        <div class="parallax-card sticky parallax-card--2024" style="top: 128px;">
          <div class="parallax-card-inner">
            <div class="parallax-content">
              <span class="tagline">April 15, 2024 · Makerere University</span>
              <h2>INAUGURAL GUILD LEADERS' SUMMIT</h2>
              <p class="desc"><em>"Legacy and Leadership Continuum: The Power of Knowledge and Cross-Generational Learning"</em></p>
              <div class="meta-grid">
                <div><span class="meta-label">Chief Guest</span><span class="meta-value">HE. Jakaya Mrisho Kikwete</span><span class="meta-sub">Former President, Tanzania · Summit Patron</span></div>
                <div><span class="meta-label">Attendees</span><span class="meta-value">700+</span><span class="meta-sub">Historic first convening</span></div>
              </div>
              <div class="panel-actions">
                <a href="/summit/2024" class="panel-cta">View Full Report →</a>
              </div>
            </div>
            <div class="parallax-media">
              <div class="parallax-media-badge">
                <div class="badge-ring"></div>
                <div class="badge-ring"></div>
                <div class="badge-ring"></div>
                <span class="year-number">2024</span>
                <span class="program-icon">🎤</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
