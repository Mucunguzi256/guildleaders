---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<style is:global>
  /* ===== HERO ===== */
  .hero-home {
    min-height: 90vh;
    background: linear-gradient(135deg, rgba(10,22,40,0.85) 0%, rgba(19,45,130,0.7) 40%, rgba(26,61,92,0.5) 100%);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .hero-home::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events: none;
  }
  .hero-home::after {
    content: '';
    position: absolute;
    top: -30%; right: -10%;
    width: 800px; height: 800px;
    background: radial-gradient(circle, rgba(56,154,41,0.08) 0%, transparent 60%);
    pointer-events: none;
  }
  .hero-home .hero-gradient-mask {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(10,22,40,0.92) 0%, rgba(19,45,130,0.6) 40%, transparent 70%);
    z-index: 1;
  }

  /* ===== SUMMIT 2026 COUNTDOWN ===== */
  .summit-2026-banner {
    background: linear-gradient(135deg, #0a1628 0%, #132d82 50%, #0a1628 100%);
    position: relative;
    overflow: hidden;
  }
  .summit-2026-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 70% 50%, rgba(245,166,35,0.06) 0%, transparent 60%);
    pointer-events: none;
  }
  .summit-hero-countdown {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    max-width: 440px;
  }
  .summit-hero-countdown .cd-item {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 14px 6px;
    text-align: center;
    backdrop-filter: blur(6px);
  }
  .summit-hero-countdown .cd-num {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    line-height: 1;
    display: block;
    color: var(--gpla-gold, #F5A623);
  }
  .summit-hero-countdown .cd-label {
    font-family: 'Oswald', sans-serif;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    opacity: 0.5;
    display: block;
    margin-top: 4px;
    color: #fff;
  }
  @media (max-width: 400px) {
    .summit-hero-countdown { grid-template-columns: repeat(2, 1fr); max-width: 220px; }
  }

  /* ===== STATS STRIP ===== */
  .stats-strip {
    background: linear-gradient(135deg, #389a29 0%, #2d7a20 100%);
    position: relative;
    overflow: hidden;
  }
  .stats-strip::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.05) 0%, transparent 50%);
  }
  .stat-number {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    color: white;
    font-weight: 700;
  }

  /* ===== PARALLAX SUMMIT CARDS ===== */
  .parallax-card {
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
    transition: transform 0.6s var(--transition-smooth, cubic-bezier(0.16, 1, 0.3, 1));
  }
  .parallax-card.sticky {
    position: sticky;
    top: 100px;
    min-height: 560px;
  }
  @media (min-width: 1024px) {
    .parallax-card.sticky { min-height: 600px; }
  }
  .parallax-card--2026 { background: linear-gradient(135deg, #0a1628 0%, #132d82 50%, #1a3d5c 100%); }
  .parallax-card--2025 { background: linear-gradient(135deg, #0d2818 0%, #1a4d2e 50%, #2d6b3f 100%); }
  .parallax-card--2024 { background: linear-gradient(135deg, #2d1f0d 0%, #5c3d12 50%, #8b5a2b 100%); }

  .parallax-card-grid { display: flex; flex-direction: column; gap: 24px; }
  .parallax-card-inner { display: flex; flex-direction: column; }
  @media (min-width: 1024px) {
    .parallax-card-inner { flex-direction: row; align-items: center; min-height: 600px; }
  }

  .parallax-media { position: relative; display: flex; align-items: center; justify-content: center; order: -1; }
  @media (min-width: 1024px) { .parallax-media { width: 42%; order: 2; padding: 24px 40px 24px 0; } }

  .parallax-media-badge {
    position: relative;
    width: 100%;
    max-width: 300px;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
  }
  .parallax-media-badge .year-number {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(80px, 10vw, 130px);
    line-height: 1;
    color: rgba(255,255,255,0.06);
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    font-weight: 700;
  }
  .parallax-media-badge .program-icon {
    font-size: clamp(48px, 6vw, 72px);
    line-height: 1;
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 8px 24px rgba(0,0,0,0.2));
  }
  .parallax-media-badge .badge-ring {
    position: absolute;
    inset: 0;
    border: 2px solid rgba(255,255,255,0.06);
    border-radius: 50%;
  }
  .parallax-media-badge .badge-ring:nth-child(2) { transform: scale(0.75); }
  .parallax-media-badge .badge-ring:nth-child(3) { transform: scale(0.5); border-color: rgba(245,166,35,0.12); }

  .parallax-content { padding: 32px; display: flex; flex-direction: column; justify-content: center; flex: 1; }
  .parallax-content .tagline {
    font-family: 'Oswald', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gpla-gold, #F5A623);
    display: inline-block;
    margin-bottom: 12px;
  }
  .parallax-content h2 {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.1;
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin-bottom: 12px;
  }
  .parallax-content .desc {
    font-family: 'Book Antiqua', 'Georgia', serif;
    color: rgba(255,255,255,0.75);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 20px;
  }
  .parallax-content .meta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 20px;
  }
  .parallax-content .meta-label {
    font-family: 'Oswald', sans-serif;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.35);
    display: block;
    margin-bottom: 2px;
  }
  .parallax-content .meta-value {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    color: white;
    display: block;
  }
  .parallax-content .meta-sub {
    font-size: 13px;
    color: rgba(255,255,255,0.5);
    display: block;
  }
  .parallax-content .panel-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .parallax-content .panel-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    border-radius: 999px;
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16,1,0.3,1);
    background: var(--gpla-gold, #F5A623);
    color: #132d82;
  }
  .parallax-content .panel-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.3); }
  .parallax-content .panel-cta.ghost { background: rgba(255,255,255,0.05); border: 2px solid rgba(255,255,255,0.3); color: #fff; }
  .parallax-content .panel-cta.ghost:hover { background: rgba(255,255,255,0.12); border-color: #fff; }

  @media (max-width: 1023px) {
    .parallax-content .meta-grid { grid-template-columns: 1fr; }
    .parallax-content .panel-actions { flex-direction: column; }
    .parallax-content .panel-cta { width: 100%; text-align: center; }
    .parallax-card.sticky { position: relative; top: auto !important; min-height: auto; margin-bottom: 24px; }
    .parallax-card-inner { min-height: auto; }
    .parallax-card {
      transform: translateY(32px);
      opacity: 0;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .parallax-card.mobile-visible { transform: translateY(0); opacity: 1; }
    .parallax-media { padding: 28px 28px 0; }
    .parallax-media-badge { max-width: 160px; }
    .parallax-media-badge .year-number { font-size: 56px; }
    .parallax-media-badge .program-icon { font-size: 40px; }
  }

  /* ===== PATTERN DIVIDER ===== */
  .pattern-divider {
    height: 12px;
    width: 100%;
    background: linear-gradient(90deg, 
      var(--gpla-green, #389a29) 0%, var(--gpla-green, #389a29) 16%, 
      var(--gpla-navy, #132d82) 16%, var(--gpla-navy, #132d82) 32%, 
      var(--gpla-gold, #F5A623) 32%, var(--gpla-gold, #F5A623) 48%, 
      #ffffff 48%, #ffffff 64%, 
      var(--gpla-green, #389a29) 64%, var(--gpla-green, #389a29) 80%, 
      var(--gpla-navy, #132d82) 80%, var(--gpla-navy, #132d82) 100%
    );
  }
  @media (min-width: 768px) {
    .pattern-divider { height: 16px; }
  }

  /* ===== LUMA EMBED ===== */
  .luma-embed-section {
    background: linear-gradient(180deg, #132d82 0%, #0a1628 100%);
    position: relative;
    overflow: hidden;
  }
  .luma-embed-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 30% 50%, rgba(56,154,41,0.06) 0%, transparent 50%);
    pointer-events: none;
  }

  /* ===== PARTNER LOGOS ===== */
  .partner-logo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  @media (min-width: 640px) {
    .partner-logo-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 1024px) {
    .partner-logo-grid { grid-template-columns: repeat(5, 1fr); }
  }
  .partner-logo-item {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 80px;
    transition: all 0.3s ease;
  }
  .partner-logo-item:hover {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.12);
  }
  .partner-logo-placeholder {
    font-family: 'Oswald', sans-serif;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.25);
    text-align: center;
  }
</style>

<Base title="Home" description="Guild Presidents Leadership Academy - Nurturing ethical, visionary and transformational leaders across East Africa.">
  <Navbar />

  <!-- ===== HERO ===== -->
  <section class="hero-home">
    <!-- Hero Video Background -->
    <div class="absolute inset-0 z-0 overflow-hidden">
      <video autoplay muted loop playsinline class="w-full h-full object-cover opacity-25" poster="/assets/hero-poster.jpg">
        <source src="/assets/hero-bg-compressed.mp4" type="video/mp4">
        <source src="/assets/GLP Short Video.mp4" type="video/mp4">
      </video>
    </div>
    <div class="hero-gradient-mask"></div>
    <div class="relative z-10 w-full">
      <div class="section-container py-20 md:py-32">
        <div class="max-w-4xl">
          <p class="section-label section-label--gold" data-animate>Guild Presidents Leadership Academy</p>
          <h1 class="font-display text-white text-[clamp(3rem,8vw,6rem)] leading-[0.95] mb-6" data-animate data-delay="100">
            NURTURING ETHICAL,<br />
            <span class="text-gpla-gold">VISIONARY</span><br />
            LEADERS
          </h1>
          <p class="text-white/75 text-lg md:text-xl max-w-[600px] leading-relaxed mb-10 font-body" data-animate data-delay="200" style="text-align: justify;">
            Empowering ethical youth leaders for democratic transformation in East Africa through leadership training, mentorship, policy dialogue and regional summits.
          </p>
          <div class="flex flex-wrap gap-4" data-animate data-delay="300">
            <a href="/programs" class="btn btn-primary btn-lg">
              Our Programs
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <a href="/summit" class="btn btn-outline btn-lg">
              View Summit
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== SUMMIT 2026 COUNTDOWN BANNER ===== -->
  <section class="summit-2026-banner section-padding" data-animate>
    <div class="section-container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <span class="badge badge-gold mb-4 inline-block">SUMMIT 2026 · 23–24 JULY</span>
          <h2 class="font-display text-white text-[clamp(2rem,4vw,3.5rem)] leading-[1] mb-4">
            3RD ANNUAL EAST AFRICAN<br />
            <span class="text-gpla-gold">GUILD LEADERS' SUMMIT</span>
          </h2>
          <p class="text-white/70 text-base md:text-lg leading-relaxed mb-6 max-w-xl font-body" style="text-align: justify;">
            <em>"Youth Leadership, Production, and Regional Integration: Building a Competitive East Africa in a Changing Global Order"</em>
          </p>
          <div class="summit-hero-countdown mb-6">
            <div class="cd-item"><span class="cd-num" id="hp-days">00</span><span class="cd-label">Days</span></div>
            <div class="cd-item"><span class="cd-num" id="hp-hours">00</span><span class="cd-label">Hours</span></div>
            <div class="cd-item"><span class="cd-num" id="hp-mins">00</span><span class="cd-label">Minutes</span></div>
            <div class="cd-item"><span class="cd-num" id="hp-secs">00</span><span class="cd-label">Seconds</span></div>
          </div>
          <p class="text-white/40 text-xs md:text-sm mb-5 font-body">Chief Guest: H.E. Yoweri Kaguta Museveni · Freedom Square, Makerere University</p>
          <div class="flex flex-wrap gap-3">
            <a href="https://luma.com/5tuheo2m" target="_blank" rel="noopener noreferrer" class="btn btn-gold">
              Register Now
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <a href="/summit/2026" class="btn btn-outline">Learn More</a>
          </div>
        </div>
        <div class="hidden lg:flex justify-center items-center">
          <div class="text-center relative">
            <div class="w-[280px] h-[300px] mx-auto relative">
              <div class="absolute inset-0 border-2 border-gpla-gold/40 rounded-xl transform rotate-3 translate-x-2 translate-y-2"></div>
              <div class="absolute inset-0 border-2 border-gpla-gold/40 rounded-xl transform -rotate-3 -translate-x-2 -translate-y-2"></div>
              <img src="/assets/chief-guest.webp" alt="H.E. Yoweri Kaguta Museveni" class="w-full h-full object-cover rounded-xl relative z-10 shadow-2xl" />
            </div>
            <div class="mt-4">
              <p class="font-display text-gpla-gold text-lg font-semibold tracking-wider">CHIEF GUEST</p>
              <p class="text-white/80 text-sm font-body">H.E. Yoweri Kaguta Museveni</p>
              <p class="text-white/40 text-xs font-body">President of Uganda &amp; EAC Chairperson</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== STATS STRIP ===== -->
  <section class="stats-strip section-padding" data-animate>
    <div class="section-container">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-10 text-center">
        <div>
          <div class="stat-number"><span data-count="1000" data-suffix="+" class="stat-counter">0+</span></div>
          <div class="text-white/85 text-sm md:text-base font-body uppercase tracking-wider">Former Leaders Convened</div>
        </div>
        <div>
          <div class="stat-number"><span data-count="8" class="stat-counter">0</span></div>
          <div class="text-white/85 text-sm md:text-base font-body uppercase tracking-wider">Countries Represented</div>
        </div>
        <div>
          <div class="stat-number"><span data-count="4" class="stat-counter">0</span></div>
          <div class="text-white/85 text-sm md:text-base font-body uppercase tracking-wider">Flagship Programs</div>
        </div>
        <div>
          <div class="stat-number"><span data-count="3" class="stat-counter">0</span></div>
          <div class="text-white/85 text-sm md:text-base font-body uppercase tracking-wider">Regional Summits Held</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ABOUT PREVIEW ===== -->
  <section class="section-padding section-alt" data-animate>
    <div class="section-container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20 items-center">
        <div class="bg-gpla-navy p-10 md:p-14 relative rounded-xl" data-animate>
          <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-gpla-green rounded-full"></div>
          <!-- CEO Quote Placeholder -->
          <div class="flex items-start gap-5 mb-8">
            <div class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-white/10 flex-shrink-0 flex items-center justify-center border border-white/10">
              <svg class="w-8 h-8 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            </div>
            <div>
              <p class="text-white text-xl md:text-2xl italic leading-relaxed font-body">"History has been made."</p>
              <cite class="block mt-4 text-gpla-gold text-base not-italic font-display tracking-wider">— Demiano Masesa, Executive Director, GPLA</cite>
              <p class="text-white/40 text-sm mt-1 font-body italic">[CEO photo &amp; quote to be updated]</p>
            </div>
          </div>
        </div>
        <div data-animate data-delay="100">
          <span class="section-label">About Us</span>
          <span class="accent-line"></span>
          <h2 class="section-title text-gpla-navy mb-6">Nurturing Ethical, Visionary Leaders</h2>
          <div class="content-text content-text--muted" style="text-align: justify;">
            <p>The Guild Presidents Leadership Academy (GPLA) is a non-partisan leadership development and regional convening platform committed to nurturing ethical, visionary and transformational leaders across East Africa.</p>
            <p>Through leadership training, mentorship, policy dialogue, regional summits, research, institutional partnerships and community-based initiatives, GPLA brings together young leaders, governments, universities, development partners, the private sector and experienced statespersons to address critical governance and development challenges.</p>
            <p>GPLA is headquartered in Uganda and works across East Africa to build bridges between generations, institutions and countries.</p>
          </div>
          <a href="/about" class="btn btn-primary mt-6">
            Learn More About Us
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PATTERN DIVIDER ===== -->
  <div class="pattern-divider"></div>

  <!-- ===== SUMMITS SECTION ===== -->
  <section class="section-padding section-navy">
    <div class="section-container">
      <div class="text-center mb-12" data-animate>
        <span class="section-label section-label--gold">Our Summits</span>
        <h2 class="section-title section-title--centered text-white">Three Years. One Movement.</h2>
      </div>
      <div class="parallax-card-grid">
        <!-- 2026 -->
        <div class="parallax-card sticky parallax-card--2026" style="top: 100px;" data-animate>
          <div class="parallax-card-inner">
            <div class="parallax-content">
              <span class="tagline">Upcoming · 23–24 July 2026</span>
              <h2>3RD ANNUAL EAST AFRICAN GUILD LEADERS' SUMMIT</h2>
              <p class="desc"><em>"Youth Leadership, Production, and Regional Integration: Building a Competitive East Africa in a Changing Global Order"</em></p>
              <div class="meta-grid">
                <div><span class="meta-label">Chief Guest</span><span class="meta-value">H.E. Yoweri Kaguta Museveni</span><span class="meta-sub">President of Uganda & EAC Chairperson</span></div>
                <div><span class="meta-label">Venue</span><span class="meta-value">Freedom Square</span><span class="meta-sub">Makerere University, Kampala</span></div>
              </div>
              <div class="panel-actions">
                <a href="https://luma.com/5tuheo2m" target="_blank" rel="noopener noreferrer" class="panel-cta">Register Now →</a>
                <a href="/summit/2026" class="panel-cta ghost">Learn More →</a>
              </div>
            </div>
            <div class="parallax-media">
              <div class="parallax-media-badge">
                <div class="badge-ring"></div>
                <div class="badge-ring"></div>
                <div class="badge-ring"></div>
                <span class="year-number">2026</span>
                <span class="program-icon">🎤</span>
              </div>
            </div>
          </div>
        </div>
        <!-- 2025 -->
        <div class="parallax-card sticky parallax-card--2025" style="top: 120px;" data-animate>
          <div class="parallax-card-inner">
