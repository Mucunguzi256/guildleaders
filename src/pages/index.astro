<script>
  // ===== STATS COUNTER WITH BOUNCE =====
  const animateStats = () => {
    const stats = document.querySelectorAll('.ani-counter');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !entry.target.dataset.animated) {
          entry.target.dataset.animated = 'true';
          const el = entry.target;
          const target = parseInt(el.dataset.target || '0', 10);
          const suffix = el.dataset.suffix || '';
          const duration = 1800;
          const startTime = performance.now();
          const easeOutQuart = (t) => 1 - Math.pow(1 - t, 4);
          const tick = (now) => {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const current = Math.floor(easeOutQuart(progress) * target);
            el.textContent = current + suffix;
            if (progress < 1) {
              requestAnimationFrame(tick);
            } else {
              el.classList.add('counter-done');
            }
          };
          requestAnimationFrame(tick);
        }
      });
    }, { threshold: 0.3 });
    stats.forEach(stat => observer.observe(stat));
  };
  animateStats();

  // ===== SCROLL ANIMATIONS =====
  const animateOnScroll = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const delay = parseInt(entry.target.dataset.delay) || 0;
        setTimeout(() => {
          entry.target.classList.add('animate-in');
        }, delay);
        animateOnScroll.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('[data-animate]').forEach(el => animateOnScroll.observe(el));

  // ===== MOBILE CARD SLIDE-IN =====
  if (window.innerWidth < 1024) {
    const cardObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const delay = parseInt(entry.target.dataset.delay) || 0;
          setTimeout(() => {
            entry.target.classList.add('mobile-visible');
          }, delay);
          cardObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.program-card').forEach((el, i) => {
      if (!el.dataset.delay) el.dataset.delay = String(i * 100);
      cardObserver.observe(el);
    });
  }

  // ===== SCROLL PARALLAX =====
  const parallaxEls = [];
  const heroVideo = document.querySelector('.hero-home video');
  if (heroVideo) parallaxEls.push({ el: heroVideo, factor: 0.2 });
  document.querySelectorAll('.gallery-item img').forEach(img => {
    parallaxEls.push({ el: img, factor: 0.1 });
  });
  if (parallaxEls.length) {
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          parallaxEls.forEach(({ el, factor }) => {
            const rect = el.getBoundingClientRect();
            const center = rect.top + rect.height / 2;
            const viewH = window.innerHeight;
            if (center > -rect.height && center < viewH + rect.height) {
              const offset = (center - viewH / 2) * factor;
              el.style.transform = `translateY(${offset}px)`;
            }
          });
          ticking = false;
        });
      }
    }, { passive: true });
  }

  // ===== CARD HOVER TILT =====
  const tiltCards = document.querySelectorAll('.summit-bento-card');
  tiltCards.forEach(card => {
    card.classList.add('tilt-card');
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const cx = rect.width / 2;
      const cy = rect.height / 2;
      const rotateX = ((y - cy) / cy) * -6;
      const rotateY = ((x - cx) / cx) * 6;
      card.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
      card.style.boxShadow = `${-rotateY * 2}px ${rotateX * 2}px 30px rgba(0,0,0,0.2)`;
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = '';
      card.style.boxShadow = '';
    });
  });

  // ===== CURSOR GLOW =====
  const heroSection = document.querySelector('.hero-home');
  const glowDot = document.getElementById('hero-glow-dot');
  if (heroSection && glowDot) {
    heroSection.addEventListener('mousemove', (e) => {
      const rect = heroSection.getBoundingClientRect();
      glowDot.style.left = (e.clientX - rect.left) + 'px';
      glowDot.style.top = (e.clientY - rect.top) + 'px';
    });
  }

  // ===== PROGRAM CARDS: STAGGERED ENTRANCE =====
  const entranceObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const card = entry.target;
        const delay = parseInt(card.dataset.cardDelay || '0', 10);
        setTimeout(() => card.classList.add('program-entered'), delay);
        entranceObserver.unobserve(card);
      }
    });
  }, { threshold: 0.15 });
  document.querySelectorAll('.program-card[data-entrance]').forEach(c => entranceObserver.observe(c));

  // ===== PROGRAM CARDS: NUMBER COUNTER =====
  const numObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !entry.target.dataset.counted) {
        entry.target.dataset.counted = 'true';
        const el = entry.target;
        const target = el.dataset.counterTarget || '00';
        const targetNum = parseInt(target, 10);
        const duration = 800;
        const start = performance.now();
        const tick = (now) => {
          const p = Math.min((now - start) / duration, 1);
          const cur = Math.round(p * targetNum);
          el.textContent = String(cur).padStart(2, '0');
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
        numObserver.unobserve(el);
      }
    });
  }, { threshold: 0.3 });
  document.querySelectorAll('.program-card__number[data-counter-target]').forEach(n => numObserver.observe(n));

  // ===== PROGRAM CARDS: CLICK PRESS =====
  document.querySelectorAll('.program-card').forEach(card => {
    card.addEventListener('mousedown', () => card.classList.add('card-pressed'));
    card.addEventListener('mouseup', () => {
      setTimeout(() => {
        card.classList.remove('card-pressed');
        const link = card.querySelector('.program-card__link');
        if (link) link.click();
      }, 120);
    });
    card.addEventListener('mouseleave', () => card.classList.remove('card-pressed'));
  });
</script>
