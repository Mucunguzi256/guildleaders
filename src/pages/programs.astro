---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Programs" description="Our flagship programs that shape East Africa's next democratic leaders.">
  <Navbar />
  
  <!-- Hero -->
  <section class="min-h-[50vh] md:min-h-[60vh] bg-gpla-navy px-4 md:px-12 pt-28 md:pt-32 pb-16 md:pb-24 relative overflow-hidden">
    <div class="absolute bottom-0 right-0 w-[45%] h-full bg-gpla-green" style="clip-path: polygon(20% 0, 100% 0, 100% 100%, 0% 100%);"></div>
    <div class="max-w-6xl mx-auto relative z-10">
      <p class="text-gpla-green text-sm font-semibold uppercase tracking-widest mb-4">PROGRAMS</p>
      <h1 class="font-display text-white text-[36px] md:text-[56px] md:text-[72px] leading-tight">
        Develop, Connect<br />
        & Inspire
      </h1>
    </div>
  </section>

  <!-- Hero Strip -->
  <section class="bg-gpla-light px-4 md:px-12 py-8 md:py-12">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="font-display text-3xl md:text-4xl text-gpla-navy mb-3">OUR FLAGSHIP PROGRAMS</h2>
      <p class="text-gpla-navy/70 text-lg mb-4">Six pathways. One vision: transforming East Africa.</p>
      <div class="flex flex-wrap justify-center gap-4 text-sm text-gpla-navy/60">
        <span>🔥 5-Day Bootcamp</span>
        <span class="hidden md:inline">·</span>
        <span>⚖️ 8-Week Policy Lab</span>
        <span class="hidden md:inline">·</span>
        <span>🔬 Innovation Lab</span>
        <span class="hidden md:inline">·</span>
        <span>⭐ Women's Fellowship</span>
        <span class="hidden md:inline">·</span>
        <span>🏛️ Master Classes</span>
        <span class="hidden md:inline">·</span>
        <span>🎤 Annual Summit</span>
      </div>
    </div>
  </section>

  <!-- Programs Grid — CrewAI-style automation cards -->
  <section class="px-4 md:px-12 py-12 md:py-24">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        <!-- TLB -->
        <div class="program-card group p-8 md:p-10 rounded-xl hover:-translate-y-1.5 hover:shadow-2xl transition-all cursor-pointer fade-in-up stagger-1" data-animate style="background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 50%, #132d82 100%); border-left: 4px solid #389a29;">
          <div class="w-12 md:w-14 h-12 md:h-14 bg-white/15 rounded-lg flex items-center justify-center text-2xl md:text-3xl mb-4 md:mb-5">🔥</div>
          <div class="flex items-center gap-3 mb-2">
            <h3 class="font-display text-[24px] md:text-[28px] text-white">Transformational Leadership Bootcamp</h3>
            <span class="text-xs font-bold bg-gpla-gold text-gpla-navy px-2 py-1 rounded">TLB</span>
          </div>
          <p class="text-white/85 text-base leading-relaxed mb-4">The programme provides newly elected and serving student leaders with practical training in ethical leadership, financial accountability, negotiation, communication, conflict resolution, policy engagement and responsible representation.</p>
          <p class="text-white/70 text-sm leading-relaxed mb-4">It also supports leadership transition, institutional continuity and mentorship by connecting current guild leaders with former guild presidents, public officials, professionals and experienced national leaders. The programme recognises university leadership as an important training ground for future leaders in government, business, civil society and public institutions.</p>
          <div class="flex flex-wrap gap-2 mb-5">
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">5 Days</span>
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Residential</span>
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Intensive</span>
          </div>
          <div class="border-t border-white/20 pt-4 mt-4">
            <p class="text-xs text-white/50 uppercase tracking-wider mb-2 group-hover:text-gpla-gold transition-colors">Strategic Objectives</p>
            <ul class="space-y-1">
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Equip guild leaders with practical leadership and governance skills</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Promote integrity, accountability and responsible student representation</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Strengthen cooperation between student leaders and university administrations</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Improve leadership transition and institutional continuity within guild governments</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Connect current guild leaders with mentors and leadership alumni</li>
            </ul>
          </div>
          <a href="https://lu.ma/5tuheo2m" target="_blank" rel="noopener noreferrer" class="mt-6 inline-block bg-gpla-gold text-gpla-navy px-6 py-3 rounded-full font-semibold text-sm hover:shadow-xl hover:-translate-y-0.5 transition-all">Apply for TLB →</a>
        </div>

        <!-- PGIL -->
        <div class="program-card group p-8 md:p-10 rounded-xl hover:-translate-y-1.5 hover:shadow-2xl transition-all cursor-pointer fade-in-up stagger-2" data-animate data-delay="100" style="background: linear-gradient(135deg, #14532d 0%, #15803d 50%, #22c55e 100%); border-left: 4px solid #132d82;">
          <div class="w-12 md:w-14 h-12 md:h-14 bg-white/15 rounded-lg flex items-center justify-center text-2xl md:text-3xl mb-4 md:mb-5">⚖️</div>
          <div class="flex items-center gap-3 mb-2">
            <h3 class="font-display text-[24px] md:text-[28px] text-white">Policy & Governance Incubation Lab</h3>
            <span class="text-xs font-bold bg-gpla-gold text-gpla-navy px-2 py-1 rounded">PGIL</span>
          </div>
          <p class="text-white/85 text-base leading-relaxed mb-4">8-week intensive program building practical policy analysis and advocacy skills for East Africa.</p>
          <div class="flex flex-wrap gap-2 mb-5">
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">8 Weeks</span>
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Hybrid</span>
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Research-Focused</span>
          </div>
          <div class="border-t border-white/20 pt-4 mt-4">
            <p class="text-xs text-white/50 uppercase tracking-wider mb-2 group-hover:text-gpla-gold transition-colors">Key Outcomes</p>
            <ul class="space-y-1">
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Public policy analysis and budgeting competency</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Real-time review of national development plans</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Policy briefs and campus-based governance initiatives</li>
            </ul>
          </div>
          <a href="https://lu.ma/5tuheo2m" target="_blank" rel="noopener noreferrer" class="mt-6 inline-block bg-gpla-gold text-gpla-navy px-6 py-3 rounded-full font-semibold text-sm hover:shadow-xl hover:-translate-y-0.5 transition-all">Apply for PGIL →</a>
        </div>

        <!-- HERPower -->
        <div class="program-card group p-8 md:p-10 rounded-xl hover:-translate-y-1.5 hover:shadow-2xl transition-all cursor-pointer fade-in-up stagger-3" data-animate data-delay="200" style="background: linear-gradient(135deg, #4a1d4e 0%, #7c3aed 50%, #a855f7 100%); border-left: 4px solid #F5A623;">
          <div class="w-12 md:w-14 h-12 md:h-14 bg-white/15 rounded-lg flex items-center justify-center text-2xl md:text-3xl mb-4 md:mb-5">⭐</div>
          <div class="flex items-center gap-3 mb-2">
            <h3 class="font-display text-[24px] md:text-[28px] text-white">HERPower Fellowship</h3>
            <span class="text-xs font-bold bg-gpla-gold text-gpla-navy px-2 py-1 rounded">HERPower</span>
          </div>
          <p class="text-white/85 text-base leading-relaxed mb-4">Specialized fellowship for young women passionate about political leadership.</p>
          <div class="flex flex-wrap gap-2 mb-5">
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Ongoing</span>
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Mentorship</span>
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Women Only</span>
          </div>
          <div class="border-t border-white/20 pt-4 mt-4">
            <p class="text-xs text-white/50 uppercase tracking-wider mb-2 group-hover:text-gpla-gold transition-colors">Key Outcomes</p>
            <ul class="space-y-1">
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Feminist leadership and political organizing skills</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Mentorship from women leaders in public office</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Network of women committed to democratic leadership</li>
            </ul>
          </div>
          <a href="https://lu.ma/5tuheo2m" target="_blank" rel="noopener noreferrer" class="mt-6 inline-block bg-gpla-gold text-gpla-navy px-6 py-3 rounded-full font-semibold text-sm hover:shadow-xl hover:-translate-y-0.5 transition-all">Apply for HERPower →</a>
        </div>

        <!-- Innovation & Production Lab -->
        <div class="program-card group p-8 md:p-10 rounded-xl hover:-translate-y-1.5 hover:shadow-2xl transition-all cursor-pointer fade-in-up stagger-4" data-animate data-delay="300" style="background: linear-gradient(135deg, #1a3d2e 0%, #2d6b3f 50%, #389a29 100%); border-left: 4px solid #F5A623;">
          <div class="w-12 md:w-14 h-12 md:h-14 bg-white/15 rounded-lg flex items-center justify-center text-2xl md:text-3xl mb-4 md:mb-5">🔬</div>
          <div class="flex items-center gap-3 mb-2">
            <h3 class="font-display text-[24px] md:text-[28px] text-white">Innovation & Production Lab</h3>
            <span class="text-xs font-bold bg-gpla-gold text-gpla-navy px-2 py-1 rounded">IPL</span>
          </div>
          <p class="text-white/85 text-base leading-relaxed mb-4">A platform for incubation, research commercialisation, industrial production, skills development, technology transfer and investment in sectors critical to Uganda's development.</p>
          <div class="flex flex-wrap gap-2 mb-5">
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Incubation</span>
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Commercialisation</span>
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Investment</span>
          </div>
          <div class="border-t border-white/20 pt-4 mt-4">
            <p class="text-xs text-white/50 uppercase tracking-wider mb-2 group-hover:text-gpla-gold transition-colors">Strategic Objectives</p>
            <ul class="space-y-1">
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Promote youth-led innovation, entrepreneurship and production</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Commercialise research and innovations developed by universities and young people</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Connect innovators with investors, industries, markets and government support</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Strengthen collaboration among universities, research institutions and the private sector</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Support the growth of technology-based enterprises and productive industries</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Contribute to employment creation, industrialisation and import substitution</li>
            </ul>
          </div>
          <div class="border-t border-white/20 pt-4 mt-4">
            <p class="text-xs text-white/50 uppercase tracking-wider mb-2 group-hover:text-gpla-gold transition-colors">Priority Areas</p>
            <div class="flex flex-wrap gap-1.5">
              <span class="text-xs bg-white/10 text-white/90 px-2 py-1 rounded">Agricultural technology & agro-processing</span>
              <span class="text-xs bg-white/10 text-white/90 px-2 py-1 rounded">AI & digital innovation</span>
              <span class="text-xs bg-white/10 text-white/90 px-2 py-1 rounded">Health & biotechnology</span>
              <span class="text-xs bg-white/10 text-white/90 px-2 py-1 rounded">Renewable energy & climate tech</span>
              <span class="text-xs bg-white/10 text-white/90 px-2 py-1 rounded">Engineering & advanced manufacturing</span>
              <span class="text-xs bg-white/10 text-white/90 px-2 py-1 rounded">Minerals, oil & gas technologies</span>
              <span class="text-xs bg-white/10 text-white/90 px-2 py-1 rounded">Creative & knowledge-based industries</span>
            </div>
          </div>
          <a href="https://lu.ma/5tuheo2m" target="_blank" rel="noopener noreferrer" class="mt-6 inline-block bg-gpla-gold text-gpla-navy px-6 py-3 rounded-full font-semibold text-sm hover:shadow-xl hover:-translate-y-0.5 transition-all">Apply for IPL →</a>
        </div>

        <!-- Master Classes -->
        <div class="program-card group p-8 md:p-10 rounded-xl hover:-translate-y-1.5 hover:shadow-2xl transition-all cursor-pointer fade-in-up stagger-5" data-animate data-delay="400" style="background: linear-gradient(135deg, #2d1f0d 0%, #5c3d12 50%, #a67c00 100%); border-left: 4px solid #389a29;">
          <div class="w-12 md:w-14 h-12 md:h-14 bg-white/15 rounded-lg flex items-center justify-center text-2xl md:text-3xl mb-4 md:mb-5">🏛️</div>
          <div class="flex items-center gap-3 mb-2">
            <h3 class="font-display text-[24px] md:text-[28px] text-white">Leadership Master Classes</h3>
            <span class="text-xs font-bold bg-gpla-gold text-gpla-navy px-2 py-1 rounded">LMC</span>
          </div>
          <p class="text-white/85 text-base leading-relaxed mb-4">A platform where civil servants, diplomats, academics, business leaders and governance practitioners share practical knowledge, leadership experience and institutional lessons.</p>
          <p class="text-white/70 text-sm leading-relaxed mb-4">The Master Classes focus on the real challenges of leadership, including managing public trust, making difficult decisions, leading during crises, strengthening institutions and delivering results in complex environments.</p>
          <div class="flex flex-wrap gap-2 mb-5">
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Master Classes</span>
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Mentorship</span>
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Governance</span>
          </div>
          <div class="border-t border-white/20 pt-4 mt-4">
            <p class="text-xs text-white/50 uppercase tracking-wider mb-2 group-hover:text-gpla-gold transition-colors">Strategic Objectives</p>
            <ul class="space-y-1">
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Strengthen ethical and values-based leadership</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Improve the leadership capacity of public and institutional leaders</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Promote effective governance, public administration and statecraft</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Equip leaders to manage crises, change and institutional reputation</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Facilitate mentorship between experienced and emerging leaders</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Build a network of responsible leaders committed to public service</li>
            </ul>
          </div>
          <div class="border-t border-white/20 pt-4 mt-4">
            <p class="text-xs text-white/50 uppercase tracking-wider mb-2 group-hover:text-gpla-gold transition-colors">Core Learning Areas</p>
            <div class="flex flex-wrap gap-1.5">
              <span class="text-xs bg-white/10 text-white/90 px-2 py-1 rounded">Ethical leadership & values-based decision-making</span>
              <span class="text-xs bg-white/10 text-white/90 px-2 py-1 rounded">Leadership in public service</span>
              <span class="text-xs bg-white/10 text-white/90 px-2 py-1 rounded">Governance, public administration & statecraft</span>
              <span class="text-xs bg-white/10 text-white/90 px-2 py-1 rounded">Managing public trust & institutional reputation</span>
            </div>
          </div>
          <a href="https://lu.ma/5tuheo2m" target="_blank" rel="noopener noreferrer" class="mt-6 inline-block bg-gpla-gold text-gpla-navy px-6 py-3 rounded-full font-semibold text-sm hover:shadow-xl hover:-translate-y-0.5 transition-all">Apply for Master Classes →</a>
        </div>

        <!-- Summit -->
        <div class="program-card group p-8 md:p-10 rounded-xl hover:-translate-y-1.5 hover:shadow-2xl transition-all cursor-pointer fade-in-up stagger-6" data-animate data-delay="500" style="background: linear-gradient(135deg, #064e3b 0%, #065f46 50%, #10b981 100%); border-left: 4px solid #F5A623;">
          <div class="w-12 md:w-14 h-12 md:h-14 bg-white/15 rounded-lg flex items-center justify-center text-2xl md:text-3xl mb-4 md:mb-5">🎤</div>
          <div class="flex items-center gap-3 mb-2">
            <h3 class="font-display text-[24px] md:text-[28px] text-white">Guild Leaders' Summit</h3>
            <span class="text-xs font-bold bg-gpla-gold text-gpla-navy px-2 py-1 rounded">Summit</span>
          </div>
          <p class="text-white/85 text-base leading-relaxed mb-4">Annual flagship gathering bringing together Guild Presidents from across East Africa.</p>
          <div class="flex flex-wrap gap-2 mb-5">
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Annual</span>
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">2 Days</span>
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">700+ Attendees</span>
          </div>
          <div class="border-t border-white/20 pt-4 mt-4">
            <p class="text-xs text-white/50 uppercase tracking-wider mb-2 group-hover:text-gpla-gold transition-colors">Key Outcomes</p>
            <ul class="space-y-1">
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Pan-East African student leader network</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Cross-border policy dialogue and advocacy</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Regional integration agenda co-creation</li>
            </ul>
          </div>
          <a href="https://lu.ma/5tuheo2m" target="_blank" rel="noopener noreferrer" class="mt-6 inline-block bg-gpla-gold text-gpla-navy px-6 py-3 rounded-full font-semibold text-sm hover:shadow-xl hover:-translate-y-0.5 transition-all">Register for Summit →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gpla-green px-4 md:px-12 py-12 md:py-20 text-center">
    <h2 class="font-display text-white text-[36px] md:text-[56px] mb-4">Ready to Lead?</h2>
    <p class="text-white/85 text-lg md:text-xl mb-6 md:mb-8">Apply for the next cohort and transform your leadership journey.</p>
    <a href="https://lu.ma/5tuheo2m" target="_blank" rel="noopener noreferrer" class="bg-white text-gpla-navy px-8 md:px-10 py-4 md:py-5 rounded-full font-semibold inline-block hover:shadow-xl hover:-translate-y-0.5 transition-all">
      Apply on Luma →
    </a>
  </section>

  <Footer />
</Base>
