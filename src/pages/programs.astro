---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Programs" description="Our flagship programs that shape East Africa's next democratic leaders.">
  <Navbar />
  
  <!-- Hero -->
  <section class="min-h-[50vh] md:min-h-[60vh] bg-gpla-navy px-4 md:px-12 pt-28 md:pt-32 pb-16 md:pb-24 relative overflow-hidden">
    <div class="absolute bottom-0 right-0 w-[45%] h-full bg-gpla-green" style="clip-path: polygon(20% 0, 100% 0, 100% 100%, 0% 100%);"></div>
    <div class="max-w-6xl mx-auto relative z-10">
      <p class="text-gpla-green text-sm font-semibold uppercase tracking-widest mb-4">PROGRAMS</p>
      <h1 class="font-display text-white text-[36px] md:text-[56px] md:text-[72px] leading-tight">
        Shape Your<br />
        Leadership Future
      </h1>
    </div>
  </section>

  <!-- Hero Strip -->
  <section class="bg-gpla-light px-4 md:px-12 py-8 md:py-12">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="font-display text-3xl md:text-4xl text-gpla-navy mb-3">OUR FLAGSHIP PROGRAMS</h2>
      <p class="text-gpla-navy/70 text-lg mb-4">Four pathways. One goal: democratic East Africa.</p>
      <div class="flex flex-wrap justify-center gap-4 text-sm text-gpla-navy/60">
        <span>🔥 5-Day Bootcamp</span>
        <span class="hidden md:inline">·</span>
        <span>⚖️ 8-Week Policy Lab</span>
        <span class="hidden md:inline">·</span>
        <span>⭐ Women's Fellowship</span>
        <span class="hidden md:inline">·</span>
        <span>🎤 Annual Summit</span>
      </div>
    </div>
  </section>

  <!-- Programs Grid — CrewAI-style automation cards -->
  <section class="px-4 md:px-12 py-12 md:py-24">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        <!-- TLB -->
        <div class="program-card group p-8 md:p-10 rounded-xl hover:-translate-y-1.5 hover:shadow-2xl transition-all cursor-pointer fade-in-up stagger-1" data-animate style="background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 50%, #132d82 100%); border-left: 4px solid #389a29;">
          <div class="w-12 md:w-14 h-12 md:h-14 bg-white/15 rounded-lg flex items-center justify-center text-2xl md:text-3xl mb-4 md:mb-5">🔥</div>
          <div class="flex items-center gap-3 mb-2">
            <h3 class="font-display text-[24px] md:text-[28px] text-white">Transformational Leadership Bootcamp</h3>
            <span class="text-xs font-bold bg-gpla-gold text-gpla-navy px-2 py-1 rounded">TLB</span>
          </div>
          <p class="text-white/85 text-base leading-relaxed mb-4">A rigorous 5-day residential program building essential leadership skills for effective student governance.</p>
          <div class="flex flex-wrap gap-2 mb-5">
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">5 Days</span>
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Residential</span>
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Intensive</span>
          </div>
          <div class="border-t border-white/20 pt-4 mt-4">
            <p class="text-xs text-white/50 uppercase tracking-wider mb-2 group-hover:text-gpla-gold transition-colors">Key Outcomes</p>
            <ul class="space-y-1">
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Personal leadership vision creation with actionable steps</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Conflict resolution and strategic planning skills</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Mentorship with public, private, and civil society leaders</li>
            </ul>
          </div>
          <a href="https://lu.ma/5tuheo2m" target="_blank" rel="noopener noreferrer" class="mt-6 inline-block bg-gpla-gold text-gpla-navy px-6 py-3 rounded-full font-semibold text-sm hover:shadow-xl hover:-translate-y-0.5 transition-all">Apply for TLB →</a>
        </div>

        <!-- PGIL -->
        <div class="program-card group p-8 md:p-10 rounded-xl hover:-translate-y-1.5 hover:shadow-2xl transition-all cursor-pointer fade-in-up stagger-2" data-animate data-delay="100" style="background: linear-gradient(135deg, #14532d 0%, #15803d 50%, #22c55e 100%); border-left: 4px solid #132d82;">
          <div class="w-12 md:w-14 h-12 md:h-14 bg-white/15 rounded-lg flex items-center justify-center text-2xl md:text-3xl mb-4 md:mb-5">⚖️</div>
          <div class="flex items-center gap-3 mb-2">
            <h3 class="font-display text-[24px] md:text-[28px] text-white">Policy & Governance Incubation Lab</h3>
            <span class="text-xs font-bold bg-gpla-gold text-gpla-navy px-2 py-1 rounded">PGIL</span>
          </div>
          <p class="text-white/85 text-base leading-relaxed mb-4">8-week intensive program building practical policy analysis and advocacy skills for East Africa.</p>
          <div class="flex flex-wrap gap-2 mb-5">
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">8 Weeks</span>
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Hybrid</span>
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Research-Focused</span>
          </div>
          <div class="border-t border-white/20 pt-4 mt-4">
            <p class="text-xs text-white/50 uppercase tracking-wider mb-2 group-hover:text-gpla-gold transition-colors">Key Outcomes</p>
            <ul class="space-y-1">
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Public policy analysis and budgeting competency</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Real-time review of national development plans</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Policy briefs and campus-based governance initiatives</li>
            </ul>
          </div>
          <a href="https://lu.ma/5tuheo2m" target="_blank" rel="noopener noreferrer" class="mt-6 inline-block bg-gpla-gold text-gpla-navy px-6 py-3 rounded-full font-semibold text-sm hover:shadow-xl hover:-translate-y-0.5 transition-all">Apply for PGIL →</a>
        </div>

        <!-- HERPower -->
        <div class="program-card group p-8 md:p-10 rounded-xl hover:-translate-y-1.5 hover:shadow-2xl transition-all cursor-pointer fade-in-up stagger-3" data-animate data-delay="200" style="background: linear-gradient(135deg, #4a1d4e 0%, #7c3aed 50%, #a855f7 100%); border-left: 4px solid #F5A623;">
          <div class="w-12 md:w-14 h-12 md:h-14 bg-white/15 rounded-lg flex items-center justify-center text-2xl md:text-3xl mb-4 md:mb-5">⭐</div>
          <div class="flex items-center gap-3 mb-2">
            <h3 class="font-display text-[24px] md:text-[28px] text-white">HERPower Fellowship</h3>
            <span class="text-xs font-bold bg-gpla-gold text-gpla-navy px-2 py-1 rounded">HERPower</span>
          </div>
          <p class="text-white/85 text-base leading-relaxed mb-4">Specialized fellowship for young women passionate about political leadership.</p>
          <div class="flex flex-wrap gap-2 mb-5">
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Ongoing</span>
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Mentorship</span>
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Women Only</span>
          </div>
          <div class="border-t border-white/20 pt-4 mt-4">
            <p class="text-xs text-white/50 uppercase tracking-wider mb-2 group-hover:text-gpla-gold transition-colors">Key Outcomes</p>
            <ul class="space-y-1">
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Feminist leadership and political organizing skills</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Mentorship from women leaders in public office</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Network of women committed to democratic leadership</li>
            </ul>
          </div>
          <a href="https://lu.ma/5tuheo2m" target="_blank" rel="noopener noreferrer" class="mt-6 inline-block bg-gpla-gold text-gpla-navy px-6 py-3 rounded-full font-semibold text-sm hover:shadow-xl hover:-translate-y-0.5 transition-all">Apply for HERPower →</a>
        </div>

        <!-- Summit -->
        <div class="program-card group p-8 md:p-10 rounded-xl hover:-translate-y-1.5 hover:shadow-2xl transition-all cursor-pointer fade-in-up stagger-4" data-animate data-delay="300" style="background: linear-gradient(135deg, #064e3b 0%, #065f46 50%, #10b981 100%); border-left: 4px solid #F5A623;">
          <div class="w-12 md:w-14 h-12 md:h-14 bg-white/15 rounded-lg flex items-center justify-center text-2xl md:text-3xl mb-4 md:mb-5">🎤</div>
          <div class="flex items-center gap-3 mb-2">
            <h3 class="font-display text-[24px] md:text-[28px] text-white">Guild Leaders' Summit</h3>
            <span class="text-xs font-bold bg-gpla-gold text-gpla-navy px-2 py-1 rounded">Summit</span>
          </div>
          <p class="text-white/85 text-base leading-relaxed mb-4">Annual flagship gathering bringing together Guild Presidents from across East Africa.</p>
          <div class="flex flex-wrap gap-2 mb-5">
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">Annual</span>
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">2 Days</span>
            <span class="text-xs bg-white/10 text-white/80 px-3 py-1 rounded-full">700+ Attendees</span>
          </div>
          <div class="border-t border-white/20 pt-4 mt-4">
            <p class="text-xs text-white/50 uppercase tracking-wider mb-2 group-hover:text-gpla-gold transition-colors">Key Outcomes</p>
            <ul class="space-y-1">
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Pan-East African student leader network</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Cross-border policy dialogue and advocacy</li>
              <li class="text-sm text-white/90 flex items-start gap-2"><span class="text-gpla-gold">✓</span> Regional integration agenda co-creation</li>
            </ul>
          </div>
          <a href="https://lu.ma/5tuheo2m" target="_blank" rel="noopener noreferrer" class="mt-6 inline-block bg-gpla-gold text-gpla-navy px-6 py-3 rounded-full font-semibold text-sm hover:shadow-xl hover:-translate-y-0.5 transition-all">Register for Summit →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gpla-green px-4 md:px-12 py-12 md:py-20 text-center">
    <h2 class="font-display text-white text-[36px] md:text-[56px] mb-4">Ready to Lead?</h2>
    <p class="text-white/85 text-lg md:text-xl mb-6 md:mb-8">Apply for the next cohort and transform your leadership journey.</p>
    <a href="https://lu.ma/5tuheo2m" target="_blank" rel="noopener noreferrer" class="bg-white text-gpla-navy px-8 md:px-10 py-4 md:py-5 rounded-full font-semibold inline-block hover:shadow-xl hover:-translate-y-0.5 transition-all">
      Apply on Luma →
    </a>
  </section>

  <Footer />
</Base>
