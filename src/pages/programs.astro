---
import Page from '../layouts/Page.astro';
import PageHero from '../components/PageHero.astro';
import PatternRibbon from '../components/PatternRibbon.astro';
import ProgramSection from '../components/ProgramSection.astro';
import { programs } from '../data/programs';

const identityStatements = [
  'Develops ethical and capable leaders.',
  'Advances East African integration.',
  'Promotes youth innovation and productive enterprise.',
  'Strengthens governance and institutional leadership.',
  'Connects young leaders with experienced statespersons and professionals.',
  'Transforms leadership potential into practical national and regional impact.',
];
---

<Page title="Programs" description="Our flagship programs that shape East Africa's next generation of ethical leaders.">
  <PageHero
    title="Our Programs"
    align="center"
    minHeight="min-h-[45vh]"
    imageSrc="/assets/images/gallery/017.jpg"
  />

  <!-- Pattern divider -->
  <PatternRibbon height={24} />

  <!-- Intro Strip -->
  <section class="section-alt section-padding section-kente-surface">
    <div class="section-container section-container--narrow">
      <p class="content-text content-text--muted" style="text-align: justify;" data-animate>
        Through these four flagship programmes, GPLA develops ethical and capable leaders, advances East African integration, promotes youth innovation and productive enterprise, strengthens governance and institutional leadership, connects young leaders with experienced statespersons and professionals, and transforms leadership potential into practical national and regional impact.
      </p>
    </div>
  </section>

  {programs.map((program, index) => (
    <Fragment>
      <ProgramSection program={program} />
      {index < programs.length - 1 && <PatternRibbon height={20} />}
    </Fragment>
  ))}

  <!-- Programmatic Identity -->
  <section class="px-4 md:px-12 py-12 md:py-20 section-alt section-kente-surface border-t border-gray-200">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <span class="section-label">Identity</span>
        <h2 class="font-display text-gpla-navy text-[24px] md:text-[44px] mt-2">OUR PROGRAMMATIC IDENTITY</h2>
      </div>
      <p class="text-gpla-navy/60 font-body text-base md:text-lg text-center mb-8">Through these four flagship programmes, GPLA:</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {identityStatements.map((statement) => (
          <div class="card-lift bg-white rounded-xl p-5 border border-gray-200 shadow-sm text-center">
            <p class="text-gpla-navy/80 text-sm font-body">{statement}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Masterclasses CTA -->
  <section class="bg-gpla-green section-padding text-center relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(255,255,255,0.06),transparent_60%)] pointer-events-none"></div>
    <div class="section-container relative z-10">
      <h2 class="font-display text-white text-[clamp(2rem,5vw,3.5rem)] mb-4">Join Our Masterclasses</h2>
      <p class="text-white/85 text-lg md:text-xl mb-8 max-w-2xl mx-auto font-body">
        Elevate your leadership journey with our Executive Master Classes — designed for emerging and established leaders across East Africa.
      </p>
      <a href="/contact" class="btn btn-gold btn-lg inline-flex">
        Apply to Join
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
      <p class="text-white/55 text-sm mt-4 font-body italic">[Application details coming soon — placeholder]</p>
    </div>
  </section>
</Page>
