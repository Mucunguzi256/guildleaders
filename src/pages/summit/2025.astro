---
import Page from '../../layouts/Page.astro';
import PageHero from '../../components/PageHero.astro';
import PatternRibbon from '../../components/PatternRibbon.astro';
import SpeakerGrid from '../../components/SpeakerGrid.astro';
import OutcomeGrid from '../../components/OutcomeGrid.astro';
import GenderSplitChart from '../../components/GenderSplitChart.astro';
import ReportDownload from '../../components/ReportDownload.astro';
import SummitCta from '../../components/SummitCta.astro';
import { twoDigits } from '../../utils/format';

const speakers = [
  { name: 'H.E. Uhuru Muigai Kenyatta', title: 'Chief Guest', subtitle: '4th President, Republic of Kenya' },
  { name: 'H.E. Jessica Alupo', title: 'Guest of Honor', subtitle: 'Vice President, Uganda' },
  { name: 'Justice Simon Byabakama', title: 'Keynote Speaker', subtitle: 'Chairperson, Electoral Commission of Uganda' },
  { name: 'Hon. Matthew Rukikaire', title: 'Advisory Council', subtitle: 'Guild Leaders Summit' },
  { name: 'Rt. Hon. Ruhakana Rugunda', title: 'Patron', subtitle: 'GPLA' },
  { name: 'Prof. Sarah Ssali', title: 'Host Chairperson', subtitle: 'Makerere University' },
  { name: 'H.E. Jakaya Mrisho Kikwete', title: 'Summit Patron', subtitle: 'Former President, Tanzania' },
  { name: 'Demiano Masesa', title: 'Executive Director', subtitle: 'GPLA' },
];

const objectives = [
  'Inspire young leaders to adopt ethical principles and prioritize good governance in their roles.',
  'Build networks among student leaders across East African universities to address governance challenges collectively.',
  'Provide actionable insights on navigating leadership challenges and promoting institutional accountability.',
  'Create a platform for youth leaders to articulate their perspectives on governance and regional development.',
];

const outcomes = [
  'Instituting a rotational Annual Summit among East African member states',
  'Students to take the lead on the quest for East African integration',
  'Request regional governments to contribute to the resource envelope of the Annual Summit and GPLA activities',
  'Young people to take on leadership roles in their communities to effect the changes they desire',
  'Promote East African integration and strengthen collaboration among regional Guild Leaders',
  'Seek government financial support and gazetting of the Summit',
].map((text, index) => ({ num: twoDigits(index + 1), text }));

const overviewStats = [
  { value: '1,000+', label: 'Youth leaders' },
  { value: '920', label: 'Registered participants' },
  { value: '6', label: 'East African countries' },
  { value: '3', label: 'Panel discussions' },
];
---

<Page title="Summit 2025" description="2nd Annual Guild Leaders Summit 2025 — Leadership with Integrity; Building Foundations for Good Governance in East Africa.">
  <PageHero
    label="24 April 2025 · Makerere University"
    title={['2nd Annual Guild', 'Leaders Summit']}
    titleSize="text-[clamp(2rem,6vw,4rem)]"
    titleDelay={50}
    subtitleDelay={100}
    noteDelay={150}
    imageSrc="/assets/images/gallery/016.jpg"
    overlay="bg-gradient-to-r from-gpla-navy/90 via-gpla-navy/75 to-gpla-navy/50"
    watermark="2025"
    subtitle='"Leadership with Integrity; Building Foundations for Good Governance in East Africa"'
    note="CTF2, Yusuf Lule Auditorium · Makerere University, Kampala"
  />

  <PatternRibbon height={28} />

  <!-- Summit Overview -->
  <section class="px-4 md:px-12 py-12 md:py-24 section-light section-kente-surface">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-display text-gpla-navy text-[28px] md:text-[48px] mb-6 md:mb-8">ABOUT SUMMIT 2025</h2>
      <div class="space-y-5 text-gpla-navy/70 text-base md:text-lg leading-relaxed max-w-[800px] font-body" style="text-align: justify;">
        <p>
          Building on the inaugural 2024 Summit, the Second Annual Guild Leaders Summit deepened the conversation on leadership with integrity and its role in laying strong foundations for good governance across East Africa.
        </p>
        <p>
          Held on Thursday, 24th April 2025 at CTF2, Yusuf Lule Auditorium, Makerere University, the Summit convened over 1,000 youth leaders, Guild Leaders, and young professionals from across East Africa for dialogue on leadership, governance, and democratic participation.
        </p>
        <p>
          Chief Guest H.E. Uhuru Muigai Kenyatta, Fourth President of the Republic of Kenya, shared lessons from his experience in governance, peace-building, and regional unity. The Summit also served as a catalyst for building networks among East African youth leaders to address governance challenges collaboratively.
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-10">
        {overviewStats.map((stat) => (
          <div class="bg-white border border-gpla-navy/8 rounded-xl p-5 text-center shadow-sm">
            <div class="font-display text-3xl text-gpla-navy">{stat.value}</div>
            <p class="text-gpla-navy/55 text-xs mt-1 font-body">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Objectives -->
  <section class="px-4 md:px-12 py-12 md:py-24 bg-gpla-navy">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-display text-white text-[28px] md:text-[48px] mb-8 md:mb-12">OBJECTIVES OF THE SUMMIT</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
        {objectives.map((text, i) => (
          <div class="border border-white/15 rounded-xl p-6 flex gap-4">
            <span class="font-display text-gpla-gold text-2xl shrink-0">{twoDigits(i + 1)}</span>
            <p class="text-white/80 text-sm md:text-base font-body leading-relaxed">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SpeakerGrid speakers={speakers} class="border-t border-white/10" />

  <OutcomeGrid
    heading="RECOMMENDATIONS & ACTION POINTS"
    intro="From the Summit report — recommendations and advice notes adopted by participants."
    outcomes={outcomes}
    tone="navy"
    columns="sm:grid-cols-2 md:grid-cols-3"
    sectionClass="px-4 md:px-12 py-12 md:py-24 section-alt section-kente-surface"
  />

  <GenderSplitChart
    heading="PARTICIPANT DEMOGRAPHICS"
    cardHeading="Gender Distribution"
    cardNote="Overall gender distribution at the Second Annual Guild Leaders Summit (Total: 920)"
    malePercent={61.2}
    femalePercent={38.8}
    source="Source: Summit Report 2025"
    sectionClass="px-4 md:px-12 py-12 md:py-24 section-light section-kente-surface"
  />

  <ReportDownload
    heading="SUMMIT REPORT 2025"
    title="Guild Leaders Summit Report 2025"
    meta="PDF Document • 2.4 MB · 2nd Annual Guild Leaders Summit"
    href="/reports/summit-2025.pdf"
  />

  <SummitCta heading="View 2026 Summit" href="/summit/2026" label="View 2026 Summit →" />
</Page>
