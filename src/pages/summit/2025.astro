---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PatternRibbon from '../../components/PatternRibbon.astro';

const speakers2025 = [
  { name: 'HE. Paul Kagame', title: 'Chief Guest', subtitle: 'President, Rwanda' },
  { name: 'HE. Samia Suluhu Hassan', title: 'Guest of Honor', subtitle: 'President, Tanzania' },
  { name: 'Dr. Rebecca Joshua', title: 'Keynote Speaker', subtitle: 'EC Chairman, Kenya' },
  { name: 'Hon. Margaret K. Nkodo', title: 'Panelist', subtitle: 'Minister, Burundi' },
];
---

<Base title="Summit 2025" description="Guild Leaders' Annual Summit 2025 - Full report and outcomes.">
  <Navbar />
  
  <!-- Hero -->
  <section class="min-h-[50vh] md:min-h-[55vh] bg-gpla-navy section-padding relative overflow-hidden flex items-center" style="padding-top: 8rem;">
    <div class="absolute bottom-0 right-0 w-[35%] h-full bg-gpla-green" style="clip-path: polygon(25% 0, 100% 0, 100% 100%, 0% 100%);"></div>
    <div class="section-container relative z-10 w-full">
      <h1 class="font-display text-white text-[clamp(2rem,6vw,4rem)] leading-[0.95]" data-animate>
        Guild Leaders'<br />Annual Summit
      </h1>
      <div class="font-display text-[100px] md:text-[180px] text-gpla-gold/20 absolute right-[5%] md:right-[15%] top-[30%] z-10 leading-none hidden md:block font-bold">2025</div>
      <p class="text-white/85 text-lg md:text-xl mt-4 md:mt-6 max-w-[600px] relative z-10 font-body" data-animate data-delay="100">
        "Democratic Transformation: Building the leaders of tomorrow"
      </p>
    </div>
  </section>

  <PatternRibbon height={28} />

  <!-- Video Highlights -->
  <section class="px-4 md:px-12 py-12 md:py-20 bg-gpla-navy">
    <div class="max-w-5xl mx-auto">
      <p class="text-gpla-green font-semibold uppercase tracking-widest text-sm mb-3">Watch</p>
      <h2 class="font-display text-white text-[28px] md:text-[42px] mb-6 md:mb-10">SUMMIT HIGHLIGHTS</h2>
      <div class="video-wrapper rounded-xl overflow-hidden shadow-2xl">
        <!-- Client to replace with actual YouTube/Vimeo embed -->
        <div class="bg-gradient-to-br from-[#132d82] to-[#389a29] aspect-video flex items-center justify-center">
          <div class="text-center p-8">
            <div class="w-20 h-20 rounded-full bg-white/10 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <p class="text-white/70 text-sm">Summit 2025 Video Coming Soon</p>
            <p class="text-white/40 text-xs mt-2">Replace with YouTube/Vimeo embed</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Speakers -->
  <section class="px-4 md:px-12 py-12 md:py-24 bg-gpla-navy">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-display text-white text-[28px] md:text-[48px] mb-8 md:mb-12">KEY SPEAKERS</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8">
        {speakers2025.map(speaker => (
          <div class="text-center">
            <div class="w-20 md:w-36 h-20 md:h-36 rounded-full bg-gradient-to-br from-gpla-gold to-gpla-green mx-auto mb-4"></div>
            <h4 class="font-display text-sm md:text-xl text-white">{speaker.name}</h4>
            <p class="text-gpla-gold text-sm">{speaker.title}</p>
            <span class="text-white/60 text-xs">{speaker.subtitle}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Summit Overview -->
  <section class="px-4 md:px-12 py-12 md:py-24">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-display text-gpla-navy text-[28px] md:text-[48px] mb-6 md:mb-8">ABOUT SUMMIT 2025</h2>
      <p class="text-gpla-navy/70 text-lg leading-relaxed max-w-[800px]">
        The 2025 Guild Leaders' Annual Summit focused on "Democratic Transformation" and brought together over 700 student leaders from across East Africa. This year's summit expanded regional representation and strengthened cross-border collaboration among Guild Presidents.
      </p>
    </div>
  </section>

  <!-- Key Outcomes -->
  <section class="px-4 md:px-12 py-12 md:py-24 section-alt section-kente-surface">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-display text-gpla-navy text-[28px] md:text-[48px] mb-8 md:mb-12">KEY OUTCOMES</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-gpla-navy p-6 rounded-lg text-center">
          <div class="font-display text-[48px] text-white">01</div>
          <p class="text-white text-sm mt-2">Regional Integration Framework</p>
        </div>
        <div class="bg-gpla-navy p-6 rounded-lg text-center">
          <div class="font-display text-[48px] text-white">02</div>
          <p class="text-white text-sm mt-2">Cross-Border Mentorship Network</p>
        </div>
        <div class="bg-gpla-navy p-6 rounded-lg text-center">
          <div class="font-display text-[48px] text-white">03</div>
          <p class="text-white text-sm mt-2">Youth Political Participation Initiative</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PDF Download Section -->
  <section class="px-4 md:px-12 py-12 md:py-24 section-alt section-kente-surface">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-display text-gpla-navy text-[28px] md:text-[48px] mb-6 md:mb-8">SUMMIT REPORT 2025</h2>
      <div class="bg-white p-5 md:p-8 rounded-xl shadow-lg">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 md:gap-6 mb-6">
          <div class="w-16 h-16 bg-gpla-navy rounded-lg flex items-center justify-center">
            <span class="text-white font-display text-2xl">PDF</span>
          </div>
          <div>
            <h3 class="font-display text-2xl text-gpla-navy">Guild Leaders Summit Report 2025</h3>
            <p class="text-gpla-navy/55 text-sm">PDF Document • 2.4 MB</p>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 md:gap-4">
          <a href="/reports/summit-2025.pdf" download class="bg-gpla-green text-white px-6 md:px-8 py-3 md:py-4 rounded-full font-semibold inline-flex items-center justify-center gap-2 hover:shadow-xl hover:-translate-y-0.5 transition-all text-sm md:text-base">
            ↓ Download Report
          </a>
          <a href="/reports/summit-2025.pdf" target="_blank" class="border-2 border-gpla-navy text-gpla-navy px-6 md:px-8 py-3 md:py-4 rounded-full font-semibold inline-flex items-center justify-center gap-2 hover:bg-gpla-navy hover:text-white transition-all text-sm md:text-base">
            ↗ Open in New Tab
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gpla-navy px-4 md:px-12 py-12 md:py-16 text-center">
    <h3 class="font-display text-white text-[28px] md:text-[48px] mb-5">View 2026 Summit</h3>
    <a href="/summit/2026" class="bg-gpla-green text-white px-10 py-5 rounded-full font-semibold inline-block hover:shadow-xl hover:-translate-y-0.5 transition-all">
      View 2026 Summit →
    </a>
  </section>

  <Footer />
</Base>