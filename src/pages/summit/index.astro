---
import Page from '../../layouts/Page.astro';
import PageHero from '../../components/PageHero.astro';
import PatternBackdrop from '../../components/PatternBackdrop.astro';
import PatternDivider from '../../components/PatternDivider.astro';
import SummitYearCard from '../../components/SummitYearCard.astro';
import { summitCards } from '../../data/summits';
---

<Page title="Summit" description="The Guild Leaders' Annual Summit - East Africa's premier youth leadership gathering.">
  <PageHero
    label="Summit"
    title={["Guild Leaders'", 'Annual Summit']}
    minHeight="min-h-[45vh] md:min-h-[50vh]"
    imageSrc="/assets/images/gallery/023.jpg"
    imageOpacity="opacity-25"
    subtitleClass="text-white/80 text-lg md:text-xl max-w-[640px] mt-6 relative z-10 font-body leading-relaxed"
    subtitle="From 700 student leaders in 2024 to a growing East African regional movement — the continent's premier youth leadership convening at Makerere University."
  >
    <PatternBackdrop slot="backdrop" variant="navy" />
    <div class="flex flex-wrap gap-3 mt-8" data-animate data-delay="200">
      <a href="/summit/2026" class="btn btn-primary">Summit 2026 →</a>
      <a href="/summit/2025" class="btn btn-outline">Past Summits</a>
    </div>
  </PageHero>

  <PatternDivider bold />

  <section class="section-padding section-alt section-kente-surface relative overflow-hidden">
    <PatternBackdrop variant="cream" />
    <div class="max-w-7xl mx-auto px-4 md:px-12 relative z-10">
      <div class="text-center mb-12" data-animate>
        <span class="section-label text-gpla-green">East Africa</span>
        <h2 class="font-display text-gpla-navy text-[clamp(2rem,4vw,3rem)]">Summit Archive &amp; 2026</h2>
      </div>
      <div class="summit-bento-grid summit-bento-grid--summits">
        <SummitYearCard
          {...summitCards['2026']}
          tagline="Upcoming · 23–24 July 2026"
          primaryCta={{ href: 'https://luma.com/5tuheo2m', label: 'Apply to Join →', external: true }}
          secondaryCta={{ href: '/summit/2026', label: 'Learn More →' }}
        />
        <SummitYearCard {...summitCards['2025']} />
        <SummitYearCard {...summitCards['2024']} />
      </div>
    </div>
  </section>
</Page>
