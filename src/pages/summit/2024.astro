---
import Page from '../../layouts/Page.astro';
import PageHero from '../../components/PageHero.astro';
import PatternRibbon from '../../components/PatternRibbon.astro';
import SpeakerGrid from '../../components/SpeakerGrid.astro';
import OutcomeGrid from '../../components/OutcomeGrid.astro';
import GenderSplitChart from '../../components/GenderSplitChart.astro';
import ReportDownload from '../../components/ReportDownload.astro';
import SummitCta from '../../components/SummitCta.astro';
import { twoDigits } from '../../utils/format';

const speakers = [
  { name: 'HE. Jakaya Mrisho Kikwete', title: 'Chief Guest', subtitle: 'Former President, Tanzania' },
  { name: 'HE. Jessica Alupo', title: 'Guest of Honor', subtitle: 'Vice President, Uganda' },
  { name: 'Justice Simon Byabakama', title: 'Keynote Speaker', subtitle: 'EC Chairman, Uganda' },
  { name: 'Rt. Hon. Ruhakana Rugunda', title: 'Panelist', subtitle: 'Former PM, Uganda' },
  { name: 'Hon. Mathew Rukikaire', title: 'Panelist', subtitle: 'Former Minister, Kenya' },
  { name: 'Prof. Sarah Ssali', title: 'Facilitator', subtitle: 'Makerere University' },
  { name: 'HE. Jan Sadek', title: 'Special Guest', subtitle: 'EU Ambassador to Uganda' },
  { name: 'Demiano Masesa', title: 'Executive Director', subtitle: 'GPLA' },
];

const outcomes = [
  'GPLA endorsed as the driver of transition of outgoing Guild Presidents into active political participation',
  'Freedoms in Universities — allow students to freely express themselves especially along political party lines',
  'Expand the summit to a regional East African initiative',
  'HE. Jakaya Mrisho Kikwete to be named Patron of the Summit when it opens regionally',
  'Guild Leaders to receive training before and into their leadership tenure',
].map((text, index) => ({ num: twoDigits(index + 1), text }));
---

<Page title="Summit 2024" description="Guild Leaders' Annual Summit 2024 - Full report and outcomes.">
  <PageHero
    title={["Guild Leaders'", 'Annual Summit']}
    titleSize="text-[clamp(2rem,6vw,4rem)]"
    titleDelay={0}
    subtitleDelay={100}
    subtitleClass="text-white/85 text-lg md:text-xl mt-4 md:mt-6 max-w-[600px] relative z-10 font-body"
    imageSrc="/assets/images/gallery/001.jpg"
    overlay="bg-gradient-to-r from-gpla-navy/90 via-gpla-navy/75 to-gpla-navy/50"
    watermark="2024"
    subtitle='"Legacy and Leadership Continuum: The Power of Knowledge and Cross-Generational Learning"'
  />

  <PatternRibbon height={28} />

  <SpeakerGrid speakers={speakers} />

  <OutcomeGrid heading="KEY OUTCOMES" outcomes={outcomes} />

  <GenderSplitChart
    heading="GENDER STATISTICS"
    cardHeading="Guild Representation by Gender"
    malePercent={55.8}
    femalePercent={44.2}
  />

  <ReportDownload
    heading="SUMMIT REPORT 2024"
    title="Guild Leaders Summit Report 2024"
    meta="PDF Document • 7.5 MB"
    href="/reports/summit-2024.pdf"
  />

  <SummitCta heading="View 2025 Summit Report" href="/summit/2025" label="View 2025 Report →" />
</Page>
