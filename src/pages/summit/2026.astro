---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PatternDivider from '../../components/PatternDivider.astro';
import PatternBackdrop from '../../components/PatternBackdrop.astro';
import PatternRail from '../../components/PatternRail.astro';
import { twoDigits } from '../../utils/format';
import { contactEmail, partnerFormEndpoint } from '../../data/site';

const outcomes = [
  'Institutionalise the East African Guild Leaders&rsquo; Summit as an annual regional youth leadership convening.',
  'Establish a permanent GPLA / EAGLS Secretariat to coordinate Summit planning and follow-up across partner states.',
  'Strengthen formal linkage with EAC structures to embed youth voice in regional integration policy.',
  'Rotate the Summit annually across East African Community Partner States.',
  'Create an East African Young Leaders Integration Fund to resource student-led regional projects.',
].map((text, index) => ({ num: twoDigits(index + 1), text }));

const overviewStats = [
  { value: '1,500', label: 'Participants' },
  { value: '6', label: 'East African countries' },
  { value: '28', label: 'Universities represented' },
  { value: '5', label: 'Plenary sessions' },
];
---

<Base
  title="3RD ANNUAL EAST AFRICAN GUILD LEADERS SUMMIT REPORT 2026"
  description="Official report of the 3rd Annual East African Guild Leaders&rsquo; Summit at Makerere University, 23&ndash;24 July 2026. Theme: Youth Leadership, Production and Regional Integration."
  og={{
    type: 'article',
    url: 'https://guildleaders.academy/summit/2026',
    image: 'https://guildleaders.academy/assets/images/summit-2026-og.jpg',
    imageWidth: '1200',
    imageHeight: '630',
  }}
  twitter={{
    card: 'summary_large_image',
    image: 'https://guildleaders.academy/assets/images/summit-2026-og.jpg',
  }}
>
  <!-- Canonical -->

  <Navbar />
  
  <style is:global>
    .summit-2026-layout .luma-embed-wrapper {
      max-width: 100%;
      width: 100%;
    }
    .summit-2026-layout .luma-embed-wrapper iframe {
      width: 100% !important;
      height: 520px !important;
    }
    @media (min-width: 600px) {
      .summit-2026-layout .luma-embed-wrapper {
        max-width: 560px;
        margin: 0 auto;
      }
      .summit-2026-layout .luma-embed-wrapper iframe {
        height: 580px !important;
      }
    }
    .summit-2026-layout .partner-embed iframe {
      width: 100% !important;
      height: 400px !important;
    }
    .summit-2026-layout .form-status {
      padding: 0.875rem 1.125rem;
      border-radius: 10px;
      font-size: 0.95rem;
      line-height: 1.6;
      border: 1px solid transparent;
      color: #fff;
    }
    .summit-2026-layout .form-status[data-state='pending'] {
      background: rgba(255,255,255,0.1);
      border-color: rgba(255,255,255,0.25);
    }
    .summit-2026-layout .form-status[data-state='success'] {
      background: rgba(56,154,41,0.25);
      border-color: rgba(56,154,41,0.6);
    }
    .summit-2026-layout .form-status[data-state='error'] {
      background: rgba(220,60,60,0.2);
      border-color: rgba(220,60,60,0.6);
    }
    .report-cover-thumb {
      border-radius: 8px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.18);
      max-width: 240px;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .report-cover-thumb:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0,0,0,0.28);
    }
  </style>

  <div class="summit-2026-layout">
    <!-- Hero Section -->
    <section class="hero relative min-h-[70vh] md:min-h-[80vh] overflow-hidden flex items-center">
      <PatternRail class="hidden md:block z-[2]" />
      <div class="absolute inset-0 z-0">
        <img src="/assets/images/gallery/022.jpg" alt="" class="w-full h-full object-cover opacity-35" />
        <div class="absolute inset-0" style="background: linear-gradient(90deg, rgba(19,45,130,0.88) 0%, rgba(19,45,130,0.75) 35%, rgba(56,154,41,0.35) 60%, transparent 78%);"></div>
      </div>
      <div class="african-hero-overlay"></div>
      <PatternBackdrop variant="navy" />

      <div class="relative z-10 max-w-6xl mx-auto px-4 md:px-12 py-20 md:py-32 w-full">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 items-center">
          <div>
            <p class="bg-gpla-gold text-gpla-navy text-sm font-semibold uppercase tracking-widest px-4 py-2 rounded-full inline-block mb-6">COMPLETED · 23&ndash;24 JULY 2026</p>
            <h1 class="font-display text-white text-[28px] sm:text-[42px] md:text-[56px] lg:text-[72px] leading-[0.95] mb-6">
              <span class="block" data-animate>3RD ANNUAL</span>
              <span class="block" data-animate data-delay="100">EAST AFRICAN</span>
              <span class="block" data-animate data-delay="200">GUILD LEADERS&rsquo;</span>
              <span class="block text-gpla-green" data-animate data-delay="300">SUMMIT</span>
            </h1>
            <p class="text-white/80 text-lg md:text-xl italic mb-6 font-body">
              Youth Leadership, Production, and Regional Integration: Building a Competitive East Africa in a Changing Global Order
            </p>
            <div class="flex flex-wrap gap-4 mb-6">
              <a href="/publications/3rd-annual-east-african-guild-leaders-summit-report-2026.pdf" target="_blank" rel="noopener noreferrer" class="bg-gpla-gold text-gpla-navy px-6 md:px-8 py-3 md:py-4 rounded-full font-semibold inline-flex items-center gap-2 hover:bg-gpla-gold-bright hover:-translate-y-0.5 transition-all">
                📄 View Report ↗
              </a>
              <a href="/publications/3rd-annual-east-african-guild-leaders-summit-report-2026.pdf" download class="border-2 border-white text-white px-6 md:px-8 py-3 md:py-4 rounded-full font-semibold inline-flex items-center gap-2 hover:bg-white hover:text-gpla-navy transition-all">
                ↓ Download PDF
              </a>
            </div>
            <p class="text-gpla-gold text-sm font-mono">#TheGuildLeadersSummit2026 · #GPLASummit</p>
          </div>
          <div class="hidden lg:block relative">
            <img src="/assets/chief-guest.webp" alt="" class="w-full max-w-sm rounded-2xl shadow-2xl border-4 border-gpla-gold/40 relative z-10" />
            <div class="font-display text-[120px] text-gpla-gold/15 leading-none absolute -bottom-4 -right-4 z-0">2026</div>
          </div>
        </div>
      </div>
    </section>

    <PatternDivider bold />

    <!-- Summit Overview -->
    <section class="px-4 md:px-12 py-16 md:py-24 bg-gpla-cream/90 section-kente-surface relative overflow-hidden">
      <PatternBackdrop variant="cream" />
      <div class="max-w-6xl mx-auto relative z-10">
        <h2 class="font-display text-gpla-navy text-[28px] md:text-[48px] mb-8">ABOUT THE SUMMIT</h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16">
          <div class="space-y-5 text-gpla-navy/70 text-base md:text-lg leading-relaxed font-body" style="text-align: justify;">
            <p>
              The 3rd Annual East African Guild Leaders&rsquo; Summit convened about 1,500 university student leaders, government leaders, university leaders, development partners, private sector actors and youth representatives from across East Africa at Makerere University, Kampala, on 23&ndash;24 July 2026.
            </p>
            <p>
              Chief Guest H.E. Yoweri Kaguta Museveni, President of the Republic of Uganda and Chairperson of the EAC, delivered a keynote address on youth leadership and the role of young people in building a competitive, integrated East Africa.
            </p>
            <p>
              A key outcome of the Summit is the <strong>Makerere Declaration and Youth Compact 2026</strong>, which sets out a shared agenda for youth-led regional integration, institutionalising the annual Summit, and creating formal linkages with East African Community structures.
            </p>
          </div>
          <div class="flex flex-col gap-6">
            <div class="space-y-5">
              <div class="border-l-4 border-gpla-green pl-4">
                <h4 class="font-semibold text-gpla-navy text-lg">Date</h4>
                <p class="text-gpla-navy/70">23rd &ndash; 24th July 2026</p>
              </div>
              <div class="border-l-4 border-gpla-green pl-4">
                <h4 class="font-semibold text-gpla-navy text-lg">Venue</h4>
                <p class="text-gpla-navy/70">Freedom Square, Makerere University, Kampala</p>
              </div>
              <div class="border-l-4 border-gpla-green pl-4">
                <h4 class="font-semibold text-gpla-navy text-lg">Chief Guest</h4>
                <p class="text-gpla-navy/70">H.E. Yoweri Kaguta Museveni<br/>President of the Republic of Uganda &amp; Chairperson of the EAC</p>
              </div>
              <div class="border-l-4 border-gpla-green pl-4">
                <h4 class="font-semibold text-gpla-navy text-lg">Partners</h4>
                <div class="flex flex-wrap gap-3 mt-2">
                  <div class="bg-gpla-navy text-white px-4 py-2 rounded font-display text-sm">IGDS</div>
                  <div class="bg-gpla-navy text-white px-4 py-2 rounded font-display text-sm">UNiFOG</div>
                </div>
              </div>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-2">
              {overviewStats.map((stat) => (
                <div class="bg-white border border-gpla-navy/8 rounded-xl p-4 text-center shadow-sm">
                  <div class="font-display text-2xl text-gpla-navy">{stat.value}</div>
                  <p class="text-gpla-navy/55 text-xs mt-1 font-body">{stat.label}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <PatternDivider />

    <!-- Theme Quote -->
    <section class="px-4 md:px-12 py-12 md:py-20 bg-gpla-navy relative overflow-hidden">
      <PatternBackdrop variant="navy" />
      <div class="max-w-4xl mx-auto text-center relative z-10">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-8 md:p-12">
          <p class="text-gpla-gold font-display text-xl md:text-2xl italic leading-relaxed">
            &ldquo;Youth Leadership, Production, and Regional Integration: Building a Competitive East Africa in a Changing Global Order&rdquo;
          </p>
          <p class="text-white/50 text-sm mt-4 font-body">Summit Theme · Makerere University, July 2026</p>
        </div>
      </div>
    </section>

    <PatternDivider />

    <!-- Focus Areas -->
    <section class="px-4 md:px-12 py-16 md:py-24 section-light section-kente-surface">
      <div class="max-w-6xl mx-auto">
        <h2 class="font-display text-gpla-navy text-[28px] md:text-[48px] text-center mb-12" data-animate>FOCUS AREAS</h2>
        <div class="focus-bento">
          <div class="focus-bento__item focus-bento__wide" data-animate data-delay="0">
            <span class="focus-bento__num">01</span>
            <h4 class="focus-bento__title">Political and Economic Integration</h4>
          </div>
          <div class="focus-bento__item" data-animate data-delay="50">
            <span class="focus-bento__num">02</span>
            <h4 class="focus-bento__title">Youth, Production and Industrial Transformation</h4>
          </div>
          <div class="focus-bento__item" data-animate data-delay="100">
            <span class="focus-bento__num">03</span>
            <h4 class="focus-bento__title">Regional Markets, Trade and Economic Opportunities</h4>
          </div>
          <div class="focus-bento__item" data-animate data-delay="150">
            <span class="focus-bento__num">04</span>
            <h4 class="focus-bento__title">Sports Diplomacy and Regional Integration (AFCON 2027)</h4>
          </div>
          <div class="focus-bento__item" data-animate data-delay="200">
            <span class="focus-bento__num">05</span>
            <h4 class="focus-bento__title">Technology, Innovation and the Digital Economy</h4>
          </div>
          <div class="focus-bento__item" data-animate data-delay="250">
            <span class="focus-bento__num">06</span>
            <h4 class="focus-bento__title">Education, Mobility and Knowledge Integration</h4>
          </div>
        </div>
      </div>
    </section>

    <PatternDivider />

    <!-- Key Outcomes -->
    <section class="px-4 md:px-12 py-16 md:py-24 bg-gpla-navy relative overflow-hidden">
      <PatternBackdrop variant="navy" />
      <div class="max-w-6xl mx-auto relative z-10">
        <h2 class="font-display text-white text-[28px] md:text-[48px] mb-2">KEY OUTCOMES</h2>
        <p class="text-white/60 text-base md:text-lg mb-8 md:mb-10 max-w-[640px] font-body">
          From the Makerere Declaration and Youth Compact 2026 &mdash; outcomes adopted by Summit participants.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 md:gap-5">
          {outcomes.map((o) => (
            <div class="border border-white/15 rounded-xl p-5 md:p-6 flex gap-4">
              <span class="font-display text-gpla-gold text-xl shrink-0">{o.num}</span>
              <p class="text-white/80 text-sm md:text-base font-body leading-relaxed" set:html={o.text}></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <PatternDivider />

    <!-- Summit Report -->
    <section class="px-4 md:px-12 py-16 md:py-24 section-alt section-kente-surface relative overflow-hidden">
      <PatternBackdrop variant="cream" />
      <div class="max-w-4xl mx-auto relative z-10">
        <span class="section-label text-gpla-green">Post-Summit</span>
        <h2 class="font-display text-gpla-navy text-[28px] md:text-[48px] mb-3">3RD ANNUAL EAST AFRICAN GUILD LEADERS SUMMIT REPORT 2026</h2>
        <p class="text-gpla-navy/55 text-base md:text-lg mb-8 max-w-[640px] font-body">
          The full summit report including proceedings, resolutions, the Makerere Declaration, participant demographics, and photo gallery.
        </p>
        <div class="bg-white p-5 md:p-8 rounded-xl shadow-lg border border-gpla-navy/6">
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 md:gap-8 mb-6">
            <a href="/publications/3rd-annual-east-african-guild-leaders-summit-report-2026.pdf" target="_blank" rel="noopener noreferrer" class="shrink-0">
              <img
                src="/assets/images/summit-2026-og.jpg"
                alt="3RD ANNUAL EAST AFRICAN GUILD LEADERS SUMMIT REPORT 2026 cover"
                class="report-cover-thumb w-36 md:w-44"
              />
            </a>
            <div>
              <h3 class="font-display text-xl md:text-2xl text-gpla-navy">3RD ANNUAL EAST AFRICAN GUILD LEADERS SUMMIT REPORT 2026</h3>
              <p class="text-gpla-navy/55 text-sm mt-1 font-body">PDF Document · 4.7 MB · 28 pages · Makerere University, 23&ndash;24 July 2026</p>
            </div>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 md:gap-4">
            <a
              href="/publications/3rd-annual-east-african-guild-leaders-summit-report-2026.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 md:px-8 py-3 md:py-4 rounded-full font-semibold inline-flex items-center justify-center gap-2 transition-all text-sm md:text-base bg-gpla-green text-white hover:shadow-xl hover:-translate-y-0.5"
            >
              ↗ View Report
            </a>
            <a
              href="/publications/3rd-annual-east-african-guild-leaders-summit-report-2026.pdf"
              download
              class="px-6 md:px-8 py-3 md:py-4 rounded-full font-semibold inline-flex items-center justify-center gap-2 transition-all text-sm md:text-base border-2 border-gpla-navy text-gpla-navy hover:bg-gpla-navy hover:text-white"
            >
              ↓ Download PDF
            </a>
          </div>
        </div>
      </div>
    </section>

    <PatternDivider />

    <!-- Partner With Us -->
    <section id="partner" class="bg-gpla-navy py-20 px-4 md:px-12">
      <div class="container mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 items-start">
          <div>
            <h2 class="font-display text-white text-[28px] md:text-[56px] mb-6">
              PARTNER WITH US
            </h2>
            <p class="text-white/70 text-lg mb-6">
              Align your organisation with East Africa&rsquo;s premier youth leadership platform. Future Summits will convene heads of state, regional institutions, and student leaders from across the EAC.
            </p>
            <ul class="space-y-3 text-white/80 mb-8">
              <li class="flex items-center gap-3"><span class="text-gpla-green text-xl">✓</span> Brand visibility across East African countries</li>
              <li class="flex items-center gap-3"><span class="text-gpla-green text-xl">✓</span> Direct access to emerging youth leaders</li>
              <li class="flex items-center gap-3"><span class="text-gpla-green text-xl">✓</span> Co-branding on Summit materials and reports</li>
              <li class="flex items-center gap-3"><span class="text-gpla-green text-xl">✓</span> Panel and speaking opportunities</li>
            </ul>
          </div>
          <div class="bg-white/5 p-6 md:p-8 rounded-xl">
            <h3 class="text-white font-display text-2xl mb-6">
              APPLY TO PARTNER
            </h3>
            <form
              method="POST"
              action={partnerFormEndpoint}
              data-ajax-form
              data-fallback-email={contactEmail}
              data-fallback-subject="Summit 2026 partnership enquiry"
              data-success-message="Thank you — your partnership application has been received. Our team will get back to you shortly."
            >
              <input type="hidden" name="form-name" value="summit-2026-partner" />
              <div class="space-y-4">
                <input type="text" name="organisation" placeholder="Organisation Name" required class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:border-gpla-green" />
                <input type="text" name="contact_person" placeholder="Contact Person" required class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:border-gpla-green" />
                <input type="email" name="email" placeholder="Email Address" required class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:border-gpla-green" />
                <select name="partnership_type" class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white focus:outline-none focus:border-gpla-green">
                  <option value="" class="text-gpla-navy">Select Partnership Type</option>
                  <option value="Lead Partner" class="text-gpla-navy">Lead Partner</option>
                  <option value="Gold Partner" class="text-gpla-navy">Gold Partner</option>
                  <option value="Silver Partner" class="text-gpla-navy">Silver Partner</option>
                  <option value="Media Partner" class="text-gpla-navy">Media Partner</option>
                  <option value="Academic Partner" class="text-gpla-navy">Academic Partner</option>
                </select>
                <textarea name="message" placeholder="Tell us about your organisation and interest in partnering" rows="4" class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:border-gpla-green"></textarea>
                <p class="form-status" data-form-status role="status" aria-live="polite" hidden></p>
                <button type="submit" class="w-full bg-gpla-green text-white px-8 py-4 rounded-full font-semibold hover:shadow-xl hover:-translate-y-0.5 transition-all">
                  Submit Partnership Application →
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Base>

<script>
  import { twoDigits } from '../../utils/format';
  import { safeInit } from '../../scripts/errors';
  import { observeReveal, revealAll } from '../../scripts/reveal';
  import { initAjaxForms } from '../../scripts/form';

  initAjaxForms();

  // Scroll animations
  safeInit(
    'summit 2026 scroll animations',
    () => observeReveal('[data-animate]', 'animate-in', { threshold: 0.1 }),
    () => revealAll('[data-animate]', 'animate-in'),
  );
</script>
