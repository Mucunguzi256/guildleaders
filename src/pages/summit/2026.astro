---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<Base title="Summit 2026" description="3rd Annual East African Guild Leaders' Summit - July 23-24, 2026">
  <Navbar />
  
  <style is:global>
    .summit-2026-layout .luma-embed-wrapper {
      max-width: 100%;
      width: 100%;
    }
    .summit-2026-layout .luma-embed-wrapper iframe {
      width: 100% !important;
      height: 520px !important;
    }
    @media (min-width: 600px) {
      .summit-2026-layout .luma-embed-wrapper {
        max-width: 560px;
        margin: 0 auto;
      }
      .summit-2026-layout .luma-embed-wrapper iframe {
        height: 580px !important;
      }
    }
    .summit-2026-layout .partner-embed iframe {
      width: 100% !important;
      height: 400px !important;
    }
  </style>

  <div class="summit-2026-layout">
    <!-- Hero Section -->
    <section class="hero relative min-h-[70vh] md:min-h-[80vh] overflow-hidden flex items-center">
      <div class="hero-video-wrapper absolute inset-0 z-0">
        <video autoplay muted loop playsinline class="w-full h-full object-cover opacity-30" poster="/assets/hero-poster.jpg">
          <source src="/assets/hero-bg-compressed.mp4" type="video/mp4"><source src="/assets/GLP Short Video.mp4" type="video/mp4">
        </video>
        <div class="absolute inset-0" style="background: linear-gradient(90deg, rgba(19,45,130,0.92) 0%, rgba(19,45,130,0.85) 30%, rgba(56,154,41,0.40) 55%, transparent 70%, transparent 100%);"></div>
      </div>

      <div class="relative z-10 max-w-6xl mx-auto px-4 md:px-12 py-20 md:py-32 w-full">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 items-center">
          <div>
            <p class="bg-gpla-gold text-gpla-navy text-sm font-semibold uppercase tracking-widest px-4 py-2 rounded-full inline-block mb-6">UPCOMING · 23–24 JULY 2026</p>
            <h1 class="font-display text-white text-[42px] md:text-[56px] lg:text-[72px] leading-[0.95] mb-6">
              <span class="block" data-animate>3RD ANNUAL</span>
              <span class="block" data-animate data-delay="100">EAST AFRICAN</span>
              <span class="block" data-animate data-delay="200">GUILD LEADERS'</span>
              <span class="block text-gpla-green" data-animate data-delay="300">SUMMIT</span>
            </h1>
            <p class="text-white/80 text-lg md:text-xl italic mb-6 font-body">
              Youth Leadership, Production, and Regional Integration: Building a Competitive East Africa in a Changing Global Order
            </p>
            <div class="flex flex-wrap gap-4 mb-6">
              <a href="https://lu.ma/5tuheo2m" target="_blank" rel="noopener noreferrer" class="bg-gpla-green text-white px-6 md:px-8 py-3 md:py-4 rounded-full font-semibold inline-block hover:shadow-xl hover:-translate-y-0.5 transition-all">
                Apply to Join →
              </a>
              <a href="#partner" class="border-2 border-white text-white px-6 md:px-8 py-3 md:py-4 rounded-full font-semibold inline-block hover:bg-white hover:text-gpla-navy transition-all">
                Partner With Us
              </a>
            </div>
            <p class="text-gpla-gold text-sm font-mono">#TheGuildLeadersSummit2026 · #GPLASummit</p>
          </div>
          <div class="hidden lg:block text-center relative">
            <div class="font-display text-[200px] text-gpla-gold/20 leading-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">2026</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Countdown Timer -->
    <section class="px-4 md:px-12 py-12 bg-gpla-navy">
      <div class="max-w-4xl mx-auto">
        <p class="text-gpla-green text-sm font-semibold uppercase tracking-widest mb-8 text-center">COUNTDOWN TO THE SUMMIT</p>
        <div class="countdown-grid">
          <div class="countdown-unit">
            <span id="count-days" class="countdown-number">00</span>
            <span class="countdown-label">Days</span>
          </div>
          <div class="countdown-unit">
            <span id="count-hours" class="countdown-number">00</span>
            <span class="countdown-label">Hours</span>
          </div>
          <div class="countdown-unit">
            <span id="count-mins" class="countdown-number">00</span>
            <span class="countdown-label">Minutes</span>
          </div>
          <div class="countdown-unit">
            <span id="count-secs" class="countdown-number">00</span>
            <span class="countdown-label">Seconds</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Summit Details -->
    <section class="px-4 md:px-12 py-16 md:py-24 bg-[var(--bg-section-alt)]">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16">
        <div>
          <h2 class="font-display text-gpla-navy text-[32px] md:text-[48px] mb-8">EVENT DETAILS</h2>
          <div class="space-y-6">
            <div class="border-l-4 border-gpla-green pl-4">
              <h4 class="font-semibold text-gpla-navy text-lg">Date</h4>
              <p class="text-[var(--text-muted)]">23rd – 24th July 2026</p>
            </div>
            <div class="border-l-4 border-gpla-green pl-4">
              <h4 class="font-semibold text-gpla-navy text-lg">Venue</h4>
              <p class="text-[var(--text-muted)]">Freedom Square, Makerere University, Kampala</p>
            </div>
            <div class="border-l-4 border-gpla-green pl-4">
              <h4 class="font-semibold text-gpla-navy text-lg">Chief Guest</h4>
              <p class="text-[var(--text-muted)]">H.E. Yoweri Kaguta Museveni<br/>President of the Republic of Uganda & Chairperson of the EAC</p>
            </div>
            <div class="border-l-4 border-gpla-green pl-4">
              <h4 class="font-semibold text-gpla-navy text-lg">Partners</h4>
              <div class="flex gap-4 mt-2">
                <div class="bg-gpla-navy text-white px-4 py-2 rounded font-display text-sm">IGDS</div>
                <div class="bg-gpla-navy text-white px-4 py-2 rounded font-display text-sm">UNiFOG</div>
              </div>
            </div>
          </div>
        </div>
        <div class="flex items-center">
          <div class="bg-gpla-navy p-8 md:p-12 rounded-xl w-full">
            <p class="text-gpla-gold font-display text-2xl md:text-3xl italic leading-relaxed">
              "Youth Leadership, Production, and Regional Integration: Building a Competitive East Africa in a Changing Global Order"
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Focus Areas -->
    <section class="px-4 md:px-12 py-16 md:py-24">
      <div class="max-w-6xl mx-auto">
        <h2 class="font-display text-gpla-navy text-[32px] md:text-[48px] text-center mb-12">FOCUS AREAS</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="focus-card bg-[var(--bg-section-alt)] p-6 md:p-8 rounded-xl hover:shadow-xl transition-all" data-animate data-delay="0">
            <span class="text-gpla-green font-display text-3xl">01</span>
            <h4 class="font-semibold text-gpla-navy text-lg mt-3">Political and Economic Integration</h4>
          </div>
          <div class="focus-card bg-[var(--bg-section-alt)] p-6 md:p-8 rounded-xl hover:shadow-xl transition-all" data-animate data-delay="100">
            <span class="text-gpla-green font-display text-3xl">02</span>
            <h4 class="font-semibold text-gpla-navy text-lg mt-3">Youth, Production and Industrial Transformation</h4>
          </div>
          <div class="focus-card bg-[var(--bg-section-alt)] p-6 md:p-8 rounded-xl hover:shadow-xl transition-all" data-animate data-delay="200">
            <span class="text-gpla-green font-display text-3xl">03</span>
            <h4 class="font-semibold text-gpla-navy text-lg mt-3">Regional Markets, Trade and Economic Opportunities</h4>
          </div>
          <div class="focus-card bg-[var(--bg-section-alt)] p-6 md:p-8 rounded-xl hover:shadow-xl transition-all" data-animate data-delay="300">
            <span class="text-gpla-green font-display text-3xl">04</span>
            <h4 class="font-semibold text-gpla-navy text-lg mt-3">Sports Diplomacy and Regional Integration (AFCON 2027)</h4>
          </div>
          <div class="focus-card bg-[var(--bg-section-alt)] p-6 md:p-8 rounded-xl hover:shadow-xl transition-all" data-animate data-delay="400">
            <span class="text-gpla-green font-display text-3xl">05</span>
            <h4 class="font-semibold text-gpla-navy text-lg mt-3">Technology, Innovation and the Digital Economy</h4>
          </div>
          <div class="focus-card bg-[var(--bg-section-alt)] p-6 md:p-8 rounded-xl hover:shadow-xl transition-all" data-animate data-delay="500">
            <span class="text-gpla-green font-display text-3xl">06</span>
            <h4 class="font-semibold text-gpla-navy text-lg mt-3">Education, Mobility and Knowledge Integration</h4>
          </div>
        </div>
      </div>
    </section>

    <!-- Luma Event Embed — centered, nicely sized -->
    <section class="bg-gpla-navy px-4 md:px-12 py-16 md:py-24">
      <div class="max-w-5xl mx-auto text-center">
        <span class="bg-gpla-gold text-gpla-navy text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full inline-block mb-4">Register on Luma</span>
        <h2 class="font-display text-white text-[32px] md:text-[48px] mb-3">SECURE YOUR SPOT</h2>
        <p class="text-white/60 text-base mb-8 max-w-xl mx-auto">
          Confirm your participation for the 3rd Annual East African Guild Leaders' Summit. Registration is via Luma.
        </p>
        <div class="luma-embed-wrapper bg-white/5 rounded-xl overflow-hidden border border-white/10">
          <iframe
            src="https://luma.com/embed/event/evt-jz3DM2lZIpMEaV1/simple"
            frameborder="0"
            style="display: block; border: none; width: 100%; height: 520px !important;"
            allow="fullscreen; payment"
            aria-hidden="false"
            tabindex="0"
          ></iframe>
        </div>
      </div>
    </section>

    <!-- Speaker Applications CTA -->
    <!-- Special Invitation Form -->
    <section id="special-invitation" class="bg-gpla-gold py-20 px-4 md:px-12">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <span class="bg-gpla-navy text-white text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full inline-block mb-4">By Invitation Only</span>
          <h2 class="font-display text-gpla-navy text-[40px] md:text-[56px] mb-3">SPECIAL INVITATION</h2>
          <p class="text-gpla-navy/70 text-lg max-w-2xl mx-auto">
            You are cordially invited to the <strong>3rd Annual East African Guild Leaders' Summit</strong>. Kindly confirm your attendance by filling the form below.
          </p>
        </div>
        <div class="bg-white/90 backdrop-blur-sm p-6 md:p-10 rounded-xl shadow-xl border border-gpla-navy/10">
          <form method="POST" action="https://formspree.io/f/mrbpnnaz">
            <input type="hidden" name="form-name" value="special-invitation" />
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label class="block text-gpla-navy text-sm font-semibold mb-1.5">Full Name <span class="text-red-500">*</span></label>
                <input type="text" name="full_name" placeholder="e.g. Mutesa II of Buganda" required class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:border-gpla-green focus:ring-2 focus:ring-gpla-green/20 transition-all" />
              </div>
              <div>
                <label class="block text-gpla-navy text-sm font-semibold mb-1.5">Country <span class="text-red-500">*</span></label>
                <select name="country" required class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:border-gpla-green focus:ring-2 focus:ring-gpla-green/20 transition-all">
                  <option value="">Select your country</option>
                  <option value="Uganda">Uganda</option>
                  <option value="Kenya">Kenya</option>
                  <option value="Tanzania">Tanzania</option>
                  <option value="Rwanda">Rwanda</option>
                  <option value="Burundi">Burundi</option>
                  <option value="South Sudan">South Sudan</option>
                  <option value="DR Congo">DR Congo</option>
                  <option value="Ethiopia">Ethiopia</option>
                  <option value="Somalia">Somalia</option>
                  <option value="Other">Other</option>
                </select>
              </div>
              <div>
                <label class="block text-gpla-navy text-sm font-semibold mb-1.5">National ID / Passport Number <span class="text-red-500">*</span></label>
                <input type="text" name="national_id" placeholder="e.g. CM12345678 or UG1234567" required class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:border-gpla-green focus:ring-2 focus:ring-gpla-green/20 transition-all" />
              </div>
              <div>
                <label class="block text-gpla-navy text-sm font-semibold mb-1.5">Profession <span class="text-red-500">*</span></label>
                <input type="text" name="profession" placeholder="e.g. Student Leader, Lawyer, Policy Analyst" required class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:border-gpla-green focus:ring-2 focus:ring-gpla-green/20 transition-all" />
              </div>
              <div class="md:col-span-2">
                <label class="block text-gpla-navy text-sm font-semibold mb-1.5">Institution / Organization <span class="text-red-500">*</span></label>
                <input type="text" name="institution" placeholder="e.g. Makerere University, Parliament of Uganda, UNDP" required class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:border-gpla-green focus:ring-2 focus:ring-gpla-green/20 transition-all" />
              </div>
              <div class="md:col-span-2">
                <label class="block text-gpla-navy text-sm font-semibold mb-1.5">Email Address <span class="text-red-500">*</span></label>
                <input type="email" name="email" placeholder="you@example.com" required class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:border-gpla-green focus:ring-2 focus:ring-gpla-green/20 transition-all" />
              </div>
              <div class="md:col-span-2">
                <label class="block text-gpla-navy text-sm font-semibold mb-1.5">Phone Number (with country code)</label>
                <input type="tel" name="phone" placeholder="e.g. +256 779 011 22" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:border-gpla-green focus:ring-2 focus:ring-gpla-green/20 transition-all" />
              </div>
              <div class="md:col-span-2">
                <label class="block text-gpla-navy text-sm font-semibold mb-1.5">Additional Notes / Dietary Requirements</label>
                <textarea name="notes" placeholder="Any special accommodations, dietary restrictions, or questions..." rows="3" class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:border-gpla-green focus:ring-2 focus:ring-gpla-green/20 transition-all"></textarea>
              </div>
            </div>
            <div class="mt-8 text-center">
              <button type="submit" class="bg-gpla-navy text-white px-10 py-4 rounded-full font-bold text-base inline-block hover:shadow-xl hover:-translate-y-0.5 transition-all min-w-[240px]">
                Confirm My Attendance →
              </button>
              <p class="text-gpla-navy/50 text-xs mt-3">Responses will be sent to GPLA Summit Secretariat</p>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- Speaker Applications CTA -->
    <section class="bg-gpla-navy py-20 px-4 md:px-12">
      <div class="container mx-auto text-center">
        <h2 class="font-display text-white text-[40px] md:text-[56px] mb-4">
          APPLY TO SPEAK
        </h2>
        <p class="text-white/70 text-lg mb-8 max-w-2xl mx-auto">
          Are you a policymaker, entrepreneur, academic, or regional leader with a message for East Africa's next generation? Apply to address the 3rd Annual East African Guild Leaders' Summit.
        </p>
        <a href="https://lu.ma/5tuheo2m" target="_blank" rel="noopener noreferrer" class="bg-gpla-gold text-gpla-navy px-8 py-4 rounded-full font-semibold inline-block hover:shadow-xl hover:-translate-y-0.5 transition-all">
          Apply via Luma →
        </a>
      </div>
    </section>

    <!-- Partner With Us -->
    <section id="partner" class="bg-gpla-navy py-20 px-4 md:px-12">
      <div class="container mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16 items-start">
          <div>
            <h2 class="font-display text-white text-[40px] md:text-[56px] mb-6">
              PARTNER WITH US
            </h2>
            <p class="text-white/70 text-lg mb-6">
              Align your organisation with East Africa's premier youth leadership platform. The 2026 Summit will convene heads of state, regional institutions, and 700+ student leaders from across the EAC.
            </p>
            <ul class="space-y-3 text-white/80 mb-8">
              <li class="flex items-center gap-3"><span class="text-gpla-green text-xl">✓</span> Brand visibility across 6 East African countries</li>
              <li class="flex items-center gap-3"><span class="text-gpla-green text-xl">✓</span> Direct access to emerging youth leaders</li>
              <li class="flex items-center gap-3"><span class="text-gpla-green text-xl">✓</span> Co-branding on Summit materials and reports</li>
              <li class="flex items-center gap-3"><span class="text-gpla-green text-xl">✓</span> Panel and speaking opportunities</li>
            </ul>
            <div class="partner-embed bg-white/5 rounded-xl overflow-hidden border border-white/10 max-w-[500px]">
              <iframe
                src="https://luma.com/embed/event/evt-jz3DM2lZIpMEaV1/simple"
                frameborder="0"
                style="display: block; border: none; width: 100%; height: 400px !important;"
                allow="fullscreen; payment"
                aria-hidden="false"
                tabindex="0"
              ></iframe>
            </div>
          </div>
          <div class="bg-white/5 p-6 md:p-8 rounded-xl">
            <h3 class="text-white font-display text-2xl mb-6">
              APPLY TO PARTNER
            </h3>
            <form method="POST" action="https://formspree.io/f/mrbpnnaz">
              <input type="hidden" name="form-name" value="summit-2026-partner" />
              <div class="space-y-4">
                <input type="text" name="organisation" placeholder="Organisation Name" required class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:border-gpla-green" />
                <input type="text" name="contact_person" placeholder="Contact Person" required class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:border-gpla-green" />
                <input type="email" name="email" placeholder="Email Address" required class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:border-gpla-green" />
                <select name="partnership_type" class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white focus:outline-none focus:border-gpla-green">
                  <option value="" class="text-gpla-navy">Select Partnership Type</option>
                  <option value="Lead Partner" class="text-gpla-navy">Lead Partner</option>
                  <option value="Gold Partner" class="text-gpla-navy">Gold Partner</option>
                  <option value="Silver Partner" class="text-gpla-navy">Silver Partner</option>
                  <option value="Media Partner" class="text-gpla-navy">Media Partner</option>
                  <option value="Academic Partner" class="text-gpla-navy">Academic Partner</option>
                </select>
                <textarea name="message" placeholder="Tell us about your organisation and interest in partnering" rows="4" class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:border-gpla-green"></textarea>
                <button type="submit" class="w-full bg-gpla-green text-white px-8 py-4 rounded-full font-semibold hover:shadow-xl hover:-translate-y-0.5 transition-all">
                  Submit Partnership Application →
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- Register Interest CTA -->
    <section id="register" class="bg-gpla-green px-4 md:px-12 py-16 md:py-24">
      <div class="max-w-6xl mx-auto text-center">
        <h2 class="font-display text-white text-[40px] md:text-[56px] mb-4">REGISTER ON LUMA</h2>
        <p class="text-white/80 text-lg mb-8 max-w-xl mx-auto">
          Click the button below to register for the 3rd Annual East African Guild Leaders' Summit via Luma.
        </p>
        <a href="https://lu.ma/5tuheo2m" target="_blank" rel="noopener noreferrer" class="bg-white text-gpla-navy px-10 py-5 rounded-full font-bold text-lg inline-block hover:shadow-xl hover:-translate-y-0.5 transition-all">
          Apply to Join on Luma →
        </a>
      </div>
    </section>

    <Footer />
  </div>
</Base>

<script>
  // Countdown to July 23, 2026 08:00 EAT (UTC+3)
  const target = new Date('2026-07-23T05:00:00Z');
  function updateCountdown() {
    const now = new Date();
    const diff = target - now;
    if (diff <= 0) {
      document.querySelectorAll('.countdown-number').forEach(el => { el.textContent = '00'; });
      return;
    }
    const days = Math.floor(diff / 86400000);
    const hours = Math.floor((diff % 86400000) / 3600000);
    const mins = Math.floor((diff % 3600000) / 60000);
    const secs = Math.floor((diff % 60000) / 1000);
    const update = (id, val) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(val).padStart(2, '0');
    };
    update('count-days', days);
    update('count-hours', hours);
    update('count-mins', mins);
    update('count-secs', secs);
  }
  setInterval(updateCountdown, 1000);
  updateCountdown();

  // Scroll animations
  const animateOnScroll = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const delay = parseInt(entry.target.dataset.delay) || 0;
        setTimeout(() => {
          entry.target.classList.add('animate-in');
        }, delay);
        animateOnScroll.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('[data-animate]').forEach(el => animateOnScroll.observe(el));
</script>
