---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PatternDivider from '../components/PatternDivider.astro';
import PatternBackdrop from '../components/PatternBackdrop.astro';
import { executiveDirector, teamMembers } from '../data/site';
import { socialLinkIcons } from '../data/social-icons';
---

<Base title="About" description="Learn about the Guild Presidents Leadership Academy - East Africa's premier youth leadership institution.">
  <Navbar />
  
  <!-- Hero — light with image -->
  <section class="min-h-[40vh] bg-gpla-navy section-padding relative overflow-hidden flex items-center" style="padding-top: 8rem;">
    <div class="absolute inset-0 z-0">
      <img src="/assets/images/gallery/025.jpg" alt="" class="w-full h-full object-cover opacity-25" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-gpla-navy/90 via-gpla-navy/70 to-gpla-navy/50"></div>
    <div class="african-hero-overlay"></div>
    <div class="section-container relative z-10 w-full">
      <p class="section-label section-label--gold" data-animate>About Us</p>
      <h1 class="font-display text-white text-[clamp(2.5rem,7vw,4.5rem)] leading-[0.95]" data-animate data-delay="100">
        Ethical Leaders<br />
        Transforming East Africa
      </h1>
    </div>
  </section>

  <PatternDivider />

  <!-- About Content -->
  <section class="section-padding section-light section-kente-surface">
    <div class="section-container">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-20">
        <div class="lg:col-span-3" data-animate>
          <span class="section-label" data-animate>Who We Are</span>
          <span class="accent-line" data-animate></span>
          <h2 class="section-title text-gpla-navy mb-6" data-animate data-delay="100">Shaping East Africa's Future Leaders</h2>
          <div class="space-y-5 text-gpla-navy/75 text-base leading-relaxed font-body" style="text-align: justify;" data-animate data-delay="150">
            <p>The Guild Presidents Leadership Academy (GPLA) is a non-partisan leadership development and regional convening platform committed to nurturing ethical, visionary and transformational leaders across East Africa.</p>
            <p>Established from the recognition that university guild leaders are an important foundation for future public, private and civic leadership, GPLA equips emerging leaders with the knowledge, values, networks and practical skills required to serve society responsibly and effectively.</p>
            <p>Through leadership training, mentorship, policy dialogue, regional summits, research, institutional partnerships and community-based initiatives, GPLA brings together young leaders, governments, universities, development partners, the private sector and experienced statespersons to address critical governance and development challenges.</p>
            <p>While university and student leadership remain central to our identity, GPLA's work has expanded to include public leadership, regional integration, innovation, entrepreneurship, civic participation, institutional development and sustainable socio-economic transformation.</p>
            <p>GPLA is headquartered in Uganda and works across East Africa to build bridges between generations, institutions and countries, transforming youthful leadership potential into responsible service, practical solutions and lasting regional impact.</p>
          </div>
        </div>
        <div class="lg:col-span-2" data-animate data-delay="100">
          <div class="bg-gradient-to-br from-gpla-navy to-[#1a3d6e] p-8 md:p-10 rounded-2xl african-quote-frame">
            <img
              src={executiveDirector.photo}
              alt={executiveDirector.photoAlt}
              width="160"
              height="200"
              class="w-32 sm:w-36 rounded-xl object-cover object-top border-2 border-gpla-gold/30 mb-6"
              loading="lazy"
            />
            <p class="text-white text-base md:text-lg italic leading-relaxed font-body">
              &ldquo;{executiveDirector.quote}&rdquo;
            </p>
            <cite class="block mt-5 text-gpla-gold text-sm not-italic font-display tracking-wide leading-snug">
              — {executiveDirector.attribution}
            </cite>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vision & Mission -->
  <section class="section-padding section-dark section-kente-surface">
    <div class="section-container section-container--narrow">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20">
        <div data-animate>
          <div class="w-16 h-1.5 bg-gpla-green rounded-full mb-6"></div>
          <h2 class="font-display text-gpla-navy text-2xl md:text-[32px] mb-4 tracking-wider">Our Vision</h2>
          <p class="text-gpla-navy/70 text-lg font-body" style="text-align: justify;">
            A generation of ethical and visionary leaders transforming East Africa.
          </p>
        </div>
        <div data-animate data-delay="100">
          <div class="w-16 h-1.5 bg-gpla-gold rounded-full mb-6"></div>
          <h2 class="font-display text-gpla-navy text-2xl md:text-[32px] mb-4 tracking-wider">Our Mission</h2>
          <p class="text-gpla-navy/70 text-lg font-body" style="text-align: justify;">
            To develop, connect and inspire young leaders while advancing good governance, regional integration, innovation and sustainable development.
          </p>
        </div>
      </div>
    </div>
  </section>

  <PatternDivider />

  <!-- Strategic Objectives -->
  <section class="section-padding section-light section-kente-surface relative overflow-hidden">
    <div class="absolute inset-x-0 top-0 african-kente-band pointer-events-none" style="height: 12px;" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 african-kente-band pointer-events-none" style="height: 12px;" aria-hidden="true"></div>
    <div class="section-container">
      <div class="text-center mb-12" data-animate>
        <span class="section-label">Our Focus</span>
        <h2 class="section-title section-title--centered text-gpla-navy">Strategic Objectives</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6" data-animate data-delay="100">
        {[
          'Promote youth participation in the East African integration agenda.',
          'Strengthen cooperation among university student leaders across the region.',
          "Build young leaders' understanding of regional institutions, diplomacy and governance.",
          'Facilitate dialogue between young people, governments, universities and the private sector.',
          'Develop a sustainable network of emerging East African leaders.',
          'Generate youth-led recommendations on regional policy and development.',
        ].map((text, i) => (
          <div class={`objective-card african-corner-accent accent-${['navy', 'green', 'gold', 'green', 'gold', 'navy'][i]}`}>
            <div class="objective-card__kente" aria-hidden="true"></div>
            <span class="objective-card__num">{String(i + 1).padStart(2, '0')}</span>
            <p class="text-gpla-navy/70 leading-relaxed font-body">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <PatternDivider />

  <!-- Programs summary (formerly Key Activities) -->
  <section class="section-padding section-dark section-kente-surface">
    <div class="section-container">
      <div class="text-center mb-12" data-animate>
        <span class="section-label">What We Do</span>
        <h2 class="section-title section-title--centered text-gpla-navy">Our Programs</h2>
        <p class="section-subtitle mx-auto mt-4 font-body" style="max-width: 600px; text-align: center;">
          Four flagship programmes shaping the next generation of ethical, transformational leaders across East Africa.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6" data-animate data-delay="100">
        <a href="/programs" class="bg-white border border-gpla-navy/8 p-6 md:p-8 rounded-xl shadow-sm african-corner-accent card-lift block group">
          <span class="font-display text-gpla-green text-sm tracking-wider mb-3 block">01</span>
          <h3 class="font-display text-gpla-navy text-lg md:text-xl mb-3 leading-snug">East African Guild Leaders Summit</h3>
          <p class="text-gpla-navy/60 text-sm font-body leading-relaxed">Advancing youth leadership and East African integration through the premier regional convening platform.</p>
          <span class="text-gpla-green font-semibold text-sm mt-4 inline-block group-hover:translate-x-1 transition-transform">Learn more →</span>
        </a>
        <a href="/programs" class="bg-white border border-gpla-navy/8 p-6 md:p-8 rounded-xl shadow-sm african-corner-accent card-lift block group">
          <span class="font-display text-gpla-green text-sm tracking-wider mb-3 block">02</span>
          <h3 class="font-display text-gpla-navy text-lg md:text-xl mb-3 leading-snug">Uganda National Science Park &amp; Innovation Area Initiative</h3>
          <p class="text-gpla-navy/60 text-sm font-body leading-relaxed">Harnessing youth innovation for production and national transformation.</p>
          <span class="text-gpla-green font-semibold text-sm mt-4 inline-block group-hover:translate-x-1 transition-transform">Learn more →</span>
        </a>
        <a href="/programs" class="bg-white border border-gpla-navy/8 p-6 md:p-8 rounded-xl shadow-sm african-corner-accent card-lift block group">
          <span class="font-display text-gpla-green text-sm tracking-wider mb-3 block">03</span>
          <h3 class="font-display text-gpla-navy text-lg md:text-xl mb-3 leading-snug">GPLA Executive Master Classes</h3>
          <p class="text-gpla-navy/60 text-sm font-body leading-relaxed">Developing ethical, strategic and transformational leaders through high-level programmes.</p>
          <span class="text-gpla-green font-semibold text-sm mt-4 inline-block group-hover:translate-x-1 transition-transform">Learn more →</span>
        </a>
        <a href="/programs" class="bg-white border border-gpla-navy/8 p-6 md:p-8 rounded-xl shadow-sm african-corner-accent card-lift block group">
          <span class="font-display text-gpla-green text-sm tracking-wider mb-3 block">04</span>
          <h3 class="font-display text-gpla-navy text-lg md:text-xl mb-3 leading-snug">Guild Leadership Development &amp; Mentorship Programme</h3>
          <p class="text-gpla-navy/60 text-sm font-body leading-relaxed">Preparing student leaders for responsible service and future leadership.</p>
          <span class="text-gpla-green font-semibold text-sm mt-4 inline-block group-hover:translate-x-1 transition-transform">Learn more →</span>
        </a>
      </div>
    </div>
  </section>

  <PatternDivider bold />

  <!-- Team -->
  <section class="section-padding section-light section-kente-surface">
    <div class="section-container">
      <div class="text-center mb-12" data-animate>
        <span class="section-label">Leadership</span>
        <h2 class="section-title section-title--centered text-gpla-navy">Our Team</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 md:gap-10">
        <div class="group african-zigzag-top" data-animate>
          <div class="aspect-[3/4] rounded-2xl mb-5 overflow-hidden relative bg-gray-100">
            <img
              src={executiveDirector.photo}
              alt={executiveDirector.photoAlt}
              class="w-full h-full object-cover object-top"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-all"></div>
          </div>
          <div>
            <h3 class="font-display text-2xl text-gpla-navy">{executiveDirector.name}</h3>
            <p class="text-gpla-navy/60 text-sm font-body">{executiveDirector.title}</p>
            <p class="text-gpla-navy/60 text-xs mt-2 font-body leading-relaxed">
              Guild Presidents Leadership Academy
            </p>
          </div>
        </div>
        {teamMembers.map((member, index) => (
          <div class="group african-zigzag-top" data-animate data-delay={(index + 1) * 100}>
            <div class={`aspect-[3/4] rounded-2xl mb-5 overflow-hidden relative ${member.photo ? 'bg-gray-100' : 'bg-gradient-to-br from-gpla-green/20 to-gpla-navy/10'}`}>
              {member.photo ? (
                <>
                  <img
                    src={member.photo}
                    alt={member.photoAlt ?? member.name}
                    class="w-full h-full object-cover object-top"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-all"></div>
                </>
              ) : (
                <div class="w-full h-full flex items-center justify-center">
                  <span class="font-display text-gpla-navy/15 text-6xl">{member.initials}</span>
                </div>
              )}
            </div>
            <div>
              <h3 class="font-display text-2xl text-gpla-navy">{member.name}</h3>
              <p class="text-gpla-navy/60 text-sm font-body">{member.title}</p>
              {member.bio && (
                <div class="mt-3 space-y-3 text-gpla-navy/70 text-sm font-body leading-relaxed">
                  {member.bio.split('\n\n').map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              )}
              {((member.socials && member.socials.length > 0) || member.email) && (
                <div class="flex flex-wrap items-center gap-2 mt-4">
                  {member.socials?.map((social) => (
                    <a
                      href={social.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-9 h-9 rounded-full bg-gpla-navy/8 text-gpla-navy flex items-center justify-center hover:bg-gpla-green hover:text-white transition-all duration-300"
                      aria-label={`${member.name} on ${social.label}`}
                    >
                      <Fragment set:html={socialLinkIcons[social.label]} />
                    </a>
                  ))}
                  {member.email && (
                    <a
                      href={`mailto:${member.email}`}
                      class="w-9 h-9 rounded-full bg-gpla-navy/8 text-gpla-navy flex items-center justify-center hover:bg-gpla-green hover:text-white transition-all duration-300"
                      aria-label={`Email ${member.name}`}
                    >
                      <Fragment set:html={socialLinkIcons.Email} />
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Base>
