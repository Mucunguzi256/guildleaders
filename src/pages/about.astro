---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = "About";
const description = "Learn about the Guild Presidents Leadership Academy - East Africa's premier youth leadership institution.";
---

<Base title={title} description={description}>
  <Navbar />
  
  <!-- Hero -->
  <section class="min-h-[50vh] md:min-h-[55vh] bg-gpla-navy section-padding relative overflow-hidden flex items-center" style="padding-top: 8rem;">
    <div class="absolute bottom-0 right-0 w-[45%] h-full bg-gpla-green" style="clip-path: polygon(20% 0, 100% 0, 100% 100%, 0% 100%);"></div>
    <div class="section-container relative z-10 w-full">
      <p class="section-label section-label--gold" data-animate>About Us</p>
      <h1 class="font-display text-white text-[clamp(2.5rem,7vw,5rem)] leading-[0.95]" data-animate data-delay="100">
        Ethical Leaders<br />
        Transforming East Africa
      </h1>
    </div>
  </section>

  <!-- Content -->
  <section class="section-padding section-dark">
    <div class="section-container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20">
        <div>
          <span class="section-label section-label--gold" data-animate>About Us</span>
          <span class="accent-line" data-animate></span>
          <h2 class="section-title text-white mb-6" data-animate data-delay="100">Shaping East Africa's Future Leaders</h2>
          <div class="content-text" style="text-align: justify;" data-animate data-delay="150">
          The Guild Presidents Leadership Academy (GPLA) is a non-partisan leadership development and regional convening platform committed to nurturing ethical, visionary and transformational leaders across East Africa.
        </p>
        <p class="text-gray-600 leading-relaxed mb-6" style="text-align: justify;">
          Established from the recognition that university guild leaders are an important foundation for future public, private and civic leadership, GPLA equips emerging leaders with the knowledge, values, networks and practical skills required to serve society responsibly and effectively.
        </p>
        <p class="text-gray-600 leading-relaxed" style="text-align: justify;">
          Through leadership training, mentorship, policy dialogue, regional summits, research, institutional partnerships and community-based initiatives, GPLA brings together young leaders, governments, universities, development partners, the private sector and experienced statespersons to address critical governance and development challenges.
        </p>
        <p class="text-gray-600 leading-relaxed mt-6" style="text-align: justify;">
          While university and student leadership remain central to our identity, GPLA's work has expanded to include public leadership, regional integration, innovation, entrepreneurship, civic participation, institutional development and sustainable socio-economic transformation.
        </p>
        <p class="text-gray-600 leading-relaxed mt-6" style="text-align: justify;">
          GPLA is headquartered in Uganda and works across East Africa to build bridges between generations, institutions and countries, transforming youthful leadership potential into responsible service, practical solutions and lasting regional impact.
        </p>
      </div>
      <div>
        <div class="bg-gpla-navy p-8 md:p-10 rounded-xl">
          <p class="text-white text-lg md:text-2xl italic mb-6">"History has been made."</p>
          <cite class="text-gpla-gold not-italic block">— Demiano Masesa<br />Executive Director, GPLA</cite>
        </div>
      </div>
    </div>
  </section>

  <!-- Vision & Mission -->
  <section class="section-padding section-alt border-t border-white/5">
    <div class="section-container section-container--narrow">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20">
        <div data-animate>
          <div class="w-16 h-1.5 bg-gpla-green rounded-full mb-6"></div>
          <h2 class="font-display text-white text-2xl md:text-[32px] mb-4 tracking-wider">Our Vision</h2>
          <p class="content-text text-lg" style="text-align: justify;">
            A generation of ethical and visionary leaders transforming East Africa.
          </p>
        </div>
        <div data-animate data-delay="100">
          <div class="w-16 h-1.5 bg-gpla-gold rounded-full mb-6"></div>
          <h2 class="font-display text-white text-2xl md:text-[32px] mb-4 tracking-wider">Our Mission</h2>
          <p class="content-text text-lg" style="text-align: justify;">
            To develop, connect and inspire young leaders while advancing good governance, regional integration, innovation and sustainable development.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Strategic Objectives -->
  <section class="section-padding section-dark border-t border-white/5">
    <div class="section-container">
      <div class="text-center mb-12" data-animate>
        <span class="section-label section-label--gold">Our Focus</span>
        <h2 class="section-title section-title--centered text-white">Strategic Objectives</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6" data-animate data-delay="100">
        <div class="card p-6 md:p-8">
          <div class="text-gpla-green text-2xl mb-3">🌍</div>
          <p class="text-gray-700 leading-relaxed">Promote youth participation in the East African integration agenda.</p>
        </div>
        <div class="card p-6 md:p-8">
          <div class="text-gpla-gold text-2xl mb-3">🤝</div>
          <p class="text-white/70 leading-relaxed">Strengthen cooperation among university student leaders across the region.</p>
        </div>
        <div class="card p-6 md:p-8">
          <div class="text-gpla-gold text-2xl mb-3">🎓</div>
          <p class="text-white/70 leading-relaxed">Build young leaders' understanding of regional institutions, diplomacy and governance.</p>
        </div>
        <div class="card p-6 md:p-8">
          <div class="text-gpla-gold text-2xl mb-3">💬</div>
          <p class="text-white/70 leading-relaxed">Facilitate dialogue between young people, governments, universities and the private sector.</p>
        </div>
        <div class="card p-6 md:p-8">
          <div class="text-gpla-gold text-2xl mb-3">🔗</div>
          <p class="text-white/70 leading-relaxed">Develop a sustainable network of emerging East African leaders.</p>
        </div>
        <div class="card p-6 md:p-8">
          <div class="text-gpla-gold text-2xl mb-3">📋</div>
          <p class="text-white/70 leading-relaxed">Generate youth-led recommendations on regional policy and development.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Activities -->
  <section class="section-padding section-alt border-t border-white/5">
    <div class="section-container">
      <div class="text-center mb-12" data-animate>
        <span class="section-label section-label--gold">What We Do</span>
        <h2 class="section-title section-title--centered text-white">Key Activities</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6" data-animate data-delay="100">
        <div class="card p-6 md:p-8 text-center">
          <div class="text-gpla-gold text-3xl mb-4">🎤</div>
          <h3 class="font-display text-white text-xl mb-2">Annual Summit</h3>
          <p class="text-white/70 text-sm">Annual East African Guild Leaders Summit</p>
        </div>
        <div class="bg-white/10 backdrop-blur-sm p-6 md:p-8 rounded-xl border border-white/10 text-center">
          <div class="text-gpla-gold text-3xl mb-4">🗣️</div>
          <h3 class="font-display text-white text-xl mb-2">Leaders' Dialogues</h3>
          <p class="text-white/70 text-sm">University leaders' dialogues</p>
        </div>
        <div class="bg-white/10 backdrop-blur-sm p-6 md:p-8 rounded-xl border border-white/10 text-center">
          <div class="text-gpla-gold text-3xl mb-4">🏛️</div>
          <h3 class="font-display text-white text-xl mb-2">Policy Panels</h3>
          <p class="text-white/70 text-sm">High-level policy panels</p>
        </div>
        <div class="bg-white/10 backdrop-blur-sm p-6 md:p-8 rounded-xl border border-white/10 text-center">
          <div class="text-gpla-gold text-3xl mb-4">🔄</div>
          <h3 class="font-display text-white text-xl mb-2">Leadership Exchanges</h3>
          <p class="text-white/70 text-sm">Regional student leadership exchanges</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="section-padding section-dark border-t border-white/5">
    <div class="section-container">
      <div class="text-center mb-12" data-animate>
        <span class="section-label section-label--gold">Leadership</span>
        <h2 class="section-title section-title--centered text-white">Our Team</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <div class="group">
          <div class="aspect-[3/4] bg-gradient-to-br from-gpla-navy to-gpla-green rounded-2xl mb-5 overflow-hidden relative">
            <div class="w-full h-full flex items-center justify-center">
              <span class="font-display text-white/20 text-6xl">DM</span>
            </div>
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-all"></div>
          </div>
          <div>
            <h3 class="font-display text-2xl text-gpla-navy">Demiano Masesa</h3>
            <p class="text-gray-500 text-sm font-body">Executive Director</p>
            <p class="text-gray-400 text-xs mt-2 font-body leading-relaxed">"History has been made. We are building the next generation of ethical leaders."</p>
          </div>
        </div>
        <div class="group">
          <div class="aspect-[3/4] bg-gradient-to-br from-gpla-green to-gpla-navy rounded-2xl mb-5 overflow-hidden relative">
            <div class="w-full h-full flex items-center justify-center">
              <span class="font-display text-white/20 text-6xl">SK</span>
            </div>
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-all"></div>
          </div>
          <div>
            <h3 class="font-display text-2xl text-gpla-navy">Dr. Sarah Kemigisa</h3>
            <p class="text-gray-500 text-sm font-body">Programs Director</p>
            <p class="text-gray-400 text-xs mt-2 font-body leading-relaxed">Equipping young leaders with the skills to transform governance.</p>
          </div>
        </div>
        <div class="group">
          <div class="aspect-[3/4] bg-gradient-to-br from-gpla-navy to-gpla-gold rounded-2xl mb-5 overflow-hidden relative">
            <div class="w-full h-full flex items-center justify-center">
              <span class="font-display text-white/20 text-6xl">JO</span>
            </div>
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-all"></div>
          </div>
          <div>
            <h3 class="font-display text-2xl text-gpla-navy">James Ochieng</h3>
            <p class="text-gray-500 text-sm font-body">Operations Manager</p>
            <p class="text-gray-400 text-xs mt-2 font-body leading-relaxed">Ensuring excellence in delivery across all programs.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Base>