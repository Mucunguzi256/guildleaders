---
const base = '';
---

<footer class="bg-[#0A0F1E] text-white pt-16 md:pt-20 pb-8 border-t border-white/5">
  <div class="max-w-6xl mx-auto px-4 md:px-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 md:gap-12 mb-12">
      <div class="md:col-span-2">
        <img src="/images/gpla-logo-new.png" alt="Guild Leaders" class="h-16 md:h-20 w-auto mb-5" style="width: auto; height: 80px; background: white; border-radius: 8px; padding: 4px;" />
        <p class="text-white/60 text-sm leading-7 font-body max-w-md">
          Empowering ethical youth leaders for democratic transformation in East Africa through leadership training, mentorship, policy dialogue and regional summits.
        </p>
        <div class="flex gap-4 mt-6">
          <a href="#" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-gpla-green transition-all">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="#" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-gpla-green transition-all">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href="#" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-gpla-green transition-all">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.94 2C5.12 20 12 20 12 20s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98" fill="currentColor"/></svg>
          </a>
          <a href="#" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-gpla-green transition-all">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
        </div>
      </div>
      <div>
        <h5 class="font-display text-lg text-white mb-6 tracking-wider">Quick Links</h5>
        <div class="flex flex-col gap-3">
          <a href="/about" class="text-white/50 text-sm hover:text-gpla-green transition-colors font-body">About</a>
          <a href="/programs" class="text-white/50 text-sm hover:text-gpla-green transition-colors font-body">Programs</a>
          <a href="/summit" class="text-white/50 text-sm hover:text-gpla-green transition-colors font-body">Summit</a>
          <a href="/gallery" class="text-white/50 text-sm hover:text-gpla-green transition-colors font-body">Gallery</a>
          <a href="/news" class="text-white/50 text-sm hover:text-gpla-green transition-colors font-body">News</a>
          <a href="/contact" class="text-white/50 text-sm hover:text-gpla-green transition-colors font-body">Contact</a>
        </div>
      </div>
      <div>
        <h5 class="font-display text-lg text-white mb-6 tracking-wider">Contact</h5>
        <p class="text-white/50 text-sm leading-7 font-body">
          Plot 158 Observatory Hill<br />
          Makerere University, Kampala
        </p>
        <p class="text-white/50 text-sm mt-4 font-body">info@guildleaders.academy</p>
        <p class="text-white/50 text-sm font-body">+256 779 011 22</p>
        <div class="mt-6">
          <a href="/contact" class="inline-block px-6 py-3 border border-gpla-green text-gpla-green rounded-full text-sm font-display tracking-wider hover:bg-gpla-green hover:text-white transition-all">
            Get In Touch
          </a>
        </div>
      </div>
    </div>
    <div class="border-t border-white/5 pt-6 md:pt-8 text-center text-white/30 text-sm font-body">
      © 2026 Guild Presidents Leadership Academy. All rights reserved. | <a href="https://guildleaders.academy" class="hover:text-gpla-green transition-colors">guildleaders.academy</a>
    </div>
  </div>
</footer>