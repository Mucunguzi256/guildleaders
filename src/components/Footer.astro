---
import PatternRibbon from './PatternRibbon.astro';
import { contactEmail, socialLinks } from '../data/site';
import { socialLinkIcons } from '../data/social-icons';

const currentYear = new Date().getFullYear();
---
<PatternRibbon height={40} class="opacity-90" />

<footer class="footer-kente-bg relative overflow-hidden bg-[#0A0F1E] text-white pt-16 md:pt-24 pb-8">
  <div class="section-container relative z-[1]">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 md:gap-16 mb-12">
      <div class="md:col-span-2">
        <img src="/assets/images/logo-large.png" alt="Guild Leaders" class="h-14 md:h-[72px] w-auto mb-5" style="width: auto; height: 72px; background: white; border-radius: 8px; padding: 4px;" />
        <p class="text-white/50 text-sm leading-7 font-body max-w-md">
          Empowering ethical youth leaders for democratic transformation in East Africa through leadership training, mentorship, policy dialogue and regional summits.
        </p>
        <div class="flex gap-3 mt-6">
          {socialLinks.map((social) => (
            <a href={social.href} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/[0.06] flex items-center justify-center hover:bg-gpla-green hover:scale-110 transition-all duration-300" aria-label={social.label}>
              <Fragment set:html={socialLinkIcons[social.label]} />
            </a>
          ))}
        </div>
      </div>

      <div>
        <h5 class="font-display text-base text-white mb-6 tracking-wider">Quick Links</h5>
        <div class="flex flex-col gap-3">
          <a href="/about" class="text-white/45 text-sm hover:text-gpla-green transition-colors font-body">About</a>
          <a href="/programs" class="text-white/45 text-sm hover:text-gpla-green transition-colors font-body">Programs</a>
          <a href="/summit" class="text-white/45 text-sm hover:text-gpla-green transition-colors font-body">Summit</a>
          <a href="/gallery" class="text-white/45 text-sm hover:text-gpla-green transition-colors font-body">Gallery</a>
          <a href="/news" class="text-white/45 text-sm hover:text-gpla-green transition-colors font-body">Publications & Updates</a>
          <a href="/contact" class="text-white/45 text-sm hover:text-gpla-green transition-colors font-body">Contact</a>
        </div>
      </div>

      <div>
        <h5 class="font-display text-base text-white mb-6 tracking-wider">Contact</h5>
        <p class="text-white/45 text-sm leading-7 font-body">
          Plot 158 Observatory Hill<br />
          Makerere University, Kampala
        </p>
        <p class="text-white/45 text-sm mt-3 font-body">
          <a href={`mailto:${contactEmail}`} class="hover:text-gpla-green transition-colors">{contactEmail}</a>
        </p>
        <div class="mt-6">
          <a href="/contact" class="inline-flex items-center gap-2 px-5 py-2.5 border border-gpla-green/50 text-gpla-green rounded-full text-sm font-display tracking-wider hover:bg-gpla-green hover:text-white transition-all duration-300">
            Get In Touch
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>
    </div>
    <div class="border-t border-white/[0.08] pt-6 text-center text-white/45 text-xs font-body flex flex-col md:flex-row items-center justify-between gap-3">
      <span>© {currentYear} Guild Presidents Leadership Academy. All rights reserved.</span>
      <a href="https://guildleaders.academy" class="hover:text-gpla-green transition-colors">guildleaders.academy</a>
    </div>
  </div>
</footer>
