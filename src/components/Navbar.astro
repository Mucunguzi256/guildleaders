---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/programs', label: 'Programs' },
  { href: '/summit', label: 'Summit' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/news', label: 'Publications & Updates' },
  { href: '/contact', label: 'Contact' },
];
---

<div class="site-header">
  <nav id="navbar" class="h-20 md:h-24 bg-white/95 backdrop-blur-xl flex items-center justify-between px-6 md:px-12 border-b border-gpla-navy/8 shadow-sm">
    <a href="/" class="flex items-center shrink-0">
      <img src="/assets/images/logo-medium.png" alt="Guild Leaders" class="h-11 md:h-14 w-auto" />
    </a>
    
    <!-- Desktop Nav -->
    <div class="hidden md:flex gap-7 lg:gap-9 items-center">
      {links.map(link => (
        <a href={link.href} class="nav-link text-gpla-navy/75 hover:text-gpla-navy font-body text-[15px] font-medium tracking-wide hover:text-gpla-green transition-all duration-300">
          {link.label}
        </a>
      ))}
    </div>
    
    <!-- Desktop CTA -->
    <div class="hidden md:flex items-center">
      <a href="/contact" class="btn btn-primary text-sm px-6 py-3">
        Get In Touch
      </a>
    </div>
    
    <!-- Mobile Menu Toggle -->
    <button id="mobile-menu-btn" class="md:hidden p-2 text-gpla-navy" aria-label="Menu" aria-expanded="false">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Thin brand strip -->
  <div style="height: 3px; background: linear-gradient(90deg, #389a29 0%, #132d82 50%, #E8A33D 100%);"></div>
</div>

<!-- Mobile Menu -->
<div id="mobile-menu" class="fixed inset-0 bg-white/98 backdrop-blur-xl z-40 hidden" style="padding-top: 80px;">
  <div class="flex flex-col items-center justify-center h-full gap-8 -mt-16">
    {links.map(link => (
      <a href={link.href} class="text-gpla-navy font-display text-3xl md:text-4xl hover:text-gpla-green transition-colors tracking-wider">
        {link.label}
      </a>
    ))}
    <a href="/contact" class="btn btn-primary text-lg px-10 py-4 mt-4">
      Get In Touch
    </a>
  </div>
</div>

<style is:global>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
  }
  
  .nav-link {
    position: relative;
    padding-bottom: 2px;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--gpla-green, #389a29);
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav-link:hover::after {
    width: 100%;
  }
  
  #navbar {
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }
</style>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      const isHidden = mobileMenu.classList.contains('hidden');
      mobileMenu.classList.toggle('hidden', !isHidden);
      document.body.style.overflow = isHidden ? 'hidden' : '';
    });
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        document.body.style.overflow = '';
      });
    });
  }
</script>
