---
interface Props {
  heading: string;
  title: string;
  /** Line under the title, e.g. "PDF Document • 2.4 MB". */
  meta: string;
  href: string;
}

const { heading, title, meta, href } = Astro.props;
const ctaBase =
  'px-6 md:px-8 py-3 md:py-4 rounded-full font-semibold inline-flex items-center justify-center gap-2 transition-all text-sm md:text-base';
---

<section class="px-4 md:px-12 py-12 md:py-24 section-alt section-kente-surface">
  <div class="max-w-4xl mx-auto">
    <h2 class="font-display text-gpla-navy text-[28px] md:text-[48px] mb-6 md:mb-8">{heading}</h2>
    <div class="bg-white p-5 md:p-8 rounded-xl shadow-lg">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 md:gap-6 mb-6">
        <div class="w-16 h-16 bg-gpla-navy rounded-lg flex items-center justify-center">
          <span class="text-white font-display text-2xl">PDF</span>
        </div>
        <div>
          <h3 class="font-display text-2xl text-gpla-navy">{title}</h3>
          <p class="text-gpla-navy/55 text-sm">{meta}</p>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 md:gap-4">
        <a
          href={href}
          download
          class:list={[ctaBase, 'bg-gpla-green text-white hover:shadow-xl hover:-translate-y-0.5']}
        >
          ↓ Download Report
        </a>
        <a
          href={href}
          target="_blank"
          class:list={[
            ctaBase,
            'border-2 border-gpla-navy text-gpla-navy hover:bg-gpla-navy hover:text-white',
          ]}
        >
          ↗ Open in New Tab
        </a>
      </div>
    </div>
  </div>
</section>
