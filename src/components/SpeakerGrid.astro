---
export interface Speaker {
  name: string;
  title: string;
  subtitle: string;
}

interface Props {
  speakers: Speaker[];
  heading?: string;
  /** Extra classes for the section wrapper. */
  class?: string;
}

const { speakers, heading = 'KEY SPEAKERS', class: className } = Astro.props;
---

<section class:list={['px-4 md:px-12 py-12 md:py-24 bg-gpla-navy', className]}>
  <div class="max-w-6xl mx-auto">
    <h2 class="font-display text-white text-[28px] md:text-[48px] mb-8 md:mb-12">{heading}</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8">
      {speakers.map((speaker) => (
        <div class="text-center">
          <div class="w-20 md:w-36 h-20 md:h-36 rounded-full bg-gradient-to-br from-gpla-gold to-gpla-green mx-auto mb-4"></div>
          <h4 class="font-display text-sm md:text-xl text-white">{speaker.name}</h4>
          <p class="text-gpla-gold text-xs md:text-sm">{speaker.title}</p>
          <span class="text-white/60 text-xs">{speaker.subtitle}</span>
        </div>
      ))}
    </div>
  </div>
</section>
