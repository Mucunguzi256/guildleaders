---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Empowering ethical youth leaders for democratic transformation in East Africa." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} | Guild Presidents Leadership Academy</title>
    
    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/assets/images/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#132d82" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Book+Antiqua&family=Oswald:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        /* === Brand Colors === */
        --gpla-navy: #132d82;
        --gpla-navy-dark: #0A1628;
        --gpla-green: #389a29;
        --gpla-green-bright: #4BC43A;
        --gpla-gold: #F5A623;
        --gpla-gold-bright: #FFB83D;
        --gpla-white: #F1F5F9;
        
        /* === Backgrounds === */
        --bg-base: #0A0F1E;
        --bg-section-alt: #111827;
        --bg-dark: #132d82;
        --bg-green: #389a29;
        --bg-card: rgba(255,255,255,0.04);
        --bg-card-hover: rgba(255,255,255,0.08);
        
        /* === Text === */
        --text-primary: #F1F5F9;
        --text-muted: #94A3B8;
        --text-dim: rgba(255,255,255,0.5);
        
        /* === Typography === */
        --font-display: 'Oswald', sans-serif;
        --font-body: 'Book Antiqua', 'Georgia', serif;
        
        /* === Typography Scale (BIGGER) === */
        --text-xs: 0.875rem;    /* 14px */
        --text-sm: 1rem;         /* 16px */
        --text-base: 1.125rem;   /* 18px */
        --text-lg: 1.25rem;      /* 20px */
        --text-xl: 1.5rem;       /* 24px */
        --text-2xl: 2rem;        /* 32px */
        --text-3xl: 2.5rem;      /* 40px */
        --text-4xl: 3.5rem;      /* 56px */
        --text-5xl: 4.5rem;      /* 72px */
        --text-6xl: 5.5rem;      /* 88px */
        --text-7xl: 7rem;        /* 112px */
        
        /* === Spacing === */
        --section-py: clamp(4rem, 8vw, 8rem);
        --section-px: clamp(1rem, 4vw, 3rem);
        --container-max: 80rem;
        --container-narrow: 64rem;
        
        /* === Effects === */
        --transition-smooth: cubic-bezier(0.16, 1, 0.3, 1);
        --glow-green: 0 0 30px rgba(56,154,41,0.15);
        --glow-gold: 0 0 30px rgba(245,166,35,0.15);
        --border-subtle: 1px solid rgba(255,255,255,0.06);
        --border-card: 1px solid rgba(255,255,255,0.08);
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --radius-xl: 24px;
        --radius-full: 9999px;
      }

      html { scroll-behavior: smooth; }

      body {
        background-color: var(--bg-base);
        color: var(--text-primary);
        font-family: var(--font-body);
        font-size: var(--text-base);
        line-height: 1.75;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* === Typography Utilities === */
      .font-display {
        font-family: var(--font-display);
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }
      .font-body { font-family: var(--font-body); }

      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-display);
        text-transform: uppercase;
        letter-spacing: 0.03em;
        line-height: 1.05;
        font-weight: 600;
      }

      /* === Section Container === */
      .section-container {
        max-width: var(--container-max);
        margin: 0 auto;
        padding: 0 var(--section-px);
      }
      .section-container--narrow {
        max-width: var(--container-narrow);
      }

      /* === Section Padding === */
      .section-padding {
        padding-top: var(--section-py);
        padding-bottom: var(--section-py);
      }
      .section-padding-top { padding-top: var(--section-py); }
      .section-padding-bottom { padding-bottom: var(--section-py); }

      /* === Section Heading === */
      .section-label {
        font-family: var(--font-display);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--gpla-green);
        display: block;
        margin-bottom: 0.75rem;
      }
      .section-label--gold { color: var(--gpla-gold); }
      .section-label--white { color: var(--text-primary); }

      .section-title {
        font-size: clamp(2.5rem, 5vw, 4.5rem);
        line-height: 1.05;
        letter-spacing: 0.02em;
        max-width: 900px;
      }
      .section-title--centered { margin: 0 auto; text-align: center; }

      .section-subtitle {
        font-size: var(--text-lg);
        color: var(--text-muted);
        max-width: 640px;
        line-height: 1.6;
      }

      /* === Gold Accent Line === */
      .accent-line {
        display: block;
        width: 60px;
        height: 3px;
        background: var(--gpla-gold);
        border-radius: 2px;
        margin: 1rem 0;
      }
      .accent-line--centered { margin: 1rem auto; }
      .accent-line--green { background: var(--gpla-green); }

      /* === Reveal Animation === */
      [data-animate] {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.7s var(--transition-smooth), transform 0.7s var(--transition-smooth);
      }
      [data-animate].animate-in {
        opacity: 1;
        transform: translateY(0);
      }

      /* === Text Align === */
      .text-justify { text-align: justify; }

      /* === Buttons === */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.875rem 2rem;
        border-radius: var(--radius-full);
        font-family: var(--font-display);
        font-weight: 600;
        font-size: var(--text-sm);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        transition: all 0.3s var(--transition-smooth);
        cursor: pointer;
        border: none;
        line-height: 1.2;
      }
      .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(0,0,0,0.3);
      }
      .btn-primary {
        background: var(--gpla-green);
        color: white;
      }
      .btn-primary:hover {
        background: var(--gpla-green-bright);
      }
      .btn-gold {
        background: var(--gpla-gold);
        color: var(--gpla-navy);
      }
      .btn-gold:hover {
        background: var(--gpla-gold-bright);
      }
      .btn-outline {
        background: transparent;
        border: 2px solid rgba(255,255,255,0.3);
        color: white;
      }
      .btn-outline:hover {
        background: rgba(255,255,255,0.1);
        border-color: white;
      }
      .btn-lg {
        padding: 1.125rem 2.5rem;
        font-size: var(--text-base);
      }

      /* === Cards === */
      .card {
        background: var(--bg-card);
        border: var(--border-card);
        border-radius: var(--radius-lg);
        overflow: hidden;
        transition: all 0.3s var(--transition-smooth);
      }
      .card:hover {
        background: var(--bg-card-hover);
        transform: translateY(-4px);
        box-shadow: 0 12px 40px rgba(0,0,0,0.2);
      }

      /* === Grid Background Pattern === */
      .grid-bg {
        background-image:
          linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px),
          linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px);
        background-size: 40px 40px;
      }

      /* === Section Alternating BGs === */
      .section-dark { background: var(--bg-base); }
      .section-alt { background: var(--bg-section-alt); }
      .section-navy { background: var(--gpla-navy); }
      .section-green { background: var(--gpla-green); }

      /* === Gold Number (for program numbering) === */
      .program-number {
        font-family: var(--font-display);
        font-size: var(--text-3xl);
        font-weight: 700;
        color: var(--gpla-gold);
        line-height: 1;
        min-width: 3rem;
      }

      /* === Content Typography === */
      .content-text {
        font-size: var(--text-base);
        line-height: 1.8;
        color: var(--text-primary);
      }
      .content-text--muted {
        color: var(--text-muted);
      }
      .content-text p {
        margin-bottom: 1.25rem;
      }
      .content-text a {
        color: var(--gpla-green);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .content-text a:hover {
        color: var(--gpla-green-bright);
      }

      /* === Badge/Tag === */
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.375rem 0.875rem;
        border-radius: var(--radius-full);
        font-family: var(--font-display);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .badge-gold {
        background: var(--gpla-gold);
        color: var(--gpla-navy);
      }
      .badge-green {
        background: var(--gpla-green);
        color: white;
      }
      .badge-outline {
        border: 1px solid rgba(255,255,255,0.2);
        color: var(--text-primary);
      }

      /* === Responsive === */
      @media (max-width: 768px) {
        :root {
          --section-py: clamp(3rem, 6vw, 4rem);
        }
        .section-title {
          font-size: clamp(2rem, 8vw, 2.5rem);
        }
        .btn-lg {
          padding: 0.875rem 1.75rem;
          font-size: var(--text-sm);
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
