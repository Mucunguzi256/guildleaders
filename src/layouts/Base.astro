---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Empowering ethical youth leaders for democratic transformation in East Africa." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self'; form-action https://formspree.io; frame-src 'none'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests"
    />
    <title>{title} | Guild Presidents Leadership Academy</title>
    
    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/assets/images/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#132d82" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        /* === GPLA Brand Colors — official extract === */
        --gpla-white: #ffffff;
        --gpla-green: #389a29;
        --gpla-navy: #132d82;
        --gpla-black: #000000;
        /* === Supporting web tones === */
        --gpla-gold: #F5A623;
        --gpla-ochre: #E8A33D;
        --gpla-cream: #FAF6EE;
        --gpla-teal: #1a7a7a;
        --gpla-red: #c0392b;
        --gpla-green-bright: #4BC43A;
        --gpla-gold-bright: #FFB83D;
        
        /* === Backgrounds === */
        --bg-base: #f4f7fb;
        --bg-section-alt: #f0f4ff;
        --bg-dark: #132d82;
        --bg-green: #389a29;
        --bg-card: rgba(19,45,130,0.04);
        --bg-card-hover: rgba(19,45,130,0.08);
        
        /* === Text === */
        --text-primary: #1a2744;
        --text-muted: #4b5563;
        --text-dim: rgba(19,45,130,0.5);
        
        /* === Typography === */
        --font-display: 'Sora', sans-serif;
        --font-body: 'Inter', system-ui, sans-serif;
        
        /* === Typography Scale === */
        --text-xs: 0.875rem;
        --text-sm: 1rem;
        --text-base: 1.125rem;
        --text-lg: 1.25rem;
        --text-xl: 1.5rem;
        --text-2xl: 2rem;
        --text-3xl: 2.5rem;
        --text-4xl: 3.5rem;
        --text-5xl: 4.5rem;
        --text-6xl: 5.5rem;
        --text-7xl: 7rem;
        
        /* === Spacing === */
        --section-py: clamp(4rem, 8vw, 8rem);
        --section-px: clamp(1rem, 4vw, 3rem);
        --container-max: 80rem;
        --container-narrow: 64rem;
        
        /* === Effects === */
        --transition-smooth: cubic-bezier(0.16, 1, 0.3, 1);
        --glow-green: 0 0 30px rgba(56,154,41,0.15);
        --glow-gold: 0 0 30px rgba(245,166,35,0.15);
        --border-subtle: 1px solid rgba(19,45,130,0.08);
        --border-card: 1px solid rgba(19,45,130,0.1);
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --radius-xl: 24px;
        --radius-full: 9999px;
      }

      html { scroll-behavior: smooth; }

      @keyframes body-gradient-shift {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }
      @media (prefers-reduced-motion: reduce) {
        body { animation: none; }
      }

      body {
        position: relative;
        background: linear-gradient(135deg, #f4f7fb 0%, #f0f4ff 25%, #f0fff4 50%, #fffbf0 75%, #f4f7fb 100%);
        background-size: 400% 400%;
        animation: body-gradient-shift 20s ease infinite;
        background-attachment: fixed;
        color: var(--text-primary);
        font-family: var(--font-body);
        font-size: var(--text-base);
        line-height: 1.7;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* === Typography Utilities === */
      .font-display {
        font-family: var(--font-display);
        text-transform: uppercase;
        letter-spacing: 0.02em;
      }
      .font-body { font-family: var(--font-body); }

      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-display);
        text-transform: uppercase;
        letter-spacing: 0.02em;
        line-height: 1.08;
        font-weight: 700;
      }

      /* === Section Container === */
      .section-container {
        max-width: var(--container-max);
        margin: 0 auto;
        padding: 0 var(--section-px);
      }
      .section-container--narrow {
        max-width: var(--container-narrow);
      }

      /* === Section Padding === */
      .section-padding {
        padding-top: var(--section-py);
        padding-bottom: var(--section-py);
      }
      .section-padding-top { padding-top: var(--section-py); }
      .section-padding-bottom { padding-bottom: var(--section-py); }

      /* === Section Heading === */
      .section-label {
        font-family: var(--font-display);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--gpla-green);
        display: block;
        margin-bottom: 0.75rem;
      }
      /* Gold labels: use only on navy/dark heroes; on light sections use default (green) */
      .section-label--gold { color: var(--gpla-gold); }
      .section-label--white { color: #fff; }
      .section-navy .section-label:not(.section-label--gold),
      .section-green .section-label:not(.section-label--gold) {
        color: rgba(255, 255, 255, 0.85);
      }

      .section-title {
        font-size: clamp(2.5rem, 5vw, 4.5rem);
        line-height: 1.05;
        letter-spacing: 0.02em;
        max-width: 900px;
      }
      .section-title--centered { margin: 0 auto; text-align: center; }

      .section-subtitle {
        font-size: var(--text-lg);
        color: var(--text-muted);
        max-width: 640px;
        line-height: 1.6;
      }

      /* === Gold Accent Line === */
      .accent-line {
        display: block;
        width: 60px;
        height: 3px;
        background: var(--gpla-gold);
        border-radius: 2px;
        margin: 1rem 0;
      }
      .accent-line--centered { margin: 1rem auto; }
      .accent-line--green { background: var(--gpla-green); }

      /* === Reveal Animation === */
      [data-animate] {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.7s var(--transition-smooth), transform 0.7s var(--transition-smooth);
      }
      [data-animate].animate-in {
        opacity: 1;
        transform: translateY(0);
      }

      /* --- Enhanced section reveals --- */
      [data-animate="slide-up"] {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.7s var(--transition-smooth), transform 0.7s var(--transition-smooth);
      }
      [data-animate="slide-up"].animate-in { opacity: 1; transform: translateY(0); }

      [data-animate="slide-left"] {
        opacity: 0;
        transform: translateX(-40px);
        transition: opacity 0.7s var(--transition-smooth), transform 0.7s var(--transition-smooth);
      }
      [data-animate="slide-left"].animate-in { opacity: 1; transform: translateX(0); }

      [data-animate="slide-right"] {
        opacity: 0;
        transform: translateX(40px);
        transition: opacity 0.7s var(--transition-smooth), transform 0.7s var(--transition-smooth);
      }
      [data-animate="slide-right"].animate-in { opacity: 1; transform: translateX(0); }

      [data-animate="scale"] {
        opacity: 0;
        transform: scale(0.92);
        transition: opacity 0.7s var(--transition-smooth), transform 0.7s var(--transition-smooth);
      }
      [data-animate="scale"].animate-in { opacity: 1; transform: scale(1); }

      /* --- Hero text stagger --- */
      @keyframes hero-stagger-in {
        0% { opacity: 0; transform: translateY(40px); }
        70% { opacity: 1; transform: translateY(-4px); }
        100% { opacity: 1; transform: translateY(0); }
      }
      .hero-line {
        display: block;
        opacity: 0;
        animation: hero-stagger-in 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
      }
      .hero-line:nth-child(1) { animation-delay: 0.15s; }
      .hero-line:nth-child(2) { animation-delay: 0.3s; }
      .hero-line:nth-child(3) { animation-delay: 0.45s; }

      /* --- Stats counter bounce --- */
      @keyframes counter-bounce {
        0% { transform: scale(1); }
        50% { transform: scale(1.15); }
        100% { transform: scale(1); }
      }
      .ani-counter.counter-done {
        animation: counter-bounce 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      }

      /* --- Card hover tilt --- */
      .tilt-card {
        transition: transform 0.15s ease-out, box-shadow 0.3s ease;
        transform-style: preserve-3d;
        will-change: transform;
      }

      /* --- Marquee strip --- */
      .marquee-strip {
        overflow: hidden;
        background: #f8fafb;
        border-top: 1px solid rgba(19,45,130,0.06);
        border-bottom: 1px solid rgba(19,45,130,0.06);
        padding: 1rem 0;
        white-space: nowrap;
        position: relative;
      }
      .marquee-track {
        display: inline-flex;
        animation: marquee-scroll 25s linear infinite;
      }
      .marquee-track span {
        display: inline-block;
        padding: 0 1.5rem;
        font-family: var(--font-display);
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(19,45,130,0.3);
      }
      .marquee-track .marquee-dot {
        color: var(--gpla-gold);
        padding: 0 0.5rem;
      }
      @keyframes marquee-scroll {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }

      /* --- Gallery hover zoom overlay --- */
      .gallery-item { position: relative; }
      .gallery-item .gallery-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(19,45,130,0.45);
        opacity: 0;
        transition: opacity 0.35s ease;
        pointer-events: none;
        border-radius: inherit;
      }
      .gallery-item .gallery-overlay span {
        font-family: var(--font-display);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #fff;
        padding: 0.5rem 1rem;
        border: 1.5px solid rgba(255,255,255,0.6);
        border-radius: 999px;
      }
      .gallery-item:hover .gallery-overlay { opacity: 1; }
      .gallery-item:hover img {
        transform: scale(1.08) !important;
        filter: brightness(1.05);
      }
      .gallery-item img {
        transition: transform 0.5s var(--transition-smooth), filter 0.5s ease;
      }

      /* --- Animated gradient background --- */
      @keyframes gradient-shift {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }
      .animated-gradient-bg {
        background: linear-gradient(135deg, #132d82, #389a29, #F5A623, #132d82);
        background-size: 300% 300%;
        animation: gradient-shift 8s ease infinite;
      }

      /* --- Cursor glow --- */
      .hero-cursor-glow {
        position: absolute;
        inset: 0;
        z-index: 2;
        pointer-events: none;
        overflow: hidden;
      }
      .hero-cursor-glow__dot {
        position: absolute;
        width: 600px;
        height: 600px;
        border-radius: 50%;
        background: radial-gradient(circle 300px, rgba(56,154,41,0.08), transparent);
        transform: translate(-50%, -50%);
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s ease;
      }
      .hero-home:hover .hero-cursor-glow__dot { opacity: 1; }

      /* --- Reduced motion --- */
      @media (prefers-reduced-motion: reduce) {
        .hero-line { animation: none !important; opacity: 1 !important; }
        .ani-counter.counter-done { animation: none !important; }
        .tilt-card { transition: none !important; }
        .marquee-track { animation: none !important; }
        .gallery-item img { transition: none !important; }
        .animated-gradient-bg { animation: none !important; }
        .stats-strip { animation: none !important; }
        .hero-cursor-glow { display: none !important; }
        [data-animate="slide-up"],
        [data-animate="slide-left"],
        [data-animate="slide-right"],
        [data-animate="scale"] {
          opacity: 1 !important;
          transform: none !important;
          transition: none !important;
        }
      }

      /* === Text Align === */
      .text-justify { text-align: justify; }

      /* === Buttons === */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.875rem 2rem;
        border-radius: var(--radius-full);
        font-family: var(--font-display);
        font-weight: 600;
        font-size: var(--text-sm);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        transition: all 0.3s var(--transition-smooth);
        cursor: pointer;
        border: none;
        line-height: 1.2;
      }
      .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(0,0,0,0.3);
      }
      .btn-primary {
        background: var(--gpla-green);
        color: white;
      }
      .btn-primary:hover {
        background: var(--gpla-green-bright);
      }
      .btn-gold {
        background: var(--gpla-gold);
        color: var(--gpla-navy);
      }
      .btn-gold:hover {
        background: var(--gpla-gold-bright);
      }
      .btn-outline {
        background: transparent;
        border: 2px solid rgba(255,255,255,0.3);
        color: white;
      }
      .btn-outline:hover {
        background: rgba(255,255,255,0.1);
        border-color: white;
      }
      .btn-lg {
        padding: 1.125rem 2.5rem;
        font-size: var(--text-base);
      }

      /* === Cards === */
      .card {
        background: var(--bg-card);
        border: var(--border-card);
        border-radius: var(--radius-lg);
        overflow: hidden;
        transition: all 0.3s var(--transition-smooth);
      }
      .card:hover {
        background: var(--bg-card-hover);
        transform: translateY(-4px);
        box-shadow: 0 12px 40px rgba(0,0,0,0.2);
      }

      /* === Grid Background Pattern === */
      .grid-bg {
        background-image:
          linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px),
          linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px);
        background-size: 40px 40px;
      }

      /* === Section Alternating BGs (frosted — body kente visible) === */
      .section-dark {
        background: rgba(244, 247, 251, 0.88);
      }
      .section-alt {
        background: rgba(240, 244, 255, 0.88);
      }
      .section-light {
        background: rgba(255, 255, 255, 0.92);
      }
      .section-navy { background: var(--gpla-navy); }
      .section-green { background: var(--gpla-green); }

      /* === Gold Number (for program numbering) === */
      .program-number {
        font-family: var(--font-display);
        font-size: var(--text-3xl);
        font-weight: 700;
        color: var(--gpla-navy);
        line-height: 1;
        min-width: 3rem;
      }

      /* === Content Typography === */
      .content-text {
        font-size: var(--text-base);
        line-height: 1.8;
        color: var(--text-primary);
      }
      .content-text--muted {
        color: var(--text-muted);
      }
      .content-text p {
        margin-bottom: 1.25rem;
      }
      .content-text a {
        color: var(--gpla-green);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .content-text a:hover {
        color: var(--gpla-green-bright);
      }

      /* === Badge/Tag === */
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.375rem 0.875rem;
        border-radius: var(--radius-full);
        font-family: var(--font-display);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .badge-gold {
        background: var(--gpla-gold);
        color: var(--gpla-navy);
      }
      .badge-green {
        background: var(--gpla-green);
        color: white;
      }
      .badge-outline {
        border: 1px solid rgba(19,45,130,0.2);
        color: var(--text-primary);
        background: rgba(19,45,130,0.04);
      }

      /* === Responsive === */
      @media (max-width: 768px) {
        :root {
          --section-py: clamp(3rem, 6vw, 4rem);
        }
        .section-title {
          font-size: clamp(2rem, 8vw, 2.5rem);
        }
        .btn-lg {
          padding: 0.875rem 1.75rem;
          font-size: var(--text-sm);
        }
      }
    </style>

    <!-- Content stays hidden until JS reveals it, so restore it when JS is off -->
    <noscript>
      <style>
        [data-animate], .ani-fade-up {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    <!-- Global scroll-trigger animations -->
    <script>
      import { installGlobalErrorLogging, onReady, safeInit } from '../scripts/errors';
      import { observeReveal, revealAll } from '../scripts/reveal';

      installGlobalErrorLogging();

      onReady(
        'global reveal animations',
        () => {
          const revealOptions = { threshold: 0.15, rootMargin: '0px 0px -40px 0px' };
          observeReveal('[data-animate]', 'animate-in', revealOptions);
          observeReveal('.ani-fade-up', 'ani-visible', revealOptions);

          observeReveal('.ani-counter', 'ani-counted', { threshold: 0.5 }, (el) => {
            const target = Number.parseInt(el.getAttribute('data-target') ?? '', 10) || 0;
            const duration = Number.parseInt(el.getAttribute('data-duration') ?? '', 10) || 1500;
            const start = Number.parseInt(el.getAttribute('data-start') ?? '', 10) || 0;
            const suffix = el.getAttribute('data-suffix') || '';
            const prefix = el.getAttribute('data-prefix') || '';
            let current = start;
            const step = Math.max(1, Math.floor((target - start) / (duration / 16)));
            const update = () => {
              current += step;
              if (current >= target) {
                el.textContent = prefix + target + suffix;
                return;
              }
              el.textContent = prefix + current + suffix;
              requestAnimationFrame(() => safeInit('counter tick', update));
            };
            update();
          });
        },
        () => {
          revealAll('[data-animate]', 'animate-in');
          revealAll('.ani-fade-up', 'ani-visible');
        },
      );
    </script>
  </head>
  <body class="site-body-kente">
    <slot />
  </body>
</html>